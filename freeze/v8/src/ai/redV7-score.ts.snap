import type { Board } from "../core/board.js";
import { COLS } from "../core/board.js";
import type { PieceKind } from "../core/pieces.js";

export function redV7Heights(after: Board): number[] {
  const h: number[] = new Array<number>(COLS).fill(0);
  for (let x = 0; x < COLS; x += 1) {
    for (let y = after.length - 1; y >= 0; y -= 1) {
      if (((after[y] ?? 0) & (1 << x)) !== 0) { h[x] = y + 1; break; }
    }
  }
  return h;
}

export function redV7WellCol(h: readonly number[]): number {
  let well = 0;
  let best = h[0] ?? 0;
  for (let x = 1; x < COLS; x += 1) {
    const v = h[x] ?? 0;
    if (v < best || (v === best && (x === 0 || x === COLS - 1))) { best = v; well = x; }
  }
  return well;
}

export function redV7WellDepth(after: Board, well: number, cap: number): number {
  let depth = 0;
  for (let y = 0; y < after.length && depth < cap; y += 1) {
    if (((after[y] ?? 0) & (1 << well)) !== 0) break;
    let filled = true;
    for (let x = 0; x < COLS; x += 1) {
      if (x === well) continue;
      if (((after[y] ?? 0) & (1 << x)) === 0) { filled = false; break; }
    }
    if (!filled) break;
    depth += 1;
  }
  return Math.min(depth, cap);
}

export function redV7MaxExWell(h: readonly number[], well: number): number {
  let m = 0;
  for (let x = 0; x < COLS; x += 1) {
    if (x === well) continue;
    const v = h[x] ?? 0;
    if (v > m) m = v;
  }
  return m;
}

export function redV7BumpExWell(h: readonly number[], well: number): number {
  let bump = 0;
  let prev = -1;
  for (let x = 0; x < COLS; x += 1) {
    if (x === well) continue;
    const v = h[x] ?? 0;
    if (prev >= 0) bump += Math.abs(v - prev);
    prev = v;
  }
  return bump;
}

export function redV7CountTslots(after: Board, cap: number): number {
  let n = 0;
  const top = Math.min(after.length - 1, 14);
  for (let y = 1; y <= top; y += 1) {
    for (let x = 0; x < COLS; x += 1) {
      if (((after[y] ?? 0) & (1 << x)) !== 0) continue;
      if (((after[y - 1] ?? 0) & (1 << x)) === 0) continue;
      const l = x === 0 || ((after[y] ?? 0) & (1 << (x - 1))) !== 0;
      const r = x === COLS - 1 || ((after[y] ?? 0) & (1 << (x + 1))) !== 0;
      const u = y + 1 >= after.length || ((after[y + 1] ?? 0) & (1 << x)) !== 0;
      if ((l ? 1 : 0) + (r ? 1 : 0) + (u ? 1 : 0) >= 2) {
        n += 1;
        if (n >= cap) return n;
      }
    }
  }
  return n;
}

export function redV7CountHoles(after: Board, h: readonly number[]): number {
  let n = 0;
  for (let x = 0; x < COLS; x += 1) {
    const top = h[x] ?? 0;
    for (let y = 0; y < top; y += 1) if (((after[y] ?? 0) & (1 << x)) === 0) n += 1;
  }
  return n;
}

export function redV7MaxHeight(after: Board): number {
  for (let y = after.length - 1; y >= 0; y -= 1) {
    if ((after[y] ?? 0) !== 0) return y + 1;
  }
  return 0;
}

export function redV7Veto(after: Board, lines: number, _pending: number): boolean {
  void _pending;
  if (lines > 0) return false;
  const h = redV7Heights(after);
  const well = redV7WellCol(h);
  let global = 0;
  for (const v of h) if (v > global) global = v;
  if (global < 18) return false;
  const edge = well === 0 || well === COLS - 1;
  if (edge && redV7WellDepth(after, well, 6) >= 4 && redV7MaxExWell(h, well) <= 14) return false;
  return true;
}

export function redV7Emergency(pending: number, maxH: number): 0 | 1 | 2 {
  if (pending >= 9 || maxH >= 16) return 2;
  if (pending >= 5 || maxH >= 11) return 1;
  return 0;
}

export function redV7WastedT(piece: PieceKind | undefined, lines: number, tspin: boolean): number {
  if (piece !== "T") return 0;
  if (tspin && lines > 0) return 0;
  if (lines > 0) return -150;
  return -20;
}

export function redV7WastedI(piece: PieceKind | undefined, lines: number, emerg: 0 | 1 | 2): number {
  if (piece !== "I") return 0;
  if (emerg === 2) return 0;
  if (lines === 4) return 0;
  if (lines > 0) return -100;
  return -20;
}

export function redV7HeightPressure(maxH: number): number {
  if (maxH >= 16) return (maxH - 15) * 500;
  if (maxH >= 11) return (maxH - 10) * 150;
  return 0;
}

export function redV7Capped(after: Board, h: readonly number[]): number {
  let n = 0;
  for (let x = 0; x < COLS; x += 1) {
    const top = h[x] ?? 0;
    for (let y = 1; y < top && y < after.length - 1; y += 1) {
      if (((after[y] ?? 0) & (1 << x)) !== 0) continue;
      if (((after[y + 1] ?? 0) & (1 << x)) !== 0 && ((after[y - 1] ?? 0) & (1 << x)) !== 0) n += 1;
    }
  }
  return n;
}

export function redV7High(after: Board): number {
  let n = 0;
  for (let y = 14; y < after.length; y += 1) {
    let r = after[y] ?? 0;
    while (r !== 0) { n += r & 1; r >>>= 1; }
  }
  return n;
}
