        int next_hold = bitfieldExtract(int(m12), 8, 8);
        uint used_hold = (m12 >> 16) & 0xFFu;
        int sDepth = int((m12 >> 24) & 0xFFu);

        uint m13 = state.u[pbase + 13u];
        int sChain = int(m13 & 0xFFu);
        int sCombo = int((m13 >> 8) & 0xFFu) - 1;
        int sPending = int((m13 >> 16) & 0xFFu);
        int sTslot = int((m13 >> 24) & 0xFFu);

        float sReward = uintBitsToFloat(state.u[pbase + 14u]);
        uint rt_lift = state.u[pbase + 10u];
        int rt = int(rt_lift & 0xFFFFu);
        int pLift = int(rt_lift >> 16);

        uint64_t col[10];
        for (int x = 0; x < 10; x++) col[x] = uint64_t(state.u[pbase + uint(x)]);

