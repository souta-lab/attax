    // Parallel 3-chunk prefix sum over sNChild[0..ni-1] into pool[0..ni] (zero serial loop!)
    uint c0 = (lane < ni) ? state.u[REPSGEN + 256u + lane] : 0u;
    uint p0 = wg64ExclusiveAdd(c0);
    uint tot0 = wg64Add(c0);
    pool[lane] = p0;
    uint c1 = (lane + 64u < ni) ? state.u[REPSGEN + 256u + lane + 64u] : 0u;
    uint p1 = wg64ExclusiveAdd(c1);
    uint tot1 = wg64Add(c1);
