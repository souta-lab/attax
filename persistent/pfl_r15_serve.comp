        int lines = pop64(full);
        uint64_t flb = uint64_t(state.u[pbase + 11u]);
        int gc = (full != 0ul) ? pop64(flb & full) : 0;

        if (full != 0ul) {
            // Subtract cleared lines' row_transitions (= 2 per full line, wait: rt_of(0x3FF) == 0!)
            // Wait: a full row has bits = 0x3FF, so w = (0x3FF << 1) | 1 | 2048 = 0xFFF, w ^ (w>>1) & 2047 == 0!
            // That's why full lines have rt_of(0x3FF) == 0 and deleting them does NOT change rt!
            for (int x = 0; x < 10; x++) {
                uint64_t m = col[x];
                uint64_t f = full;
                int j = 0;
                while (f != 0ul) {
                    int k = lsb64(f);
                    m = delete_level(m, uint(k - j));
                    j += 1;
                    f &= f - 1ul;
                }
                col[x] = m;
            }
            uint64_t m = flb;
            uint64_t f = full;
            int j = 0;
            while (f != 0ul) {
                int k = lsb64(f);
                m = delete_level(m, uint(k - j));
                j += 1;
                f &= f - 1ul;
            }
            flb = m;
        }

        bool pc_ = lines > 0 && col[0] == 0ul && col[1] == 0ul && col[2] == 0ul && col[3] == 0ul && col[4] == 0ul
            && col[5] == 0ul && col[6] == 0ul && col[7] == 0ul && col[8] == 0ul && col[9] == 0ul;

        int spin = 0;
        if (srs != 0 && (ply == 0u || lines > 0 || (kind_b == 2 && sTslot > 0))) {
            spin = classify_spin_c(pbase, len, kind_b, rot, px, py, srs, isGL);
        }

        bool difficult = lines > 0 && (lines == 4 || spin != 0 || (!isGL && pc_));
        int combo = lines > 0 ? sCombo + 1 : -1;
        int attack = 0;
        int dchain = sChain;
        float sMult = tabf(97 + sDepth);
        float sScale = tabf(65 + sDepth);

        if (isGL) {
            if (lines > 0) {
                int base = 0;
                if (spin == 1) base = (lines == 2) ? 1 : 0;
                else if (spin == 2) base = (lines == 1) ? 2 : ((lines == 2) ? 4 : ((lines == 3) ? 6 : 0));
                else base = (lines == 2) ? 1 : ((lines == 3) ? 2 : ((lines == 4) ? 4 : 0));
                int b2b_bonus = (sChain != 0 && difficult) ? 1 : 0;
                attack = base + b2b_bonus + gline_combo_bonus(combo) + (pc_ ? 10 : 0);
                dchain = pc_ ? ((lines >= 4) ? 1 : 0) : (difficult ? 1 : 0);
            }
        } else {
            if (lines > 0) {
                int base;
                int li5 = min(lines, 5);
                if (spin == 2) base = int[6](0, 2, 4, 6, 10, 12)[li5];
                else if (spin == 1) base = int[6](0, 0, 1, 2, 10, 12)[li5];
                else base = int[6](0, 0, 1, 2, 4, 5)[li5];
                if (lines > 5) base += lines - 5;
                int surge = difficult ? 0 : s2surge(sChain);
                float raw = combo_raw(float(base) + (difficult && sChain > 0 ? 1.0 : 0.0), combo);
                int sb = (gc > 0 && (spin != 0 || lines >= 4)) ? 1 : 0;
                attack = int(floor(raw * sMult + float(sb)))
                    + (pc_ ? int(floor(5.0 * sMult)) : 0)
                    + int(floor(float(surge) * sMult));
                dchain = difficult ? sChain + 1 : 0;
            }
        }

        int pending = 0, landed = 0, childLift = pLift;
        if (isGL) {
            int rootPending = (sDepth == 0) ? sPending : 0;
            childLift = pLift + max(rootPending - attack, 0);
            pending = 0;
        } else {
            if (lines > 0) {
                pending = max(sPending - attack, 0);
                landed = 0;
            } else {
                int due = (sDepth == 0) ? int(uni.u[104]) : sPending;
                landed = min(due, sPending);
                pending = sPending - landed;
            }
            if (landed > 0) {
                int l = landed;
                int lmin = min(l, len);
                for (int level = len - lmin; level < len; level++) {
                    rt -= rt_of(row_mask10(col[0], col[1], col[2], col[3], col[4], col[5], col[6], col[7], col[8], col[9], uint(level)));
                }
                int well = 0, wellH0 = height_of(col[0]);
                for (int x = 1; x < 10; x++) { int hx = height_of(col[x]); if (hx < wellH0) { well = x; wellH0 = hx; } }
                uint64_t lm2 = below64(uint(len));
                uint64_t gb = l >= len ? lm2 : below64(uint(l));
                for (int x = 0; x < 10; x++) {
                    uint64_t shifted = l >= 64 ? 0ul : ((col[x] << uint(l)) & lm2);
                    col[x] = shifted | (x != well ? gb : 0ul);
                }
                flb = (l >= 64 ? 0ul : ((flb << uint(l)) & lm2)) | gb;
                rt += lmin * rt_of(0x3FFu ^ (1u << uint(well)));
            }
        }

        int raw_maxh = height_of(col[0] | col[1] | col[2] | col[3] | col[4] | col[5] | col[6] | col[7] | col[8] | col[9]);
        int eff_maxh = isGL ? (raw_maxh + childLift) : raw_maxh;
        bool dead = isGL ? (locks_out_c(len, kind_b, rot, py) || eff_maxh >= len) : (raw_maxh >= min(len, 21));

        uint root_id = (ply == 0u) ? coff : state.u[REPSGEN + instLocal];
        if (ply == 0u && coff < 256u) {
            // Save root candidate metadata for host output
            uint rb = ROOT_INFO + coff * 4u;
            state.u[rb + 0u] = uint(kind_b) | (uint(rot & 3) << 8) | (uint(srs & 7) << 16) | (uint(spin & 3) << 24);
            state.u[rb + 1u] = (uint(px) & 0xFFFFu) | ((uint(py) & 0xFFFFu) << 16);
            state.u[rb + 2u] = used_hold | (dead ? 2u : 0u);
            state.u[rb + 3u] = 0u;
        }

        if (isGL && dead) {
            // In Guideline mode, dead children vanish (dead_code == 2)
            continue;
        }

        uint c32[10];
        for (int x = 0; x < 10; x++) c32[x] = uint(col[x]);
        int tslot = best_tslot32(c32, len);

        int maxh = 0, well = 0, wellH = 0, holes = 0, holeCover = 0;
        uint holeOr = 0u, hp0 = 0u, hp1 = 0u;
        for (int x = 0; x < 10; x++) {
            int hx = height_of32(c32[x]);
            if (x < 5) hp0 |= uint(hx) << uint(x * 6);
            else hp1 |= uint(hx) << uint((x - 5) * 6);
            if (hx > maxh) maxh = hx;
            if (x == 0 || hx < wellH) { well = x; wellH = hx; }
            int mx_c = bitCount(c32[x]);
            int hdiff = hx - mx_c;
            if (hdiff > 0) {
                holes += hdiff;
                holeOr |= ~c32[x] & ((1u << uint(hx - 1)) - 1u);
                holeCover += hole_cover_col_m32(c32[x], mx_c);
            }
        }
        int holeRows = bitCount(holeOr);
        int bump = 0, bumpSq = 0;
        for (int x = 0; x < 9; x++) {
            if (x == well || x + 1 == well) continue;
            int hx0 = int(((x < 5 ? hp0 : hp1) >> uint((x < 5 ? x : x - 5) * 6)) & 63u);
            int hx1 = int(((x + 1 < 5 ? hp0 : hp1) >> uint((x + 1 < 5 ? x + 1 : x - 4) * 6)) & 63u);
            int d = abs(hx0 - hx1);
            bump += d;
            bumpSq += d * d;
        }
        int leftN = well > 0 ? int(((well - 1 < 5 ? hp0 : hp1) >> uint((well - 1 < 5 ? well - 1 : well - 6) * 6)) & 63u) : len;
        int rightN = well < 9 ? int(((well + 1 < 5 ? hp0 : hp1) >> uint((well + 1 < 5 ? well + 1 : well - 4) * 6)) & 63u) : len;
        int wellDepth = min(4, min(leftN, rightN) - wellH);
        int extraWells = 0;
        for (int x = 0; x < 10; x++) {
            if (x == well) continue;
            int hx = int(((x < 5 ? hp0 : hp1) >> uint((x < 5 ? x : x - 5) * 6)) & 63u);
            int l2 = x > 0 ? int(((x - 1 < 5 ? hp0 : hp1) >> uint((x - 1 < 5 ? x - 1 : x - 6) * 6)) & 63u) : len;
            int r2 = x < 9 ? int(((x + 1 < 5 ? hp0 : hp1) >> uint((x + 1 < 5 ? x + 1 : x - 4) * 6)) & 63u) : len;
            if (min(l2, r2) - hx >= 3) extraWells += 1;
        }
        int feat_maxh = isGL ? (maxh + childLift) : maxh;
        int over = max(feat_maxh - 10, 0);
        int danger = over * over;

        float rw = float(attack) * tabf(165);
        if (!isGL && sDepth == 0) {
            rw += tabf(169) * float(max(attack - sPending, 0));
        }
        int ck = -1;
        if (lines > 0) {
            if (pc_) ck = 8;
            else if (spin == 1) ck = 4;
            else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
            else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
        }
        if (ck >= 0) rw += tabf(156 + ck);
        if (!isGL && ck == 4) {
            float delta = lines == 1 ? tabf(174) : (lines == 2 ? tabf(175) : (lines == 3 ? tabf(176) : 0.0));
            rw += delta;
        }
        if (sChain != 0 && lines > 0 && !difficult && !pc_) rw += tabf(166);
        if (kind_b == 2 && spin == 0 && sTslot > 0) rw += tabf(167);
        float acc = sReward + sScale * (rw - tabf(170) * float(danger));

        float phiEx = (!isGL && tabf(177) != 0.0) ? stock_phi(dchain, combo, pending, feat_maxh, tslot, wellDepth, sMult) : 0.0;
        float b2bState = (!isGL && tabf(171) != 0.0 && dchain >= 1) ? tabf(171) : 0.0;
        float setupNear = (tabf(172) != 0.0 && tslot == 0) ? float(near_tslot32(c32, len)) * tabf(172) : 0.0;
        float dot = float(feat_maxh) * tabf(145) + float(danger) * tabf(146)
            + float(holes) * tabf(147) + float(holeCover) * tabf(148)
            + float(holeRows) * tabf(149) + float(bump) * tabf(150)
            + float(bumpSq) * tabf(151) + float(rt) * tabf(152)
            + float(wellDepth) * tabf(153) + float(extraWells) * tabf(154)
            + float(tslot) * tabf(155);
        float value = acc + (sScale * tabf(168)) * (dot + b2bState + phiEx + setupNear);
        uint vbits = (value == 0.0) ? 0u : floatBitsToUint(value);
        uint vord32 = (vbits >> 31) != 0u ? ~vbits : (vbits | 0x80000000u);
        uint childDepth = uint(sDepth + 1);

        if (ply == 0u && coff < 256u) {
            state.u[ROOT_INFO + coff * 4u + 3u] = vbits;
        }

        // In S2 mode, a dead child (maxh >= 21) is a terminal leaf: record its value and do NOT expand further
        if (dead) {
            recordLeafBest(root_id, vord32, childDepth);
            continue;
        }

        // Store child's 16-word state in rec.q[coff * 4 + 0..3] (= CHILD_ST) via 4 coalesced uvec4 stores!
        uint qb = coff * 4u;
        uint w12 = (next_nxt & 0xFFu)
                 | ((uint(next_hold) & 0xFFu) << 8)
                 | (1u << 16)
                 | ((childDepth & 0xFFu) << 24);
        uint w13 = (uint(dchain) & 0xFFu)
                 | ((uint(combo + 1) & 0xFFu) << 8)
                 | ((uint(pending) & 0xFFu) << 16)
                 | ((uint(tslot) & 0xFFu) << 24);
        if (int(next_nxt) < seq_len && (ply + 1u < nPlies)) {
            rec.q[qb + 0u] = uvec4(c32[0], c32[1], c32[2], c32[3]);
            rec.q[qb + 1u] = uvec4(c32[4], c32[5], c32[6], c32[7]);
            rec.q[qb + 2u] = uvec4(c32[8], c32[9], (uint(rt) & 0xFFFFu) | (uint(childLift) << 16), uint(flb));
        }
        rec.q[qb + 3u] = uvec4(w12, w13, floatBitsToUint(acc), root_id);
        // Also stash vbits in CHILD_VBITS[coff] so S4 can read child's vbits without recomputing
        state.u[CHILD_VBITS + coff] = vbits;

        // Dedupe hash (64-bit FNV-1a)
        uint64_t hh = (uint64_t(0x14650FB0u) << 32) | uint64_t(0x739D0383u);
        uint64_t prime = (uint64_t(0x100u) << 32) | uint64_t(0x000001B3u);
        uint hk32 = next_hold < 0 ? 0xFFFFFFFFu : uint(next_hold);
        hh = (hh ^ (uint64_t(next_nxt) | (uint64_t(hk32) << 32))) * prime;
        if (isGL) {
            hh = (hh ^ uint64_t(uint(dchain != 0 ? 1 : 0))) * prime;
        } else {
            hh = (hh ^ (uint64_t(uint(dchain)) | (uint64_t(uint(combo)) << 32))) * prime;
            hh = (hh ^ (uint64_t(uint(pending)) | (uint64_t(uint(len)) << 32))) * prime;
            hh = (hh ^ flb) * prime;
        }
        hh = (hh ^ packUint2x32(uvec2(c32[0], c32[1]))) * prime;
        hh = (hh ^ packUint2x32(uvec2(c32[2], c32[3]))) * prime;
        hh = (hh ^ packUint2x32(uvec2(c32[4], c32[5]))) * prime;
        hh = (hh ^ packUint2x32(uvec2(c32[6], c32[7]))) * prime;
        hh = (hh ^ packUint2x32(uvec2(c32[8], c32[9]))) * prime;

        uint64_t packed = (uint64_t(vord32) << 32) | uint64_t(0xFFFFFFFFu - coff);
        uint64_t fp = hh;
        uint slot = uint(sm64(fp)) & 16383u;
        for (uint it = 0u; it <= 16383u; it++) {
            uint64_t cur = atomicCompSwap(tabfp.v[slot], EMPTY64, fp);
            if (cur == EMPTY64) {
                uint ts = atomicAdd(state.u[STATS + ST_NTOUCH], 1u);
                state.u[TABMETA + ts] = slot;
                atomicMax(tabord.v[slot], packed);
                break;
            }
            if (cur == fp) {
                if (packed > tabord.v[slot]) atomicMax(tabord.v[slot], packed);
                break;
            }
            slot = (slot + 1u) & 16383u;
        }
    }
}
// ================= selection stage bodies =================
// Ports of the stage-3 final forms (3B v5 + 3C integrated dedupe)
// into the resident kernel. Differences from the basic forms are
// structural only: child-direct iteration (list positions replaced
// by ply-local child offsets — order-isomorphic, so every tie-break
// resolves identically), 64-lane workgroup-0 scans instead of
// 1024/256-lane ones, and LDS key staging dropped (keys read from
// the global ord caches; the kept arrays alias BPX's shared, which
// is dead by S3). Semantics follow the originals line for line.
#define PFXIDX 188800u
shared uint h_nAlive, h_nReps, h_nSel, h_nEval, h_rounds, h_nSurv;


// Monotonic 12-bit float bucket (3907 bins in 0..4095):
// 6-bit mantissa precision (64 bins/exponent) across [-2^23, -2^-8] and [+2^-8, +2^23].
// Strictly monotonic with 64-bit ordOfBits(double) for ALL uint64_t values!
uint floatBucket12_f32(uint vord32) {
  uint v = vord32 >> 17;
  if (v < 6784u) return 0u;
  if (v < 8768u) return 1u + (v - 6784u);
  if (v < 24000u) return 1985u;
  if (v < 25984u) return 1986u + (v - 24000u);
  return 3970u;
}

bool btPrecedes2(uint ak, uint ao, uint bk, uint bo) {
  return (ak != bk) ? (ak > bk) : (ao < bo);
}
#define BT2_STEP(K, J) do { \
  { uint pk = subgroupShuffleXor(kA, (J)); uint po = subgroupShuffleXor(oA, (J)); \
    bool wantHi = ((lane & (J)) != 0u) != ((lane & (K)) != 0u); \
    if (wantHi ? btPrecedes2(kA, oA, pk, po) : btPrecedes2(pk, po, kA, oA)) { kA = pk; oA = po; } } \
  { uint pk = subgroupShuffleXor(kB, (J)); uint po = subgroupShuffleXor(oB, (J)); \
    bool wantHi = ((lane & (J)) != 0u) != (((lane + 64u) & (K)) != 0u); \
    if (wantHi ? btPrecedes2(kB, oB, pk, po) : btPrecedes2(pk, po, kB, oB)) { kB = pk; oB = po; } } \
} while (false)

#define BT2_STEP32(K) do { \
  pool[lane] = kA; pool[64u + lane] = oA; \
  pool[128u + lane] = kB; pool[192u + lane] = oB; \
  barrier(); \
  uint pl = lane ^ 32u; \
  { uint pk = pool[pl]; uint po = pool[64u + pl]; \
    bool wantHi = ((lane & 32u) != 0u) != ((lane & (K)) != 0u); \
    if (wantHi ? btPrecedes2(kA, oA, pk, po) : btPrecedes2(pk, po, kA, oA)) { kA = pk; oA = po; } } \
  { uint pk = pool[128u + pl]; uint po = pool[192u + pl]; \
    bool wantHi = ((lane & 32u) != 0u) != (((lane + 64u) & (K)) != 0u); \
    if (wantHi ? btPrecedes2(kB, oB, pk, po) : btPrecedes2(pk, po, kB, oB)) { kB = pk; oB = po; } } \
  barrier(); \
} while (false)

#define BT2_STEP64() do { \
  if (btPrecedes2(kB, oB, kA, oA)) { uint t = kA; kA = kB; kB = t; t = oA; oA = oB; oB = t; } \
} while (false)

void bitonic128_2w(inout uint kA, inout uint oA, inout uint kB, inout uint oB) {
  uint lane = gl_LocalInvocationIndex;
  BT2_STEP(2u, 1u);
  BT2_STEP(4u, 2u); BT2_STEP(4u, 1u);
  BT2_STEP(8u, 4u); BT2_STEP(8u, 2u); BT2_STEP(8u, 1u);
  BT2_STEP(16u, 8u); BT2_STEP(16u, 4u); BT2_STEP(16u, 2u); BT2_STEP(16u, 1u);
  BT2_STEP(32u, 16u); BT2_STEP(32u, 8u); BT2_STEP(32u, 4u); BT2_STEP(32u, 2u); BT2_STEP(32u, 1u);
  BT2_STEP32(64u); BT2_STEP(64u, 16u); BT2_STEP(64u, 8u); BT2_STEP(64u, 4u); BT2_STEP(64u, 2u); BT2_STEP(64u, 1u);
  BT2_STEP64();
  BT2_STEP32(128u); BT2_STEP(128u, 16u); BT2_STEP(128u, 8u);
  BT2_STEP(128u, 4u);  BT2_STEP(128u, 2u);  BT2_STEP(128u, 1u);
}

// ---- S3: 1-shot FP32 TOUCHED-slot Top-96 (NO prodDedupeB, 1 fewer gbar/ply!) ----
bool prodSelectTop96(uint ply, inout uint bk) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint tid = wg * 64u + lane;
  uint tt = g_nwg * 64u;
  uint childBase = 0u;
  uint nReps = state.u[STATS + ST_NTOUCH];

  if (nReps == 0u) {
    if (wg == 0u && lane == 0u) {
      state.u[STATS + ST_NSEL] = 0u;
      h_nAlive = 0u; h_nReps = 0u; h_nSel = 0u; h_nEval = 0u; h_rounds = 0u;
    }
    return false;
  }

  if (nReps <= 96u) {
    if (wg == 0u) {
      uint kA = 0u, oA = 0xFFFFFFFFu, kB = 0u, oB = 0xFFFFFFFFu;
      if (lane < nReps) {
        uint slot = state.u[TABMETA + lane];
        uint64_t pk = tabord.v[slot];
        kA = uint(pk >> 32); oA = 0xFFFFFFFFu - uint(pk);
      }
      if (lane < 32u && (lane + 64u) < nReps) {
        uint slot = state.u[TABMETA + lane + 64u];
        uint64_t pk = tabord.v[slot];
        kB = uint(pk >> 32); oB = 0xFFFFFFFFu - uint(pk);
      }
      bitonic128_2w(kA, oA, kB, oB);
      if (lane < nReps) state.u[SELB + lane] = childBase + oA;
      if (lane < 32u && (lane + 64u) < nReps) state.u[SELB + lane + 64u] = childBase + oB;
      if (lane == 0u) {
        state.u[STATS + ST_NSEL] = nReps;
        h_nAlive = 0u; h_nReps = nReps; h_nSel = nReps; h_nEval = nReps; h_rounds = 1u;
      }
    }
    return false;
  }

  uint myMaxBin = 0u;
  for (uint i = tid; i < nReps; i += tt) {
    uint slot = state.u[TABMETA + i];
    uint vord32 = uint(tabord.v[slot] >> 32);
    uint bin = floatBucket12_f32(vord32);
    atomicAdd(state.u[PB_HIST + bin], 1u);
    myMaxBin = max(myMaxBin, bin);
  }
  uint sgMax = subgroupMax(myMaxBin);
  if (gl_SubgroupInvocationID == 0u && sgMax > 0u) atomicMax(state.u[STATS + ST_PB_PREVBIN], sgMax);
  if (gbar(bk++)) return true;

  int startBlk = int(state.u[STATS + ST_PB_PREVBIN] >> 6);
  uint acc = 0u;
  for (int blk = startBlk; blk >= 0; blk -= 2) {
    uint h0 = state.u[PB_HIST + uint(blk) * 64u + lane];
    uint h1 = (blk > 0) ? state.u[PB_HIST + uint(blk - 1) * 64u + lane] : 0u;
    uint bsum0 = wg64Add(h0);
    if (acc + bsum0 >= 96u) {
      uint incl = wg64InclusiveAdd(h0);
      uint greater = acc + (bsum0 - incl);
      if (greater < 96u && 96u <= greater + h0) wg_tmp[2] = uint(blk) * 64u + lane;
      break;
    }
    acc += bsum0;
    uint bsum1 = wg64Add(h1);
    if (acc + bsum1 >= 96u) {
      uint incl = wg64InclusiveAdd(h1);
      uint greater = acc + (bsum1 - incl);
      if (greater < 96u && 96u <= greater + h1) wg_tmp[2] = uint(blk - 1) * 64u + lane;
      break;
    }
    acc += bsum1;
  }
  barrier();
  uint tbin = wg_tmp[2];

  for (uint i = tid; i < nReps; i += tt) {
    uint slot = state.u[TABMETA + i];
    uint64_t pk = tabord.v[slot];
    uint vord32 = uint(pk >> 32);
    uint bin = floatBucket12_f32(vord32);
    if (bin > tbin) {
      uint cs = atomicAdd(state.u[STATS + ST_CAND], 1u);
      state.u[CAND_OFF + cs * 2u + 0u] = vord32;
      state.u[CAND_OFF + cs * 2u + 1u] = 0xFFFFFFFFu - uint(pk);
    } else if (bin == tbin) {
      uint cs = atomicAdd(state.u[STATS + ST_PB_NCAND], 1u);
      state.u[CHUNKB + cs * 2u + 0u] = vord32;
      state.u[CHUNKB + cs * 2u + 1u] = 0xFFFFFFFFu - uint(pk);
    }
  }
  if (gbar(bk++)) return true;

  if (wg == 0u) {
    uint nGt = state.u[STATS + ST_CAND];
    uint nEq = state.u[STATS + ST_PB_NCAND];
    uint tot0 = nGt + nEq;
    uint kA = 0u, oA = 0xFFFFFFFFu, kB = 0u, oB = 0xFFFFFFFFu;
    if (lane < nGt) {
      kA = state.u[CAND_OFF + lane * 2u]; oA = state.u[CAND_OFF + lane * 2u + 1u];
    } else if (lane < tot0) {
      uint ci = lane - nGt;
      kA = state.u[CHUNKB + ci * 2u]; oA = state.u[CHUNKB + ci * 2u + 1u];
    }
    uint idxB = lane + 64u;
    if (idxB < nGt) {
      kB = state.u[CAND_OFF + idxB * 2u]; oB = state.u[CAND_OFF + idxB * 2u + 1u];
    } else if (idxB < tot0) {
      uint ci = idxB - nGt;
      kB = state.u[CHUNKB + ci * 2u]; oB = state.u[CHUNKB + ci * 2u + 1u];
    }
    bitonic128_2w(kA, oA, kB, oB);
    for (uint base = 128u - nGt; base < nEq; base += 32u) {
      if (lane >= 32u) {
        uint ci = base + (lane - 32u);
        if (ci < nEq) { kB = state.u[CHUNKB + ci * 2u]; oB = state.u[CHUNKB + ci * 2u + 1u]; }
        else { kB = 0u; oB = 0xFFFFFFFFu; }
      }
      bitonic128_2w(kA, oA, kB, oB);
    }
    state.u[SELB + lane] = childBase + oA;
    if (lane < 32u) state.u[SELB + lane + 64u] = childBase + oB;
    if (lane == 0u) {
      state.u[STATS + ST_NSEL] = 96u;
      h_nAlive = 0u; h_nReps = nReps; h_nSel = 96u; h_nEval = nReps; h_rounds = 1u;
    }
  }
  return false;
}

// ---- S4: Fused Materialization + Next-Ply PSTATE Instance Builder (ALL 96 WGs in parallel! Zero gbar(B0a)!) ----
void matStage(uint ply, uint nPlies) {
  uint nSel = state.u[STATS + ST_NSEL];
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  int len = int(uni.u[80]);
  int seq_len = int(uni.u[81]);
  bool hasNextPly = (ply + 1u < nPlies);

  // Step 1: Every WG computes nopts[0..nSel-1] and prefix-sum first[0..nSel-1] in LDS pool[0..95]
  uint no0 = 0u, no1 = 0u;
  if (lane < nSel) {
    uint coff = state.u[SELB + lane];
    uint m12 = state.u[CHILD_ST + coff * 16u + 12u];
    int nxt = int(m12 & 0xFFu);
    int hold = bitfieldExtract(int(m12), 8, 8);
    if (hasNextPly && nxt < seq_len) {
      int cur = int(uni.u[82 + nxt]);
      no0 = 1u;
      if (hold < 0) {
        if (nxt + 1 < seq_len && int(uni.u[82 + nxt + 1]) != cur) no0 = 2u;
      } else if (hold != cur) {
        no0 = 2u;
      }
    }
    if (wg == 0u) {
      uint depth = (m12 >> 24) & 0xFFu;
      uint root_id = state.u[CHILD_ST + coff * 16u + 15u];
      uint vbits = state.u[CHILD_VBITS + coff];
      uint vord32 = (vbits >> 31) != 0u ? ~vbits : (vbits | 0x80000000u);
      if (nxt >= seq_len) recordLeafBest(root_id, vord32, depth);
      recordBeamBest(root_id, vord32, depth);
    }
  }
  uint bi1 = lane + 64u;
  if (bi1 < nSel) {
    uint coff = state.u[SELB + bi1];
    uint m12 = state.u[CHILD_ST + coff * 16u + 12u];
    int nxt = int(m12 & 0xFFu);
    int hold = bitfieldExtract(int(m12), 8, 8);
    if (hasNextPly && nxt < seq_len) {
      int cur = int(uni.u[82 + nxt]);
      no1 = 1u;
      if (hold < 0) {
        if (nxt + 1 < seq_len && int(uni.u[82 + nxt + 1]) != cur) no1 = 2u;
      } else if (hold != cur) {
        no1 = 2u;
      }
    }
    if (wg == 0u) {
      uint depth = (m12 >> 24) & 0xFFu;
      uint root_id = state.u[CHILD_ST + coff * 16u + 15u];
      uint vbits = state.u[CHILD_VBITS + coff];
      uint vord32 = (vbits >> 31) != 0u ? ~vbits : (vbits | 0x80000000u);
      if (nxt >= seq_len) recordLeafBest(root_id, vord32, depth);
      recordBeamBest(root_id, vord32, depth);
    }
  }
  uint p0 = wg64ExclusiveAdd(no0);
  uint tot0 = wg64Add(no0);
  uint p1 = wg64ExclusiveAdd(no1);
  uint tot1 = wg64Add(no1);
  uint totalInst = tot0 + tot1;
  pool[lane] = p0 | (no0 << 16);
  if (lane < 32u) pool[64u + lane] = (tot0 + p1) | (no1 << 16);
  barrier();

  if (wg == 0u && lane == 0u) {
    state.u[STATS + ST_NI] = totalInst;
    state.u[STATS + ST_NCH] = 0u;
    if (nSel > 0u) state.u[STATS + ST_MAX_DEPTH] = ply + 1u;
  }

  // Step 2: ALL WGs cooperatively build PSTATE[0..totalInst-1] directly from CHILD_ST[SELB[bi]]!
  if (hasNextPly && totalInst > 0u) {
    for (uint bi = wg; bi < nSel; bi += g_nwg) {
      uint pk = pool[bi];
      uint first = pk & 0xFFFFu;
      uint nopts = pk >> 16;
      if (nopts == 0u) continue;
      uint coff = state.u[SELB + bi];
      uint cb = CHILD_ST + coff * 16u;
      uint m12 = state.u[cb + 12u];
      int nxt = int(m12 & 0xFFu);
      int hold = bitfieldExtract(int(m12), 8, 8);
      uint depth = (m12 >> 24) & 0xFFu;
      int current = int(uni.u[82 + nxt]);

      // Lanes 0..15 write oi=0, lanes 16..31 write oi=1 (single wave, 100% coalesced!)
      uint oi = lane >> 4;
      uint w = lane & 15u;
      if (oi < nopts) {
        uint instLocal = first + oi;
        uint pb = PSTATE + instLocal * 16u;
        uint outW = 0u;
        if (w < 12u || w == 13u || w == 14u) {
          outW = state.u[cb + w];
        } else if (w == 12u) {
          int next_nxt = (oi == 0u) ? (nxt + 1) : ((hold < 0) ? (nxt + 2) : (nxt + 1));
          int next_hold = (oi == 0u) ? hold : current;
          outW = (uint(next_nxt) & 0xFFu)
               | ((uint(next_hold) & 0xFFu) << 8)
               | (oi << 16)
               | ((depth & 0xFFu) << 24);
        } else {
          int kind = (oi == 0u) ? current : ((hold < 0) ? int(uni.u[82 + nxt + 1]) : hold);
          int sy = (oi != 0u && hold >= 0) ? ((len > 20) ? (len - 21) : 0) : ((len > 20) ? (len - 21) : -MINY[kind * 4]);
          outW = (uint(kind) & 0xFFu)
               | (0u << 8)
               | (3u << 16)
               | ((uint(sy) & 0xFFu) << 24);
        }
        state.u[pb + w] = outW;
        if (w == 0u) state.u[REPSGEN + instLocal] = state.u[cb + 15u];
      }
    }
  }
}

// ---- S1: BPX-L over this ply's dynamically generated instances ----
shared uint sTick;
void stageS1(uint ply) {
  uint ni = state.u[STATS + ST_NI];
  uint lane = gl_LocalInvocationIndex;
  uint inst = gl_WorkGroupID.x;
  while (inst < ni) {
    bpxMainBP(inst);
    if (lane == 0u) sTick = atomicAdd(state.u[STATS + ST_TICKET], 1u);
    barrier();
    inst = sTick;
  }
}

// ---- Initialize Ply-0 Root Instances directly into PSTATE[0..ni-1] from 108-word DecisionRecord ----
void initRootNode() {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint tid = wg * 64u + lane;
  if (tid < 256u) {
    tabord.v[ROOT_BEST_U64 + tid] = 0ul;
    tabord.v[BEAM_BEST_U64 + tid] = 0ul;
  }
  if (wg != 0u) return;

  int len = int(uni.u[80]);
  int seq_len = int(uni.u[81]);
  uint rb = (lane < uint(len)) ? (uni.u[lane] & 0x3FFu) : 0u;
  int totRt = wg64AddI(lane < uint(len) ? rt_of(rb) : 0);
  uint gw = (lane < uint(len)) ? (uni.u[40u + lane] & 0xFFu) : 0u;
  uvec2 fbal = unpackUint2x32(wg64Ballot(gw != 0u));

  uint64_t myBl = packUint2x32(fbal);
  for (uint c = 0u; c < 10u; c++) {
    uint64_t bl64 = wg64Ballot(((rb >> c) & 1u) != 0u);
    if (lane == c) myBl = bl64;
  }
  uint cp32 = 0u;
  if (lane < 12u) {
    uvec2 bl = unpackUint2x32(myBl);
    uint64_t craw = (uint64_t(bitfieldReverse(bl.x)) << 32) | uint64_t(bitfieldReverse(bl.y));
    cp32 = (len > 0) ? uint(craw >> uint(64 - len)) : 0u;
    if (lane == 10u) cp32 = uint(totRt);
  }

  int root_hold = int(uni.u[99]);
  uint root_can_hold = uni.u[100] & 1u;
  int current = (seq_len > 0) ? int(uni.u[82]) : 0;
  uint nopts = 0u;
  if (seq_len > 0) {
    nopts = 1u;
    if (root_can_hold != 0u) {
      if (root_hold < 0) {
        if (seq_len > 1 && int(uni.u[83]) != current) nopts = 2u;
      } else if (root_hold != current) {
        nopts = 2u;
      }
    }
  }

  if (lane < 12u) {
    if (nopts >= 1u) state.u[PSTATE + lane] = cp32;
    if (nopts >= 2u) state.u[PSTATE + 16u + lane] = cp32;
  }
  if (lane == 0u) {
    int combo = int(uni.u[101]);
    int pending = int(uni.u[102]);
    int b2b_chain = int(uni.u[103]);
    int tslot = int(uni.u[105]);
    uint m13 = (uint(b2b_chain) & 0xFFu)
             | ((uint(combo + 1) & 0xFFu) << 8)
             | ((uint(pending) & 0xFFu) << 16)
             | ((uint(tslot) & 0xFFu) << 24);
    if (nopts >= 1u) {
      state.u[PSTATE + 12u] = 1u | ((uint(root_hold) & 0xFFu) << 8) | (0u << 16) | (0u << 24);
      state.u[PSTATE + 13u] = m13;
      state.u[PSTATE + 14u] = floatBitsToUint(0.0);
      state.u[PSTATE + 15u] = (uint(current) & 0xFFu)
                            | ((uni.u[96] & 0xFFu) << 8)
                            | ((uni.u[97] & 0xFFu) << 16)
                            | ((uni.u[98] & 0xFFu) << 24);
      state.u[REPSGEN + 0u] = 0xFFFFFFFFu;
    }
    if (nopts >= 2u) {
      int kind1 = (root_hold < 0) ? int(uni.u[83]) : root_hold;
      int nxt1 = (root_hold < 0) ? 2 : 1;
      int sy1 = (root_hold >= 0) ? ((len > 20) ? (len - 21) : 0) : ((len > 20) ? (len - 21) : -MINY[kind1 * 4]);
      state.u[PSTATE + 16u + 12u] = uint(nxt1) | ((uint(current) & 0xFFu) << 8) | (1u << 16) | (0u << 24);
      state.u[PSTATE + 16u + 13u] = m13;
      state.u[PSTATE + 16u + 14u] = floatBitsToUint(0.0);
      state.u[PSTATE + 16u + 15u] = (uint(kind1) & 0xFFu) | (0u << 8) | (3u << 16) | ((uint(sy1) & 0xFFu) << 24);
      state.u[REPSGEN + 1u] = 0xFFFFFFFFu;
    }
    state.u[STATS + ST_NI] = nopts;
    state.u[STATS + ST_NCH] = 0u;
    state.u[STATS + ST_ROOT_NC] = 0u;
    state.u[STATS + ST_TOT_NODES] = 0u;
    state.u[STATS + ST_MAX_DEPTH] = 0u;
    state.u[STATS + ST_LEAF_CNT] = 0u;
    state.u[STATS + ST_NSEL] = 1u;
  }
}

void main() {
  g_nwg = pcu.nwg;
  g_gsize = pcu.gsize;
  g_flags = pcu.flags;
  g_spin = pcu.spin;
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint nPlies = MAXPLY;

  if (state.u[STATS + ST_CLEAN] != 0xA77A1234u) {
    resetScratchFull();
  }
  { uint tid0 = wg * 64u + lane; if (tid0 < 180u) state.u[EVALCH + tid0] = floatBitsToUint(float(tab.t[tid0])); }
  initRootNode();

  uint bk = 0u;
  if (gbar(bk++)) return; // B0 (root PSTATE ready!)
  if (wg == 0u && lane == 0u) state.u[STATS + ST_CLEAN] = 0u;

  for (uint ply = 0u; ply < nPlies; ply++) {
    if (state.u[STATS + ST_NI] == 0u) break;
    if (wg == 0u && lane >= 28u && lane < 40u) state.u[STATS + lane] = 0u;
    if (wg == 0u && lane == 0u) state.u[STATS + ST_NTOUCH] = 0u;

    stageS1(ply);
    if (gbar(bk++)) return; // B1a (BP movegen done)

    stageS1b(ply, nPlies);
    if (gbar(bk++)) return; // B1b (BX + eval + dedupeA done)

    if (prodSelectTop96(ply, bk)) return;
    if (gbar(bk++)) return; // X2 (SELB published)

    matStage(ply, nPlies);
    resetScratchPly(ply);
    if (ply + 1u < nPlies) {
      if (gbar(bk++)) return; // B4 (next ply PSTATE ready!)
      if (state.u[STATS + ST_NSEL] == 0u) break;
    }
  }

  if (gbar(bk++)) return; // publication

  // Write compact serve summary to surv.w[0..] on WG 0
  if (wg == 0u) {
    uint nc0 = state.u[STATS + ST_ROOT_NC];
    // If no leaves were recorded at all (e.g. all paths died in Guideline mode after ply 0),
    // fall back to ply-0 non-dead root moves if any.
    uint leafCnt = state.u[STATS + ST_LEAF_CNT];
    uint maxDepth = state.u[STATS + ST_MAX_DEPTH];
    if (lane == 0u) {
      surv.w[0] = nc0;
      surv.w[1] = state.u[STATS + ST_TOT_NODES];
      surv.w[2] = maxDepth;
      surv.w[3] = leafCnt;
    }
    for (uint c = lane; c < nc0 && c < 256u; c += 64u) {
      uint rb = ROOT_INFO + c * 4u;
      uint64_t bestPk = 0ul;
      if (leafCnt > 0u) {
        bestPk = tabord.v[ROOT_BEST_U64 + c];
      } else {
        uint64_t bpk = tabord.v[BEAM_BEST_U64 + c];
        uint d = uint(bpk >> 56);
        if (d == maxDepth && d > 0u) {
          uint vord32 = uint((bpk >> 16) & 0xFFFFFFFFul);
          bestPk = (uint64_t(vord32) << 32) | (uint64_t(d) << 16);
        }
      }
      uint ob = 16u + c * 6u;
      surv.w[ob + 0u] = state.u[rb + 0u];
      surv.w[ob + 1u] = state.u[rb + 1u];
      surv.w[ob + 2u] = state.u[rb + 2u];
      surv.w[ob + 3u] = state.u[rb + 3u];
      surv.w[ob + 4u] = uint(bestPk);
      surv.w[ob + 5u] = uint(bestPk >> 32);
    }
    barrier();
    if (lane == 0u) {
      state.u[STATS + ST_CLEAN] = 0xA77A1234u;
      ctrl.u[3u] = nc0;
      ctrl.u[4u] = state.u[STATS + ST_TOT_NODES];
      memoryBarrierBuffer();
      ctrl.u[0u] = 1u;
    }
  }
}
