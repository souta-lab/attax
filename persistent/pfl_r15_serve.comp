// stock.rs stock_potential; hi=true fixes opportunity at 1.0 (prune phi_hi).
float stock_phi(int chain, int combo, int pending, int maxh, int tslot, int wellDepth, float m) {
    float cashable = float(s2surge(chain)) * m;
    int effH = maxh + pending;
    float qB = clip8(18 - effH);
    float g = clip6(14 - maxh) * clip6(20 - effH);
    float ubase = max(float(s2surge(chain + 1)) * m - cashable, 0.0);
    float opp = tslot > 0 ? 1.0 : (wellDepth >= 4 ? 0.7 : 0.35);
    float uB = opp * ubase;
    float uR = 0.0;
    if (combo >= 0) {
        for (int j = 1; j <= 3; j++) {
            uR += tabf(65 + (j - 1)) * (combo_raw(1.0, combo + j) - combo_raw(1.0, j - 1));
        }
        uR *= m;
    }
    float inner = qB * cashable + g * (tabf(178) * uB + tabf(179) * uR);
    return tabf(177) * tabf(165) * inner;
}

