// ---- Helper: atomic update of root_best (64-bit packed: (vord32 << 32) | (depth << 16)) ----
void recordLeafBest(uint root_id, uint vord32, uint depth) {
    if (root_id >= 256u) return;
    uint64_t pk = (uint64_t(vord32) << 32) | (uint64_t(depth & 0xFFu) << 16);
    atomicMax(tabord.v[ROOT_BEST_U64 + root_id], pk);
    atomicAdd(state.u[STATS + ST_LEAF_CNT], 1u);
}
void recordBeamBest(uint root_id, uint vord32, uint depth) {
    if (root_id >= 256u) return;
    uint64_t pk = (uint64_t(depth & 0xFFu) << 56) | (uint64_t(vord32) << 16);
    atomicMax(tabord.v[BEAM_BEST_U64 + root_id], pk);
}

// ---- S1b: Full-wave Live BX + Eval + Fused dedupeA (S2 & Guideline/TBP) ----
void stageS1b(uint ply, uint nPlies) {
    uint ni = state.u[STATS + ST_NI];
