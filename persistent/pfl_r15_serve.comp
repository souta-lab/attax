            int row = py + hd.z + i;
            if (row < 0 || row >= len) continue;
            uint level = uint(len - 1 - row);
            uint bits = vget4(srw, i);
            uint pr = row_mask10(col[0], col[1], col[2], col[3], col[4], col[5], col[6], col[7], col[8], col[9], level);
            uint pmask = (shift >= 0) ? (bits << uint(shift)) : (bits >> uint(-shift));
            rt += rt_of((pr | pmask) & 0x3FFu) - rt_of(pr);
            uint64_t lvBit = 1ul << level;
            if ((pmask & 1u) != 0u) col[0] |= lvBit;
            if ((pmask & 2u) != 0u) col[1] |= lvBit;
            if ((pmask & 4u) != 0u) col[2] |= lvBit;
            if ((pmask & 8u) != 0u) col[3] |= lvBit;
            if ((pmask & 16u) != 0u) col[4] |= lvBit;
