        while (lo < hi) {
            uint mid = (lo + hi + 1u) >> 1;
            if (pool[mid] <= coff) lo = mid;
            else hi = mid - 1u;
        }
        uint instLocal = lo;
        uint localIdx = coff - pool[instLocal];
        uint rawPlc = state.u[CHILD_PLC + instLocal * 64u + localIdx];
        uint recw2 = rawPlc & 0x00FFFFFFu;
        uint pbase = PSTATE + instLocal * 16u;

        uint sw = state.u[pbase + 15u];
        int kind_b = int(sw & 0xFFu);
        int rot = int(recw2 & 3u);
        int px = int((recw2 >> 4) & 0xFFu); if (px >= 128) px -= 256;
