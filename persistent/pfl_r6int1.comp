            uint64_t T = transpose8x8(P);
            uint64_t T2 = transpose8x8(Q);
            rp6 |= ((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 30u;
            rp6 |= ((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 20u;
            rp6 |= ((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 10u;
            rp6 |= ((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 0u;
            rp5 |= ((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 50u;
            rp5 |= ((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 40u;
            rp5 |= ((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 30u;
            rp5 |= ((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 20u;
          } }
        uint64_t hh = (uint64_t(0x14650FB0u) << 32) | uint64_t(0x739D0383u);
        uint64_t prime = (uint64_t(0x100u) << 32) | uint64_t(0x000001B3u);
        hh = (hh ^ hw0) * prime;
        hh = (hh ^ hw1) * prime;
        hh = (hh ^ hw2) * prime;
        hh = (hh ^ flb) * prime;
        hh = (hh ^ rp0) * prime;
        hh = (hh ^ rp1) * prime;
        hh = (hh ^ rp2) * prime;
        hh = (hh ^ rp3) * prime;
        hh = (hh ^ rp4) * prime;
        hh = (hh ^ rp5) * prime;
        hh = (hh ^ rp6) * prime;

        // ---- accumulated (bound form; same operations as the eval form) ----
        precise double rw = double(attack) * tab.t[165];
        if (sDepth == 0) {
            precise double conv = tab.t[169] * double(max(attack - sPending, 0));
            rw += conv;
        }
        int ck = -1;
        if (lines > 0) {
            if (pc_) ck = 8;
            else if (spin == 1) ck = 4;
            else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
            else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
        }
        if (ck >= 0) rw += tab.t[156 + ck];
        if (ck == 4) {
            double delta = lines == 1 ? tab.t[174] : (lines == 2 ? tab.t[175] : (lines == 3 ? tab.t[176] : 0.0lf));
            if (delta != 0.0lf) rw += delta;
        }
        if (sChain != 0 && lines > 0 && !difficult && !pc_) rw += tab.t[166];
        if (kind_b == 2 && spin == 0 && sTslot > 0) rw += tab.t[167];
        precise double acc = sReward + sScale * (rw - tab.t[170] * double(danger));

        // ---- all-exact bound (stage-2B mode 6 arithmetic, verbatim) ----
        int hcUsed = tab.t[148] < 0.0lf ? holes : 4 * holes;
        int tsUsed = tab.t[155] > 0.0lf ? 2 : 0;
        precise double dotHi = 0.0lf;
        { precise double term = tab.t[145 + 0] * double(maxh); dotHi += term; }
        { precise double term = tab.t[145 + 1] * double(danger); dotHi += term; }
        { precise double term = tab.t[145 + 2] * double(holes); dotHi += term; }
        { precise double term = tab.t[145 + 3] * double(hcUsed); dotHi += term; }
        { precise double term = tab.t[145 + 4] * double(holeRows); dotHi += term; }
        { precise double term = tab.t[145 + 5] * double(bump); dotHi += term; }
        { precise double term = tab.t[145 + 6] * double(bumpSq); dotHi += term; }
        { precise double term = tab.t[145 + 7] * double(rt); dotHi += term; }
        { precise double term = tab.t[145 + 8] * double(wellDepth); dotHi += term; }
        { precise double term = tab.t[145 + 9] * double(extraWells); dotHi += term; }
        { precise double term = tab.t[145 + 10] * double(tsUsed); dotHi += term; }
        precise double phiHi = 0.0lf;
        precise double phiEx = 0.0lf;
        if (tab.t[177] != 0.0lf) {
            phiHi = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, true);
            phiEx = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, false);
        }
        double b2bState = (tab.t[171] != 0.0lf && dchain >= 1) ? tab.t[171] : 0.0lf;
        precise double factor = sScale * tab.t[168];
        precise double u = acc + factor * (dotHi + b2bState + phiHi) + 1e-6lf;
        precise double dHc = factor * tab.t[148] * double(holeCover - hcUsed);
        precise double dTs2 = factor * tab.t[155] * double(tslot - tsUsed);
        precise double dPhi = factor * (phiEx - phiHi);
        precise double uAll = u + dHc + dTs2 + dPhi;

        // ---- pack + write the 16-word record (bxp_a form) ----
        uint64_t flo = 0ul;
        flo |= (uint64_t(uint(maxh)) & 0x7Ful) << 0;
        flo |= (uint64_t(uint(danger)) & 0x3FFul) << 7;
        flo |= (uint64_t(uint(holes)) & 0x1FFul) << 17;
        flo |= (uint64_t(uint(holeCover)) & 0x7FFul) << 26;
        flo |= (uint64_t(uint(holeRows)) & 0x3Ful) << 37;
        flo |= (uint64_t(uint(bump)) & 0x1FFul) << 43;
        flo |= (uint64_t(uint(rt)) & 0x1FFul) << 52;
        flo |= (uint64_t(uint(wellDepth)) & 0x7ul) << 61;
        uint fhi = uint(bumpSq) | (uint(extraWells) << 14) | (uint(tslot) << 18);
        uint scA = uint(spin) | (uint(lines) << 2) | ((dead ? 1u : 0u) << 8) | ((pc_ ? 1u : 0u) << 9)
            | (uint(attack) << 10) | (uint(gc) << 20);
        uint scB = uint(combo + 1) | (uint(dchain) << 6) | (uint(pending) << 14) | (uint(landed) << 20);
        uvec2 ub = unpackDouble2x32(uAll);
        uint rb = child * 4u;
        rec.q[rb + 0u] = uvec4(uint(hh & 0xFFFFFFFFul), uint(hh >> 32), ub.x, ub.y);
        rec.q[rb + 1u] = uvec4(0u, 0u, 0u, 0u);
        rec.q[rb + 2u] = uvec4(0u, 0u, uint(flo & 0xFFFFFFFFul), uint(flo >> 32));
        rec.q[rb + 3u] = uvec4(fhi, scA, scB, ii);
        STASH(li * 5u + 0u) = uint(flo & 0xFFFFFFFFul);
        STASH(li * 5u + 1u) = uint(flo >> 32);
        STASH(li * 5u + 2u) = fhi;
        STASH(li * 5u + 3u) = scA;
        STASH(li * 5u + 4u) = scB;

        // ---- survivor compaction (static tau; bxp_a rule verbatim) ----
        uint pos = child - pc.childBase;
        if (uAll > tau || (uAll == tau && pos <= pc.tauPos)) {
            survived = true;
            uint s = atomicAdd(survCnt.w[0], 1u);
            surv.w[pc.survBase + s] = child;
        }
    }
    // ---- local survivor enumeration (uniform subgroup position) ----
    uvec4 bal = subgroupBallot(survived);
    uint nSurvL = popc64(packUint2x32(bal.xy));
    uint mySlot = subgroupExclusiveAdd(survived ? 1u : 0u);
    if (survived) SURVL(mySlot) = li;
    barrier();
    memoryBarrier();
    barrier();

    // ================= in-wave evaluation (bxp_b arithmetic, verbatim) =================
    for (uint j0 = 0u; j0 < nSurvL; j0 += 64u) {
        uint j = j0 + lane;
        if (j < nSurvL) {
            uint li2 = SURVL(j);
            uint child = sChildOff + li2;
            uint flo_lo = STASH(li2 * 5u + 0u);
            uint flo_hi = STASH(li2 * 5u + 1u);
            uint fhi = STASH(li2 * 5u + 2u);
            uint scA = STASH(li2 * 5u + 3u);
            uint scB = STASH(li2 * 5u + 4u);
            uint64_t flo = (uint64_t(flo_hi) << 32) | uint64_t(flo_lo);
            int maxh = int((flo >> 0) & 0x7Ful);
            int danger = int((flo >> 7) & 0x3FFul);
            int holes = int((flo >> 17) & 0x1FFul);
            int holeCover = int((flo >> 26) & 0x7FFul);
            int holeRows = int((flo >> 37) & 0x3Ful);
            int bump = int((flo >> 43) & 0x1FFul);
            int rt = int((flo >> 52) & 0x1FFul);
            int wellDepth = int((flo >> 61) & 0x7ul);
            int bumpSq = int(fhi & 0x3FFFu);
            int extraWells = int((fhi >> 14) & 0xFu);
            int tslot = int((fhi >> 18) & 0x3u);
            int spin = int(scA & 0x3u);
            int lines = int((scA >> 2) & 0x3Fu);
            bool pc_ = ((scA >> 9) & 0x1u) != 0u;
            int attack = int((scA >> 10) & 0x3FFu);
            int combo = int(scB & 0x3Fu) - 1;
            int dchain = int((scB >> 6) & 0xFFu);
            int pending = int((scB >> 14) & 0x3Fu);
            bool difficult = lines > 0 && (lines == 4 || spin != 0 || pc_);

            precise double reward = double(attack) * tab.t[165];
            if (sDepth == 0) {
                precise double conv = tab.t[169] * double(max(attack - sPending, 0));
                reward += conv;
            }
            int ck = -1;
            if (lines > 0) {
                if (pc_) ck = 8;
                else if (spin == 1) ck = 4;
                else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
                else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
            }
            if (ck >= 0) reward += tab.t[156 + ck];
            if (ck == 4) {
                double delta = lines == 1 ? tab.t[174] : (lines == 2 ? tab.t[175] : (lines == 3 ? tab.t[176] : 0.0lf));
                if (delta != 0.0lf) reward += delta;
            }
            if (sChain != 0 && lines > 0 && !difficult && !pc_) reward += tab.t[166];
            if (sKind == 2 && spin == 0 && sTslot > 0) reward += tab.t[167];
            precise double accumulated = sReward + sScale * (reward - tab.t[170] * double(danger));
            precise double phi = 0.0lf;
            if (tab.t[177] != 0.0lf) {
                phi = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, false);
            }
            precise double dot = 0.0lf;
            { precise double term = double(maxh) * tab.t[145 + 0]; dot += term; }
            { precise double term = double(danger) * tab.t[145 + 1]; dot += term; }
            { precise double term = double(holes) * tab.t[145 + 2]; dot += term; }
            { precise double term = double(holeCover) * tab.t[145 + 3]; dot += term; }
            { precise double term = double(holeRows) * tab.t[145 + 4]; dot += term; }
            { precise double term = double(bump) * tab.t[145 + 5]; dot += term; }
            { precise double term = double(bumpSq) * tab.t[145 + 6]; dot += term; }
            { precise double term = double(rt) * tab.t[145 + 7]; dot += term; }
            { precise double term = double(wellDepth) * tab.t[145 + 8]; dot += term; }
            { precise double term = double(extraWells) * tab.t[145 + 9]; dot += term; }
            { precise double term = double(tslot) * tab.t[145 + 10]; dot += term; }
            double b2bState = (tab.t[171] != 0.0lf && dchain >= 1) ? tab.t[171] : 0.0lf;
            precise double br = dot;
            br += b2bState;
            br += 0.0lf;
            br += 0.0lf;
            br += phi;
            br -= 0.0lf;
            precise double sd = sScale * tab.t[168];
            precise double value = accumulated + sd * br;

            uvec2 vb = unpackDouble2x32(value);
            uint64_t vbits;
            if (value == 0.0lf) vbits = 0ul;
            else vbits = (uint64_t(vb.y) << 32) | uint64_t(vb.x);
            uint64_t ord = (vbits >> 63) != 0ul ? ~vbits : (vbits | 0x8000000000000000ul);
            uint64_t keyK = ~ord;

            uvec2 ab = unpackDouble2x32(accumulated);
            uint rb = child * 4u;
            rec.q[rb + 1u] = uvec4(vb.x, vb.y, ab.x, ab.y);
            rec.q[rb + 2u] = uvec4(uint(keyK & 0xFFFFFFFFul), uint(keyK >> 32), flo_lo, flo_hi);
        }
    }

    // ================= plc byproduct (bxp_a input format) =================
    if (sEmitPlc != 0u && lane < sNChild) {
        uint r = PLACE(lane);
        uint child = sChildOff + lane;
        plc.w[child * 2u] = uint(sKind) | ((r & 3u) << 8) | (((r >> 4) & 0xFFu) << 16) | (((r >> 12) & 0xFFu) << 24);
        plc.w[child * 2u + 1u] = (r >> 20) & 7u;
    }

    if (lane == 0u) status.w[ii] = (sErr & 0xFFu) | ((iters & 0xFFu) << 8) | (sNChild << 16);
}

// ================= selection stage bodies =================
// Ports of the stage-3 final forms (3B v5 + 3C integrated dedupe)
// into the resident kernel. Differences from the basic forms are
// structural only: child-direct iteration (list positions replaced
// by ply-local child offsets — order-isomorphic, so every tie-break
// resolves identically), 64-lane workgroup-0 scans instead of
// 1024/256-lane ones, and LDS key staging dropped (keys read from
// the global ord caches; the kept arrays alias BPX's shared, which
// is dead by S3). Semantics follow the originals line for line.
#define PFXIDX 188800u
shared uint p_p0;
shared uint p_digit;
shared uint p_acc;
shared uint p_total;
shared uint p_nextIdxA;
shared uint p_snext;
shared uint p_cand;
shared bool p_narrow;
shared bool p_arm;
shared uint64_t j_nextOrd;
shared uint j_nextIdx;
shared uint j_hasNext;
shared uint h_nAlive, h_nReps, h_nSel, h_nEval, h_rounds, h_nSurv;

uint pfMsb64(uint64_t x) {
  uint hi = uint(x >> 32);
  return hi != 0u ? 32u + uint(findMSB(hi)) : uint(findMSB(uint(x)));
}
uint64_t selKeyOf(uint keysOff, uint i) {
  return (uint64_t(state.u[keysOff + 2u * i + 1u]) << 32) | uint64_t(state.u[keysOff + 2u * i]);
}
uint selIdOf(bool ev, uint i) { return ev ? state.u[EVLIST + 2u * i] : state.u[REPSGEN + i]; }
uint64_t selKeyGet(uint i) { return i < 64u ? sF[i] : packUint2x32(uvec2(pool[2u * (i - 64u)], pool[2u * (i - 64u) + 1u])); }
void selKeySet(uint i, uint64_t v) { if (i < 64u) sF[i] = v; else { uvec2 u = unpackUint2x32(v); pool[2u * (i - 64u)] = u.x; pool[2u * (i - 64u) + 1u] = u.y; } }

// ---- prefix-P: sel_prefix4's adaptive radix select at 64 lanes ----
// Output: PREFIXB/PFXIDX = [keys > T in index order] ++ [keys == T
// in index order, first `need`]; STATS pfx size / nGt; next-rep
// capture (STATS next key/idx/hasNext) = the element at rank b.
void prefixP(uint keysOff, uint n, uint b, bool ev, uint64_t mn, uint64_t mx) {
  uint lane = gl_LocalInvocationIndex;
  for (uint j = lane * 4u; j < lane * 4u + 4u; j++) pool[j] = 0u;
  if (ev && state.u[STATS + ST_EVST0 + 0u] == n && state.u[STATS + ST_EVST0 + 1u] == b
      && state.u[STATS + ST_EVST0 + 2u] == uint(mn) && state.u[STATS + ST_EVST0 + 3u] == uint(mn >> 32)
      && state.u[STATS + ST_EVST0 + 4u] == uint(mx) && state.u[STATS + ST_EVST0 + 5u] == uint(mx >> 32)
      && state.u[STATS + ST_EVST0 + 6u] == state.u[STATS + ST_EVGEN]) {
    if (lane == 0u) {
      p_T = (uint64_t(state.u[STATS + ST_EVST0 + 8u]) << 32) | uint64_t(state.u[STATS + ST_EVST0 + 7u]);
      p_need = state.u[STATS + ST_EVST0 + 9u];
    }
    barrier();
    return;
  }
  if (b >= n) {
    for (uint i = lane; i < n; i += 64u) {
      state.u[PREFIXB + i] = selIdOf(ev, i);
      state.u[PFXIDX + i] = i;
    }
    barrier();
    if (lane == 0u) {
      state.u[STATS + ST_PFXSZ] = n;
      state.u[STATS + ST_NGT] = n;
      state.u[STATS + ST_HASNEXT] = 0u;
    }
    barrier();
    return;
  }
  if (lane == 0u) {
    uint64_t xr = mn ^ mx;
    p_rem = b;
    if (xr == 0ul) {
      p_p0 = 8u;
      p_T = mn;
      p_need = b;
      p_prefix = mn;
    } else {
      uint p0 = (63u - pfMsb64(xr)) >> 3;
      p_p0 = p0;
      p_prefix = (p0 == 0u) ? 0ul : (mn >> (64u - 8u * p0));
    }
    p_nextIdxA = 0xFFFFFFFFu;
    p_tauIdx = 0xFFFFFFFFu;
    p_narrow = false;
    p_arm = false;
    p_cand = 0u;
  }
  barrier();
  if (p_p0 < 8u) {
    for (uint p = p_p0; p < 8u; p++) {
      uint shift = 56u - 8u * p;
      if (p_narrow) {
        for (uint t = lane; t < p_cand; t += 64u) {
          uint i = state.u[TABFP + t];
          uint64_t key = selKeyOf(keysOff, i);
          if ((key >> (shift + 8u)) == p_prefix)
            atomicAdd(pool[uint((key >> shift) & 0xFFul)], 1u);
        }
      } else {
        for (uint i = lane; i < n; i += 64u) {
          uint64_t key = selKeyOf(keysOff, i);
          if (p == 0u || (key >> (shift + 8u)) == p_prefix) {
            atomicAdd(pool[uint((key >> shift) & 0xFFul)], 1u);
            if (p_arm) {
              uint s = atomicAdd(p_cand, 1u);
              state.u[TABFP + s] = i;
            }
          }
        }
      }
      barrier();
      uint ls = pool[lane * 4u] + pool[lane * 4u + 1u] + pool[lane * 4u + 2u] + pool[lane * 4u + 3u];
      uint incl = subgroupInclusiveAdd(ls);
      uint total = subgroupBroadcast(incl, 63u);
      if (lane == 63u) p_total = incl;
      uint run = incl - ls;
      for (uint j = 0u; j < 4u; j++) {
        uint bin = lane * 4u + j;
        uint hd = pool[bin];
        run += hd;
        uint greater = total - run;
        if (greater < p_rem && p_rem <= greater + hd) { p_digit = bin; p_acc = greater; p_snext = hd; }
      }
      barrier();
      if (lane == 0u) {
        p_prefix = (p_prefix << 8) | uint64_t(p_digit);
        p_rem -= p_acc;
        if (p == 7u) { p_T = p_prefix; p_need = p_rem; }
      }
      for (uint j = lane * 4u; j < lane * 4u + 4u; j++) pool[j] = 0u;
      barrier();
      if (!p_narrow && p_arm) {
        if (lane == 0u) { p_narrow = true; p_arm = false; }
        barrier();
      } else if (!p_narrow && !p_arm && p + 2u < 8u && p_snext <= 512u && n > 512u) {
        if (lane == 0u) { p_cand = 0u; p_arm = true; }
        barrier();
      }
    }
  }
  uint64_t T = p_T;
  uint need = p_need;
  // ---- merged compaction: one count scan, one write scan ----
  uint K = (n + 63u) / 64u;
  uint lo = lane * K;
  uint hi = min(n, lo + K);
  uint cntA = 0u, cntB = 0u;
  for (uint i = lo; i < hi; i++) {
    uint64_t k = selKeyOf(keysOff, i);
    cntA += (k > T) ? 1u : 0u;
    cntB += (k == T) ? 1u : 0u;
  }
  pool[256u + lane] = subgroupInclusiveAdd(cntA);
  pool[320u + lane] = subgroupInclusiveAdd(cntB);
  uint offA = pool[256u + lane] - cntA;
  uint offB = pool[320u + lane] - cntB;
  uint totA = pool[256u + 63u];
  barrier();
  uint wA = offA, rB = offB;
  uint64_t bestKey = 0ul;
  uint bestIdx = 0xFFFFFFFFu;
  for (uint i = lo; i < hi; i++) {
    uint64_t k = selKeyOf(keysOff, i);
    if (k > T) {
      state.u[PREFIXB + wA] = selIdOf(ev, i);
      state.u[PFXIDX + wA] = i;
      wA++;
    } else if (k == T) {
      if (rB == need - 1u) p_tauIdx = i;
      if (rB < need) {
        state.u[PREFIXB + totA + rB] = selIdOf(ev, i);
        state.u[PFXIDX + totA + rB] = i;
      }
      if (rB == need) p_nextIdxA = i;
      rB++;
    } else if (bestIdx == 0xFFFFFFFFu || k > bestKey) {
      bestKey = k;
      bestIdx = i;
    }
  }
  pool[256u + lane] = uint(bestKey);
  pool[320u + lane] = uint(bestKey >> 32);
  sOrderPk[lane] = bestIdx;
  barrier();
  if (lane == 0u) {
    state.u[STATS + ST_PFXSZ] = totA + need;
    state.u[STATS + ST_NGT] = totA;
    if (p_nextIdxA != 0xFFFFFFFFu) {
      state.u[STATS + ST_NKEYLO] = uint(T);
      state.u[STATS + ST_NKEYHI] = uint(T >> 32);
      state.u[STATS + ST_NIDX] = p_nextIdxA;
      state.u[STATS + ST_HASNEXT] = 1u;
    } else {
      uint bi = 0xFFFFFFFFu;
      uint64_t bk2 = 0ul;
      for (uint l = 0u; l < 64u; l++) {
        uint ix = sOrderPk[l];
        if (ix == 0xFFFFFFFFu) continue;
        uint64_t kk = (uint64_t(pool[320u + l]) << 32) | uint64_t(pool[256u + l]);
        if (bi == 0xFFFFFFFFu || kk > bk2 || (kk == bk2 && ix < bi)) { bk2 = kk; bi = ix; }
      }
      if (bi != 0xFFFFFFFFu) {
        state.u[STATS + ST_NKEYLO] = uint(bk2);
        state.u[STATS + ST_NKEYHI] = uint(bk2 >> 32);
        state.u[STATS + ST_NIDX] = bi;
        state.u[STATS + ST_HASNEXT] = 1u;
      } else {
        state.u[STATS + ST_HASNEXT] = 0u;
      }
    }
  }
  barrier();
  if (ev && lane == 0u) {
    state.u[STATS + ST_EVST0 + 0u] = n;
    state.u[STATS + ST_EVST0 + 1u] = b;
    state.u[STATS + ST_EVST0 + 2u] = uint(mn);
    state.u[STATS + ST_EVST0 + 3u] = uint(mn >> 32);
    state.u[STATS + ST_EVST0 + 4u] = uint(mx);
    state.u[STATS + ST_EVST0 + 5u] = uint(mx >> 32);
    state.u[STATS + ST_EVST0 + 6u] = state.u[STATS + ST_EVGEN];
    state.u[STATS + ST_EVST0 + 7u] = uint(p_T);
    state.u[STATS + ST_EVST0 + 8u] = uint(p_T >> 32);
    state.u[STATS + ST_EVST0 + 9u] = p_need;
  }
}

// ---- S2: dedupe phase A (rec_dedup_m form, child-direct) ----
void dedupeA(uint ply) {
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint coff = tid; coff < nch; coff += tt) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    uint64_t fp = (uint64_t(recw.w[child * 16u + 1u]) << 32) | uint64_t(recw.w[child * 16u + 0u]);
    uint64_t ord = recOrdU(child);
    uint slot = uint(sm64(fp)) & 16383u;
    bool found = false;
    for (uint it = 0u; it <= 16383u; it++) {
      uint64_t cur = atomicCompSwap(tabfp.v[slot], EMPTY64, fp);
      if (cur == EMPTY64 || cur == fp) { found = true; break; }
      slot = (slot + 1u) & 16383u;
    }
    if (found) {
      state.u[SLOTOF + coff] = slot;
      atomicMax(tabord.v[slot], ord);
    } else {
      state.u[SLOTOF + coff] = 0xFFFFFFFFu;
    }
  }
}

// ---- S3 head: dedupe phase B (min generation among max-ord) ----
void dedupeB(uint ply) {
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint coff = tid; coff < nch; coff += tt) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    uint64_t tmax = tabord.v[slot];
    if (recOrdU(child) == tmax) atomicMin(state.u[TABMETA + 2u * slot], coff);
  }
}

// ---- emit + order (WG 0): representatives in generation order ----
void emitOrder(uint ply) {
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint K = (nch + 63u) / 64u;
  uint lo = lane * K;
  uint hi = min(nch, lo + K);
  uint myRep = 0u, myAlive = 0u;
  for (uint coff = lo; coff < hi; coff++) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    myAlive++;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    if (recOrdU(child) == tabord.v[slot] && coff == state.u[TABMETA + 2u * slot]) myRep++;
  }
  eo_a[lane] = subgroupInclusiveAdd(myRep);
  eo_b[lane] = subgroupInclusiveAdd(myAlive);
  barrier();
  uint off = eo_a[lane] - myRep;
  for (uint coff = lo; coff < hi; coff++) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    if (recOrdU(child) == tabord.v[slot] && coff == state.u[TABMETA + 2u * slot])
      state.u[REPSGEN + off++] = child;
  }
  if (lane == 0u) {
    state.u[STATS + ST_NREPS] = eo_a[63];
    state.u[STATS + ST_NALIVE] = eo_b[63];
  }
  barrier();
}

// ---- emitOrder grid phase (p2): canonical emitOrder split over
// contiguous coff blocks, one per WG. REPSGEN order is identical:
// blocks ascend, and inside a WG the lane sub-ranges ascend, so the
// concatenation is exactly the canonical coff-ascending sequence.
// Counts/offsets scratch: REPSORD[0..384), dead until cacheStage
// refills REPSORD later in the ply (layout supports nwg <= 128). ----
#define EO_REPC (REPSORD)
#define EO_ALVC (REPSORD + 128u)
#define EO_ROFF (REPSORD + 256u)
bool emitOrderPX(uint ply, inout uint bk) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint nwg = g_nwg;
  uint base = nch / nwg, rem = nch % nwg;
  uint blo = wg * base + min(wg, rem);
  uint bhi = blo + base + (wg < rem ? 1u : 0u);
  uint nb = bhi - blo;
  uint K = (nb + 63u) / 64u;
  uint lo = blo + lane * K;
  uint hi = min(bhi, lo + K);
  uint myRep = 0u, myAlive = 0u;
  for (uint coff = lo; coff < hi; coff++) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    myAlive++;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    if (recOrdU(child) == tabord.v[slot] && coff == state.u[TABMETA + 2u * slot]) myRep++;
  }
  eo_a[lane] = subgroupInclusiveAdd(myRep);
  eo_b[lane] = subgroupInclusiveAdd(myAlive);
  barrier();
  if (lane == 0u) {
    state.u[EO_REPC + wg] = eo_a[63];
    state.u[EO_ALVC + wg] = eo_b[63];
  }
  if (gbar(bk++)) return true;
  if (wg == 0u && lane < nwg) {
    uint r = 0u, a = 0u;
    for (uint w = 0u; w < lane; w++) {
      r += state.u[EO_REPC + w];
      a += state.u[EO_ALVC + w];
    }
    state.u[EO_ROFF + lane] = r;
    if (lane == nwg - 1u) {
      state.u[STATS + ST_NREPS] = r + state.u[EO_REPC + nwg - 1u];
      state.u[STATS + ST_NALIVE] = a + state.u[EO_ALVC + nwg - 1u];
    }
  }
  if (gbar(bk++)) return true;
  uint off = state.u[EO_ROFF + wg] + eo_a[lane] - myRep;
  for (uint coff = lo; coff < hi; coff++) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    if (recOrdU(child) == tabord.v[slot] && coff == state.u[TABMETA + 2u * slot])
      state.u[REPSGEN + off++] = child;
  }
  return false;
}

// ---- repsOrd cache + min/max (sel_cache2 form) ----
void cacheStage(uint ply) {
  uint nReps = state.u[STATS + ST_NREPS];
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint j = tid; j < nReps; j += tt) {
    uint child = state.u[REPSGEN + j];
    uint64_t k = recOrdU(child);
    state.u[REPSORD + 2u * j] = uint(k);
    state.u[REPSORD + 2u * j + 1u] = uint(k >> 32);
    atomicMin(mmu.v[0], k);
    atomicMax(mmu.v[1], k);
  }
}

// ---- one B&B round head (WG 0): prefix + chunk build ----
void prefixAndChunk(uint ply, uint bcur) {
  uint lane = gl_LocalInvocationIndex;
  uint nReps = state.u[STATS + ST_NREPS];
  prefixP(REPSORD, nReps, bcur, false, mmu.v[0], mmu.v[1]);
  if (lane == 0u) c_cnt = 0u;
  barrier();
  uint childBase = plyCB(ply);
  uint nEval0 = state.u[STATS + ST_NEVAL];
  for (uint j = lane; j < bcur; j += 64u) {
    uint child = state.u[PREFIXB + j];
    uint coff = child - childBase;
    uint old = atomicOr(state.u[EVALCH + coff], 1u);
    if (old == 0u) {
      uint s = atomicAdd(c_cnt, 1u);
      state.u[CHUNKB + s] = child;
      surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
    }
  }
  barrier();
  if (lane == 0u) {
    state.u[STATS + ST_CN] = c_cnt;
    state.u[STATS + ST_NEVAL] = nEval0 + c_cnt;
  }
  barrier();
}

// ---- pass B: bxp_b.comp main body, mechanically extracted ----
// (bindings renamed: inst->inst48, plc->plcin, surv->chunkb;
// helpers ln1p125/clip6/clip8/s2surge/combo_raw/stock_phi are the
// BPX section's own copies, which bpxl.comp carries verbatim.)
void passBOne(uint si) {
    uint child = chunkb.w[si];
    uint rb = child * 4u;
    uvec4 q2 = rec.q[rb + 2u];
    uvec4 q3 = rec.q[rb + 3u];

    // ---- unpack features ----
    uint64_t flo = (uint64_t(q2.w) << 32) | uint64_t(q2.z);
    int maxh = int((flo >> 0) & 0x7Ful);
    int danger = int((flo >> 7) & 0x3FFul);
    int holes = int((flo >> 17) & 0x1FFul);
    int holeCover = int((flo >> 26) & 0x7FFul);
    int holeRows = int((flo >> 37) & 0x3Ful);
    int bump = int((flo >> 43) & 0x1FFul);
    int rt = int((flo >> 52) & 0x1FFul);
    int wellDepth = int((flo >> 61) & 0x7ul);
    uint fhi = q3.x;
    int bumpSq = int(fhi & 0x3FFFu);
    int extraWells = int((fhi >> 14) & 0xFu);
    int tslot = int((fhi >> 18) & 0x3u);

    // ---- unpack scalars ----
    uint scA = q3.y;
    int spin = int(scA & 0x3u);
    int lines = int((scA >> 2) & 0x3Fu);
    bool pc_ = ((scA >> 9) & 0x1u) != 0u;
    int attack = int((scA >> 10) & 0x3FFu);
    uint scB = q3.z;
    int combo = int(scB & 0x3Fu) - 1;
    int dchain = int((scB >> 6) & 0xFFu);
    int pending = int((scB >> 14) & 0x3Fu);
    bool difficult = lines > 0 && (lines == 4 || spin != 0 || pc_);

    // ---- parent instance scalars ----
    uint ii = q3.w;
    uint ib = ii * 48u;
    int sDepth = int(inst48.w[ib + 1u]);
    int sChain = int(inst48.w[ib + 38u]);
    int sPending = int(inst48.w[ib + 39u]);
    int sTslot = int(inst48.w[ib + 41u]);
    double sReward = packDouble2x32(uvec2(inst48.w[ib + 42u], inst48.w[ib + 43u]));
    double sMult = packDouble2x32(uvec2(inst48.w[ib + 44u], inst48.w[ib + 45u]));
    double sScale = packDouble2x32(uvec2(inst48.w[ib + 46u], inst48.w[ib + 47u]));
    int kind = int(plcin.w[child * 2u] & 0xFFu);

    // ---- full evaluation (stage-2B eval arithmetic, verbatim) ----
    precise double reward = double(attack) * tab.t[165];
    if (sDepth == 0) {
        precise double conv = tab.t[169] * double(max(attack - sPending, 0));
        reward += conv;
    }
    int ck = -1;
    if (lines > 0) {
        if (pc_) ck = 8;
        else if (spin == 1) ck = 4;
        else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
        else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
    }
    if (ck >= 0) reward += tab.t[156 + ck];
    if (ck == 4) {
        double delta = lines == 1 ? tab.t[174] : (lines == 2 ? tab.t[175] : (lines == 3 ? tab.t[176] : 0.0lf));
        if (delta != 0.0lf) reward += delta;
    }
    if (sChain != 0 && lines > 0 && !difficult && !pc_) reward += tab.t[166];
    if (kind == 2 && spin == 0 && sTslot > 0) reward += tab.t[167];
    precise double accumulated = sReward + sScale * (reward - tab.t[170] * double(danger));
    precise double phi = 0.0lf;
    if (tab.t[177] != 0.0lf) {
        phi = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, false);
    }
    precise double dot = 0.0lf;
    { precise double term = double(maxh) * tab.t[145 + 0]; dot += term; }
    { precise double term = double(danger) * tab.t[145 + 1]; dot += term; }
    { precise double term = double(holes) * tab.t[145 + 2]; dot += term; }
    { precise double term = double(holeCover) * tab.t[145 + 3]; dot += term; }
    { precise double term = double(holeRows) * tab.t[145 + 4]; dot += term; }
    { precise double term = double(bump) * tab.t[145 + 5]; dot += term; }
    { precise double term = double(bumpSq) * tab.t[145 + 6]; dot += term; }
    { precise double term = double(rt) * tab.t[145 + 7]; dot += term; }
    { precise double term = double(wellDepth) * tab.t[145 + 8]; dot += term; }
    { precise double term = double(extraWells) * tab.t[145 + 9]; dot += term; }
    { precise double term = double(tslot) * tab.t[145 + 10]; dot += term; }
    double b2bState = (tab.t[171] != 0.0lf && dchain >= 1) ? tab.t[171] : 0.0lf;
    precise double br = dot;
    br += b2bState;
    br += 0.0lf;
    br += 0.0lf;
    br += phi;
    br -= 0.0lf;
    precise double sd = sScale * tab.t[168];
    precise double value = accumulated + sd * br;

    // ---- K (production ord_key, verbatim from stage-2B) ----
    uvec2 vb = unpackDouble2x32(value);
    uint64_t vbits;
    if (value == 0.0lf) vbits = 0ul;
    else vbits = (uint64_t(vb.y) << 32) | uint64_t(vb.x);
    uint64_t ord = (vbits >> 63) != 0ul ? ~vbits : (vbits | 0x8000000000000000ul);
    uint64_t keyK = ~ord;

    // ---- write back (words 4-9; preserve feature words in q2.zw) ----
    uvec2 ab = unpackDouble2x32(accumulated);
    rec.q[rb + 1u] = uvec4(vb.x, vb.y, ab.x, ab.y);
    rec.q[rb + 2u] = uvec4(uint(keyK & 0xFFFFFFFFul), uint(keyK >> 32), q2.z, q2.w);
}

void passBStage(uint ply) {
  uint cn = state.u[STATS + ST_CN];
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint si = tid; si < cn; si += tt) passBOne(si);
}

// ---- judgePrePX (round-2 B): the EVLIST build of canonical
// judgeStage, distributed over all WGs with ZERO added grid
// barriers (the bk sequence is unchanged). Phase 1 (per-WG EVALCH
// counts) rides the A_r->B_r window: EVALCH membership is final
// before A_r (prefixAndChunk), only the value bits wait for B_r.
// Phase 2 (the build) rides the B_r->C_r window; each WG's start
// offset is a redundant sum of JP_CNT[<wg] (no rendezvous), blocks
// concatenate in wg order, and inside a block slots are assigned by
// the same shared-atomic wave mechanism as canonical, so EVLIST
// comes out coff-ascending, byte-identical to canonical's order.
// WG0's tau half then waits on the one-way JP_DONE counter (same
// spin/error machinery as gbar, but not a gbar). Scratch: TABMETA
// head (dead after dedupe; the jpx variant drill-passed JP_CNT in
// the same place). ----
#define JP_CNT  (TABMETA)
#define JP_DONE (TABMETA + 128u)

void judgeBlock(uint nch, uint wg, out uint blo, out uint bhi) {
  uint base = nch / g_nwg, rem = nch % g_nwg;
  blo = wg * base + min(wg, rem);
  bhi = blo + base + (wg < rem ? 1u : 0u);
}

void judgePreCount(uint ply) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint nch = plyNch(ply);
  uint blo, bhi;
  judgeBlock(nch, wg, blo, bhi);
  if (lane == 0u) j_cnt = 0u;
  barrier();
  uint mine = 0u;
  for (uint coff = blo + lane; coff < bhi; coff += 64u)
    if (state.u[EVALCH + coff] != 0u) mine++;
  if (mine != 0u) atomicAdd(j_cnt, mine);
  barrier();
  if (lane == 0u) state.u[JP_CNT + wg] = j_cnt;
  if (wg == 0u && lane == 0u) {
    mmv.v[0] = 0xFFFFFFFFFFFFFFFFul;
    mmv.v[1] = 0ul;
    state.u[JP_DONE] = 0u;
    state.u[STATS + ST_EVGEN] += 1u;
  }
  barrier();
}

void judgeBuildPX2(uint ply) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint blo, bhi;
  judgeBlock(nch, wg, blo, bhi);
  uint off = 0u;
  for (uint w = 0u; w < wg; w++) off += state.u[JP_CNT + w];
  if (lane == 0u) j_cnt = 0u;
  barrier();
  for (uint coff = blo + lane; coff < bhi; coff += 64u) {
    if (state.u[EVALCH + coff] == 0u) continue;
    uint child = childBase + coff;
    uint s = off + atomicAdd(j_cnt, 1u);
    state.u[EVLIST + 2u * s] = child;
    state.u[EVLIST + 2u * s + 1u] = coff;
    uint64_t vb = recValBits(child);
    uint64_t k = ordOfBits(vb);
    state.u[EVORD + 2u * s] = uint(k);
    state.u[EVORD + 2u * s + 1u] = uint(k >> 32);
    atomicMin(mmv.v[0], k);
    atomicMax(mmv.v[1], k);
  }
  barrier();
  if (lane == 0u) {
    memoryBarrierBuffer();
    atomicAdd(state.u[JP_DONE], 1u);
  }
}

// ---- B&B judge, tau half (WG 0): selg's host loop, on device ----
// Computes tau from the evaluated set (built by judgeBuildPX2),
// applies selg's stop rule against the next unevaluated
// representative captured by this round's prefix-P. c_cnt (dead in
// this window; prefixAndChunk resets it next round) carries the
// JP_DONE spin-error flag across the WG barrier.
bool judgeTauStage(uint ply) {
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  if (lane == 0u) {
    j_nextOrd = (uint64_t(state.u[STATS + ST_NKEYHI]) << 32) | uint64_t(state.u[STATS + ST_NKEYLO]);
    j_nextIdx = state.u[STATS + ST_NIDX];
    j_hasNext = state.u[STATS + ST_HASNEXT];
    c_cnt = 0u;
    uint s = 0u;
    while (state.u[JP_DONE] < g_nwg) {
      if (atomicOr(ctrl.u[30u], 0u) != 0u) { c_cnt = 1u; break; }
      if (++s > g_spin) {
        atomicOr(ctrl.u[30u], 1u);
        atomicOr(ctrl.u[1u], 1u);
        c_cnt = 1u;
        break;
      }
    }
    memoryBarrierBuffer();
  }
  barrier();
  if (c_cnt != 0u) return true;
  uint nEval = state.u[STATS + ST_NEVAL];
  uint nReps = state.u[STATS + ST_NREPS];
  if (lane == 0u) state.u[STATS + ST_ROUNDS] += 1u;
  bool stop = false;
  if (nEval >= nReps) {
    stop = true;
  } else if (nEval >= 96u) {
    uint64_t tauBits;
    uint tauCoff;
    uint64_t tauOrd;
    if (nEval <= 96u) {
      uint64_t bestK = 0xFFFFFFFFFFFFFFFFul;
      uint bestI = 0u;
      for (uint i = 0u; i < nEval; i++) {
        uint64_t k = selKeyOf(EVORD, i);
        if (k < bestK || (k == bestK && i > bestI)) { bestK = k; bestI = i; }
      }
      tauOrd = bestK;
      tauCoff = state.u[EVLIST + 2u * bestI + 1u];
      tauBits = recValBits(state.u[EVLIST + 2u * bestI]);
    } else {
      prefixP(EVORD, nEval, 96u, true, mmv.v[0], mmv.v[1]);
      uint ti = p_tauIdx;
      tauOrd = p_T;
      tauCoff = state.u[EVLIST + 2u * ti + 1u];
      tauBits = recValBits(state.u[EVLIST + 2u * ti]);
    }
    if (lane == 0u) {
      state.u[STATS + ST_TAULO] = uint(tauBits);
      state.u[STATS + ST_TAUHI] = uint(tauBits >> 32);
      state.u[STATS + ST_TAUCOFF] = tauCoff;
    }
    if (j_hasNext == 0u) {
      stop = true;
    } else {
      uint nextCoff = state.u[REPSGEN + j_nextIdx] - childBase;
      if (j_nextOrd < tauOrd) stop = true;
      else if (j_nextOrd == tauOrd) stop = (nextCoff > tauCoff);
      else stop = false;
    }
  }
  if (lane == 0u) state.u[STATS + ST_STOP] = stop ? 1u : 0u;
  barrier();
  return false;
}

// PROBE r3bt1 helpers: comparator identical to the LDS bitonic
// (key descending, orderPk ascending on ties).
bool btPrecedes(uint akh, uint akl, uint aord, uint bkh, uint bkl, uint bord) {
  if (akh != bkh) return akh > bkh;
  if (akl != bkl) return akl > bkl;
  return aord < bord;
}
// ---- final sort (WG 0): sel_sort3 form over the eval cache ----
void sortStage(uint ply) {
  uint lane = gl_LocalInvocationIndex;
  uint nEval = state.u[STATS + ST_NEVAL];
  uint keep = min(nEval, 96u);
  if (nEval > 96u) {
    prefixP(EVORD, nEval, 96u, true, mmv.v[0], mmv.v[1]);
    for (uint i = lane; i < 96u; i += 64u) {
      uint src = state.u[PFXIDX + i];
      selKeySet(i, selKeyOf(EVORD, src));
      sOrderPk[i] = state.u[EVLIST + 2u * src + 1u];
      sFitW[i] = state.u[EVLIST + 2u * src];
    }
  } else {
    for (uint i = lane; i < nEval; i += 64u) {
      selKeySet(i, selKeyOf(EVORD, i));
      sOrderPk[i] = state.u[EVLIST + 2u * i + 1u];
      sFitW[i] = state.u[EVLIST + 2u * i];
    }
  }
  for (uint i = keep + lane; i < 128u; i += 64u) {
    selKeySet(i, 0ul);
    sOrderPk[i] = 0xFFFFFFFFu;
    sFitW[i] = 0u;
  }
  barrier();
  // PROBE r3bt1: register + subgroup-shuffle bitonic. Same (k, j)
  // network and comparator as the LDS form. For pair (i, i^j) with
  // i the low index, the "first" element goes to the low position
  // iff ((i & k) == 0). ea = element lane, eb = element lane + 64.
  uint bkhA, bklA, boA, bfA, bkhB, bklB, boB, bfB;
  {
    uint64_t k0 = selKeyGet(lane);
    bkhA = uint(k0 >> 32); bklA = uint(k0); boA = sOrderPk[lane]; bfA = sFitW[lane];
    uint64_t k1 = selKeyGet(lane + 64u);
    bkhB = uint(k1 >> 32); bklB = uint(k1); boB = sOrderPk[lane + 64u]; bfB = sFitW[lane + 64u];
  }
  for (uint k = 2u; k <= 128u; k <<= 1) {
    for (uint j = k >> 1; j > 0u; j >>= 1) {
      if (j == 64u) {
        bool up = ((lane & k) == 0u);
        bool aFirst = btPrecedes(bkhA, bklA, boA, bkhB, bklB, boB);
        if (aFirst != up) {
          uint t;
          t = bkhA; bkhA = bkhB; bkhB = t;
          t = bklA; bklA = bklB; bklB = t;
          t = boA; boA = boB; boB = t;
          t = bfA; bfA = bfB; bfB = t;
        }
      } else if (j == 32u && gl_SubgroupSize < 64u) {
        selKeySet(lane, packUint2x32(uvec2(bklA, bkhA)));
        sOrderPk[lane] = boA; sFitW[lane] = bfA;
        selKeySet(lane + 64u, packUint2x32(uvec2(bklB, bkhB)));
        sOrderPk[lane + 64u] = boB; sFitW[lane + 64u] = bfB;
        barrier();
        {
          uint pl = lane ^ 32u;
          uint64_t pk = selKeyGet(pl);
          uint pkh = uint(pk >> 32), pkl = uint(pk);
          uint po = sOrderPk[pl], pf = sFitW[pl];
          bool up = (((lane & ~32u) & k) == 0u);
          bool isLow = ((lane & 32u) == 0u);
          bool mineFirst = btPrecedes(bkhA, bklA, boA, pkh, pkl, po);
          if (mineFirst != (up == isLow)) { bkhA = pkh; bklA = pkl; boA = po; bfA = pf; }
        }
        {
          uint idx = lane + 64u;
          uint pl = idx ^ 32u;
          uint64_t pk = selKeyGet(pl);
          uint pkh = uint(pk >> 32), pkl = uint(pk);
          uint po = sOrderPk[pl], pf = sFitW[pl];
          bool up = (((idx & ~32u) & k) == 0u);
          bool isLow = ((idx & 32u) == 0u);
          bool mineFirst = btPrecedes(bkhB, bklB, boB, pkh, pkl, po);
          if (mineFirst != (up == isLow)) { bkhB = pkh; bklB = pkl; boB = po; bfB = pf; }
        }
      } else {
        {
          uint pkh = subgroupShuffleXor(bkhA, j);
          uint pkl = subgroupShuffleXor(bklA, j);
          uint po = subgroupShuffleXor(boA, j);
          uint pf = subgroupShuffleXor(bfA, j);
          bool up = (((lane & ~j) & k) == 0u);
          bool isLow = ((lane & j) == 0u);
          bool mineFirst = btPrecedes(bkhA, bklA, boA, pkh, pkl, po);
          if (mineFirst != (up == isLow)) { bkhA = pkh; bklA = pkl; boA = po; bfA = pf; }
        }
        {
          uint pkh = subgroupShuffleXor(bkhB, j);
          uint pkl = subgroupShuffleXor(bklB, j);
          uint po = subgroupShuffleXor(boB, j);
          uint pf = subgroupShuffleXor(bfB, j);
          uint idx = lane + 64u;
          bool up = (((idx & ~j) & k) == 0u);
          bool isLow = ((idx & j) == 0u);
          bool mineFirst = btPrecedes(bkhB, bklB, boB, pkh, pkl, po);
          if (mineFirst != (up == isLow)) { bkhB = pkh; bklB = pkl; boB = po; bfB = pf; }
        }
      }
    }
  }
  selKeySet(lane, packUint2x32(uvec2(bklA, bkhA)));
  sOrderPk[lane] = boA; sFitW[lane] = bfA;
  selKeySet(lane + 64u, packUint2x32(uvec2(bklB, bkhB)));
  sOrderPk[lane + 64u] = boB; sFitW[lane + 64u] = bfB;
  barrier();
  for (uint i = lane; i < keep; i += 64u) state.u[SELB + i] = sFitW[i];
  barrier();
  if (lane == 0u) {
    state.u[STATS + ST_NSEL] = keep;
    h_nAlive = state.u[STATS + ST_NALIVE];
    h_nReps = state.u[STATS + ST_NREPS];
    h_nSel = keep;
    h_nEval = nEval;
    h_rounds = state.u[STATS + ST_ROUNDS];
  }
  barrier();
}

// ---- S4a: materialization (sel_mat form, global gout stride 30) ----
void matStage(uint ply) {
  uint nSel = state.u[STATS + ST_NSEL];
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint idx = tid; idx < nSel; idx += tt) {
    uint child = state.u[SELB + idx];
    surv.w[OSEL + ply * 96u + idx] = child;
    uint rb = child * 16u;
    uint ii = recw.w[rb + 15u];
    uint i48 = ii * 48u;
    uint ob = OARENA + ply * 4224u + idx * 44u;
    uint loc = child * 30u;
    for (uint i = 0u; i < 30u; i++) surv.w[ob + i] = gout.w[loc + i];
    surv.w[ob + 30u] = inst48.w[i48 + 5u];
    surv.w[ob + 31u] = inst48.w[i48 + 6u];
    uint scB = recw.w[rb + 14u];
    surv.w[ob + 32u] = (scB >> 6) & 0xFFu;
    surv.w[ob + 33u] = uint(int(scB & 63u) - 1);
    surv.w[ob + 34u] = (scB >> 14) & 63u;
    surv.w[ob + 35u] = recw.w[rb + 4u];
    surv.w[ob + 36u] = recw.w[rb + 5u];
    surv.w[ob + 37u] = ii;
    surv.w[ob + 38u] = child;
    for (uint i = 39u; i < 44u; i++) surv.w[ob + i] = 0u;
  }
}

// ---- S1: BPX-L over this ply's instances (strided by workgroup) ----
shared uint sTick;
void stageS1(uint ply) {
  pc.childBase = plyCB(ply);
  pc.tauLo = uni.u[16u + ply * 8u + 4u];
  pc.tauHi = uni.u[16u + ply * 8u + 5u];
  pc.tauPos = uni.u[16u + ply * 8u + 6u];
  pc.survBase = OSURV + ply * 8192u;
  pc.base = 0u;
  pc.n = 0u;
  pc.reserved = 0u;
  uint i0 = plyI0(ply);
  uint ni = plyNi(ply);
  uint lane = gl_LocalInvocationIndex;
  // r4tk1: dynamic ticket assignment (STATS+40, zeroed by
  // resetScratch, published by the B0/B4 gbar). Replaces the
  // strided loop so the B1 rendezvous is priced by total
  // work, not by the unluckiest WG's strided draw.
  for (;;) {
    if (lane == 0u) sTick = atomicAdd(state.u[STATS + ST_TICKET], 1u);
    barrier();
    uint inst = sTick;
    if (inst >= ni) break;
    g_bpxII = i0 + inst;
    bpxMain();
  }
}

// ---- resident main: 3-point basis + selection sync points ----
void main() {
  g_nwg = pcu.nwg;
  g_gsize = pcu.gsize;
  g_flags = pcu.flags;
  g_spin = pcu.spin;
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint nPlies = uni.u[0];
  resetScratch();
  uint bk = 0u;
  if (gbar(bk++)) return; // B0
  for (uint ply = 0u; ply < nPlies; ply++) {
    stageS1(ply);
    if (gbar(bk++)) return; // B1
    if (wg == 0u && lane == 0u) h_nSurv = survCnt.w[0];
    dedupeA(ply);
    if (gbar(bk++)) return; // B2 = dedupe barrier 1
    dedupeB(ply);
    if (gbar(bk++)) return; // X1 = dedupe barrier 2
    if (emitOrderPX(ply, bk)) return;
    if (gbar(bk++)) return; // X2
    cacheStage(ply);
    if (gbar(bk++)) return; // X3
    uint nReps = state.u[STATS + ST_NREPS];
    if (nReps > 0u) {
      uint b = 256u;
      for (uint r = 0u; r < 24u; r++) {
        uint bcur = min(b, nReps);
        if (wg == 0u) prefixAndChunk(ply, bcur);
        if (gbar(bk++)) return; // A_r
        judgePreCount(ply);
        passBStage(ply);
        if (gbar(bk++)) return; // B_r
        judgeBuildPX2(ply);
        if (wg == 0u) { if (judgeTauStage(ply)) return; }
        if (gbar(bk++)) return; // C_r
        if (state.u[STATS + ST_STOP] != 0u) break;
        b *= 2u;
      }
      if (wg == 0u) sortStage(ply);
    } else {
      if (wg == 0u && lane == 0u) {
        h_nAlive = 0u;
        h_nReps = 0u;
        h_nSel = 0u;
        h_nEval = 0u;
        h_rounds = 0u;
      }
    }
    if (gbar(bk++)) return; // X5
    matStage(ply);
    if (wg == 0u && lane == 0u) {
      uint hb = OHEAD + ply * 16u;
      surv.w[hb + 0u] = h_nAlive;
      surv.w[hb + 1u] = h_nReps;
      surv.w[hb + 2u] = h_nSel;
      surv.w[hb + 3u] = h_nEval;
      surv.w[hb + 4u] = h_rounds;
      surv.w[hb + 5u] = h_nSurv;
      surv.w[hb + 6u] = plyCB(ply);
      surv.w[hb + 7u] = plyNch(ply);
      surv.w[hb + 8u] = uni.u[16u + ply * 8u + 7u];
      for (uint i = 9u; i < 16u; i++) surv.w[hb + i] = 0u;
    }
    resetScratch();
    if (ply + 1u < nPlies) {
      if (gbar(bk++)) return; // B4
    }
  }
  if (gbar(bk++)) return; // publication
  if (wg == 0u && lane == 0u) {
    ctrl.u[3u] = state.u[SELB];
    ctrl.u[4u] = nPlies;
    memoryBarrierBuffer();
    ctrl.u[0u] = 1u;
  }
}
