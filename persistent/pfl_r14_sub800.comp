// ---- grid3 barrier (skeleton pfx_common.glsl, verbatim) ----
bool gbar(uint k) {
  memoryBarrierBuffer(); barrier();
  if (gl_LocalInvocationIndex == 0u) {
    bool skipArrive = (g_flags & 1u) != 0u && k == 1u && gl_WorkGroupID.x == 0u;
    if (!skipArrive) {
      uint grp = gl_WorkGroupID.x / g_gsize;
      uint v = atomicAdd(ctrl.u[16u + grp], 1u);
      if ((v + 1u) % g_gsize == 0u) {
        uint rv = atomicAdd(ctrl.u[28u], 1u);
        if ((rv + 1u) % 12u == 0u) atomicAdd(ctrl.u[64u], 1u);
      }
    }
    uint s = 0u;
    while (ctrl.u[64u] <= k) {
      if (ctrl.u[128u] != 0u) break;
      if (++s > (g_spin << 3)) { atomicOr(ctrl.u[128u], 1u); atomicOr(ctrl.u[1u], 1u); break; }
    }
  }
  barrier(); memoryBarrierBuffer(); barrier();
  return ctrl.u[128u] != 0u;
}

// ---- selection shared state (aliases onto BPX shared, dead in S3) ----
// Defined after the BPX section (pool/sF/sFpre/sOrderPk/sFitW live
// there); the selection bodies appear after it too. Only the small
// scalars and the emit/order scan arrays are declared here.
shared uint wg_tmp[4];

uint wg64InclusiveAdd(uint v) {
  uint inc = subgroupInclusiveAdd(v);
  if (gl_SubgroupSize < 64u) {
    if (gl_LocalInvocationIndex == 31u) wg_tmp[0] = inc;
    barrier();
    if (gl_LocalInvocationIndex >= 32u) inc += wg_tmp[0];
    barrier();
  }
  return inc;
}
uint wg64ExclusiveAdd(uint v) { return wg64InclusiveAdd(v) - v; }
uint wg64Add(uint v) {
  uint s = subgroupAdd(v);
  if (gl_SubgroupSize < 64u) {
    if (gl_LocalInvocationIndex == 0u) wg_tmp[0] = s;
    if (gl_LocalInvocationIndex == 32u) wg_tmp[1] = s;
    barrier();
    s = wg_tmp[0] + wg_tmp[1];
    barrier();
  }
  return s;
}
int wg64AddI(int v) { return int(wg64Add(uint(v))); }
uint wg64Min(uint v) {
  uint m = subgroupMin(v);
  if (gl_SubgroupSize < 64u) {
    if (gl_LocalInvocationIndex == 0u) wg_tmp[0] = m;
    if (gl_LocalInvocationIndex == 32u) wg_tmp[1] = m;
    barrier();
    m = min(wg_tmp[0], wg_tmp[1]);
    barrier();
  }
  return m;
}
uint64_t wg64Ballot(bool p) {
  uvec4 b = subgroupBallot(p);
  if (gl_SubgroupSize < 64u) {
    if (gl_LocalInvocationIndex == 0u) wg_tmp[0] = b.x;
    if (gl_LocalInvocationIndex == 32u) wg_tmp[1] = b.x;
    barrier();
    uint lo = wg_tmp[0], hi = wg_tmp[1];
    barrier();
    return packUint2x32(uvec2(lo, hi));
  }
  return packUint2x32(b.xy);
}
// wg64Broadcast removed (unused in r13; avoids NVVM non-constant subgroupBroadcast)


// ---- record helpers (selection side) ----
uint64_t ordOfBits(uint64_t bits) { return (bits >> 63) != 0ul ? ~bits : (bits | 0x8000000000000000ul); }
uint64_t recOrdU(uint child) {
  uint64_t bits = (uint64_t(recw.w[child * 16u + 3u]) << 32) | uint64_t(recw.w[child * 16u + 2u]);
  return ordOfBits(bits);
}
uint64_t recValBits(uint child) {
  return (uint64_t(recw.w[child * 16u + 5u]) << 32) | uint64_t(recw.w[child * 16u + 4u]);
}
bool childDead(uint child) { return ((recw.w[child * 16u + 13u] >> 8) & 1u) != 0u; }
uint64_t sm64(uint64_t x) {
  x ^= x >> 30; x *= 0xBF58476D1CE4E5B9ul;
  x ^= x >> 27; x *= 0x94D049BB133111EBul;
  x ^= x >> 31; return x;
}
#define EMPTY64 0xFFFFFFFFFFFFFFFFul

uint plyI0(uint ply)   { return uni.u[16u + ply * 8u + 0u]; }
uint plyNi(uint ply)   { return uni.u[16u + ply * 8u + 1u]; }
uint plyCB(uint ply)   { return uni.u[16u + ply * 8u + 2u]; }
uint plyNch(uint ply)  { return uni.u[16u + ply * 8u + 3u]; }

// Scratch reset for the coming ply: dedupe tables, eval flags, stats,
// min/max, BPX survivor counter. Runs in init and in S4 (the design's
// rearm position); never in S3's tail after a read.
void resetScratchFull() {
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint i = tid; i < 16384u; i += tt) {
    tabfp.v[i] = EMPTY64;
    tabord.v[i] = 0ul;
  }
  for (uint i = tid; i < 4032u; i += tt) state.u[PB_HIST + i] = 0u;
  for (uint i = tid; i < 64u; i += tt) state.u[STATS + i] = (i == ST_TICKET) ? g_nwg : 0u;
  if (tid == 0u) {
    state.u[SURVCNT_OFF] = 0u;
  }
}
void resetScratchPly(uint ply) {
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  uint nTouch = state.u[STATS + ST_NTOUCH];
  for (uint i = tid; i < nTouch; i += tt) {
    uint slot = state.u[TABMETA + i];
    tabfp.v[slot] = EMPTY64;
    tabord.v[slot] = 0ul;
  }
  for (uint i = tid; i < 4032u; i += tt) state.u[PB_HIST + i] = 0u;
  if (tid == 0u) {
    state.u[STATS + ST_TICKET] = g_nwg;
    state.u[SURVCNT_OFF] = 0u;
  }
}

// ================= BPX-L body (transplanted from bpxl.comp) =========
// Everything from bpxl.comp's shared-state section to the end of its
// main() follows, unmodified except: main() -> bpxMain(), the instance
// selector reads the global g_bpxII, and the early-out guard is gone
// (the S1 wrapper only calls bpxMain for real instances).
// ================= shared state =================
// LDS diet (bpxl): total <= 4096 B for the persistent form's resident
// grid. Phase-disjoint blocks are overlaid, all meaning-preserving:
//  - the BX-phase blocks (placement array PLACE, evaluation stash
//    STASH, local survivor list SURVL) are carved out of pool, which
//    is dead once the BP interval ends;
//  - RREC lives in sFitW, dead after the start adjustment;
//  - the BP occupancy columns (was sOC) live in sF[0..9], dead until
//    the flood loop's first write;
//  - uniform instance scalars (descriptor-derived) are main() locals
//    loaded identically by every lane, not shared; only sLen (read by
//    the occ_p helper), sRtP, sFlagBits and sErr stay shared.
// Parent board rows are kept in the instance's own packing (2 rows /
// word, sRowsPk); rowAt() extracts.
shared uint64_t sF[64];
shared uint pool[448];
shared uint sFitW[128];
// pool map (448 words):
//   flood : rank bytes [0,128) | KEY packed 2x16 [128,256) |
//           KB [256,320) | WP [320,384)
//   spin  : planes [0,384) (ldPl/stPl indexing, unchanged)
//   emit  : spin [0,384) read | POSPKW [384,448)
//   BX    : PLACE [0,64) | SURVL [64,128) | STASH [128,448)
#define KB(w) pool[256u + (w)]
#define WP(w) pool[320u + (w)]
#define POSPKW(w) pool[384u + (w)]
#define RREC(i) sFitW[(i)]
#define PLACE(i) pool[(i)]
#define STASH(i) pool[128u + (i)]
#define SURVL(i) pool[64u + (i)]
// KEY values are rank*8+move <= 2047 (11 bits): two per word, written
// with atomicOr onto words zeroed at the top of each flood iteration.
// sFitW doubles as the fit array (u64 view via pack/unpack) during the
// BP interval and as RREC (uint view) during emission.
uint64_t fitGet(uint i) { return packUint2x32(uvec2(sFitW[i * 2u], sFitW[i * 2u + 1u])); }
void fitSet(uint i, uint64_t v) { uvec2 u = unpackUint2x32(v); sFitW[i * 2u] = u.x; sFitW[i * 2u + 1u] = u.y; }
const uint TWINPK[7] = uint[7](0x04525A0Bu, 0x050A1428u, 0x050A1428u, 0x04525A0Bu, 0x04525A0Bu, 0x050A1428u, 0x050A1428u);
#define RANK(c, i) rankGet(c, i)
uint64_t g_srcPkA, g_srcPkB, g_dyPk;
int srcOf(int k) { uint64_t pk = k < 9 ? g_srcPkA : g_srcPkB; return int((pk >> uint((k < 9 ? k : k - 9) * 7)) & 0x7Ful) - 1; }
int dyOf(int k) { return int((g_dyPk >> uint(k * 4)) & 0xFu) - 4; }
uint64_t ldPl(uint p, uint l) { return packUint2x32(uvec2(pool[(p * 64u + l) * 2u], pool[(p * 64u + l) * 2u + 1u])); }
void stPl(uint p, uint l, uint64_t v) { uvec2 u = unpackUint2x32(v); pool[(p * 64u + l) * 2u] = u.x; pool[(p * 64u + l) * 2u + 1u] = u.y; }


uint popc64(uint64_t m) { uvec2 v = unpackUint2x32(m); return uint(bitCount(v.x) + bitCount(v.y)); }
int lsb64(uint64_t m) {
    uint lo = uint(m);
    if (lo != 0u) return findLSB(lo);
    return 32 + findLSB(uint(m >> 32));
}
uint64_t below(uint y) { return y == 0u ? 0ul : ((1ul << y) - 1ul); }
uint64_t shl(uint64_t m, int s) { return s >= 0 ? (s >= 64 ? 0ul : m << uint(s)) : (-s >= 64 ? 0ul : m >> uint(-s)); }
// PORTS HP1: branchless kick shift (BPX-SPEED4 S1). Bit-identical
// to shl() for |s| < 64; all kick shift amounts are KY-derived
// and lie in [-2, 2].
uint64_t shlS(uint64_t m, int s) { return (m << uint(max(s, 0))) >> uint(max(-s, 0)); }
// PORTS HP2: folded shift (BPX-SPEED5 V2 / BPX-SPEED6 W1).
// shlK(x, dy) == shlS(x, -dy) for x < 2^44; cand/spin inputs
// sF[sk] & M[k] are fit-bounded (see BPX-SPEED5 section 8).
uint64_t shlK(uint64_t m, int dy) { return (m << 2) >> uint(2 + dy); }
bool bit(uint64_t m, int y) { return y >= 0 && y < 64 && ((m >> uint(y)) & 1ul) != 0ul; }

// ================= BX helpers (verbatim from bxp_a / bxp_b) =================
float tabf(int i) { return uintBitsToFloat(state.u[EVALCH + uint(i)]); }
float ln1p125(int c) { return tabf(c); }
float clip6(int n) { return tabf(129 + clamp(n, 0, 6)); }
float clip8(int n) { return tabf(136 + clamp(n, 0, 8)); }

int s2surge(int d) { return d >= 5 ? d - 1 : 0; }
float combo_raw(float base, int combo) {
    int c = max(combo, 0);
    float grown = base * (1.0 + 0.25 * float(c));
    float ft = c >= 2 ? ln1p125(c) : 0.0;
    return max(grown, ft);
}

uint64_t below64(uint k) { return k >= 64u ? ~0ul : ((1ul << k) - 1ul); }
int pop64(uint64_t m) { return bitCount(uint(m)) + bitCount(uint(m >> 32)); }
int height_of(uint64_t c) {
    if (c == 0ul) return 0;
    uint hi = uint(c >> 32);
    if (hi != 0u) return 32 + findMSB(hi) + 1;
    return findMSB(uint(c)) + 1;
}
uint64_t delete_level(uint64_t m, uint p) {
    uint64_t b = below64(p);
    return (m & b) | ((m >> 1) & ~b);
}
int rt_of(uint bits) {
    if (bits == 0u) return 0;
    uint w = ((bits << 1) | 1u | (1u << 11));
    return bitCount((w ^ (w >> 1)) & 2047u);
}
uint row_mask10(uint64_t c0, uint64_t c1, uint64_t c2, uint64_t c3, uint64_t c4,
                uint64_t c5, uint64_t c6, uint64_t c7, uint64_t c8, uint64_t c9, uint level) {
    uint m = 0u;
    m |= uint((c0 >> level) & 1ul);
    m |= uint((c1 >> level) & 1ul) << 1;
    m |= uint((c2 >> level) & 1ul) << 2;
    m |= uint((c3 >> level) & 1ul) << 3;
    m |= uint((c4 >> level) & 1ul) << 4;
    m |= uint((c5 >> level) & 1ul) << 5;
    m |= uint((c6 >> level) & 1ul) << 6;
    m |= uint((c7 >> level) & 1ul) << 7;
    m |= uint((c8 >> level) & 1ul) << 8;
    m |= uint((c9 >> level) & 1ul) << 9;
    return m;
}

// r6bh1: 8x8 bit-matrix transpose in a u64 (masked swaps;
// masks derived and verified in gen_r6b.py).

uint colByte8(uint64_t c, int sh) {
    return sh >= 0 ? uint((c >> uint(sh)) & 0xFFul) : uint((c << uint(-sh)) & 0xFFul);
}

uint64_t transpose8x8(uint64_t x) {
    x = (x & 0xAA55AA55AA55AA55ul) | ((x & 0x00AA00AA00AA00AAul) << 7u) | ((x & 0x5500550055005500ul) >> 7u);
    x = (x & 0xCCCC3333CCCC3333ul) | ((x & 0x0000CCCC0000CCCCul) << 14u) | ((x & 0x3333000033330000ul) >> 14u);
    x = (x & 0xF0F0F0F00F0F0F0Ful) | ((x & 0x00000000F0F0F0F0ul) << 28u) | ((x & 0x0F0F0F0F00000000ul) >> 28u);
    return x;
}

uint vget4(uvec4 v, int i) { return i == 0 ? v.x : (i == 1 ? v.y : (i == 2 ? v.z : v.w)); }

uint rowAt_g(uint ib, int row) {
    return (inst.w[ib + 7u + uint(row >> 1)] >> ((row & 1) * 16)) & 0xFFFFu;
}
bool occ_p_g(uint ib, int len, int x, int y) {
    if (x < 0 || x >= 10 || y >= len) return true;
    if (y >= 0 && (rowAt_g(ib, y) & (1u << uint(x))) != 0u) return true;
    return false;
}
bool collides_p_g(uint ib, int len, int kind, int rot, int x, int y) {
    uint si = uint(kind) * 4u + uint(rot & 3);
    ivec4 hd = SHAPE_HDR[si];
    uvec4 rw = SHAPE_ROWS[si];
    if (x + hd.x < 0 || x + hd.y >= 10) return true;
    uint shift = uint(x + hd.x);
    for (int i = 0; i < hd.w; i++) {
        int row = y + hd.z + i;
        if (row >= len) return true;
        if (row >= 0 && (rowAt_g(ib, row) & (vget4(rw, i) << shift)) != 0u) return true;
    }
    return false;
}
int classify_spin_g(uint ib, int len, int kind, int rot, int px, int py, int srs) {
    if (srs == 0) return 0;
    if (kind == 2) {
        bool f0 = occ_p_g(ib, len, px, py);
        bool f1 = occ_p_g(ib, len, px + 2, py);
        bool f2 = occ_p_g(ib, len, px + 2, py + 2);
        bool f3 = occ_p_g(ib, len, px, py + 2);
        int cnt = (f0 ? 1 : 0) + (f1 ? 1 : 0) + (f2 ? 1 : 0) + (f3 ? 1 : 0);
        if (cnt >= 3) {
            int r = rot & 3;
            bool a = r == 0 ? f0 : (r == 1 ? f1 : (r == 2 ? f2 : f3));
            int r1 = (r + 1) & 3;
            bool b = r1 == 0 ? f0 : (r1 == 1 ? f1 : (r1 == 2 ? f2 : f3));
            return (a && b) || srs == 5 ? 2 : 1;
        }
    }
    bool imm = collides_p_g(ib, len, kind, rot, px - 1, py) && collides_p_g(ib, len, kind, rot, px + 1, py)
        && collides_p_g(ib, len, kind, rot, px, py - 1) && collides_p_g(ib, len, kind, rot, px, py + 1);
    return imm ? 1 : 0;
}

int height_of32(uint c) { return c == 0u ? 0 : findMSB(c) + 1; }
uint row_mask10_32(uint c0, uint c1, uint c2, uint c3, uint c4,
                   uint c5, uint c6, uint c7, uint c8, uint c9, uint level) {
    return ((c0 >> level) & 1u)
         | (((c1 >> level) & 1u) << 1)
         | (((c2 >> level) & 1u) << 2)
         | (((c3 >> level) & 1u) << 3)
         | (((c4 >> level) & 1u) << 4)
         | (((c5 >> level) & 1u) << 5)
         | (((c6 >> level) & 1u) << 6)
         | (((c7 >> level) & 1u) << 7)
         | (((c8 >> level) & 1u) << 8)
         | (((c9 >> level) & 1u) << 9);
}
int hole_cover_col_m32(uint c, int m) {
    if (m == 0) return 0;
