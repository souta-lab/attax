// PERSISTENT LOAD-IN — resident kernel with the real stage bodies:
//   S1 = BPX-L (bpxl.comp, LDS 4,096 B form) transplanted verbatim
//        (shared-state section + helpers + main body as bpxMain();
//        only the instance selector and the pc block became globals),
//   S2 = selection dedupe phase A (rec_dedup_m form, child-direct),
//   S3 = dedupe B + emit/order + repsOrd cache + B&B rounds
//        (prefix-P = sel_prefix4 algorithm at 64 lanes, passB =
//        bxp_b body, judge on WG 0) + final sort (sel_sort3 form),
//   S4 = materialization (sel_mat form) + next-ply scratch reset.
// Sync: skeleton grid3 barriers, 3-point basis (B1/B2/B4) with the
// dedupe barriers folded onto B2 + one extra (X1); selection-internal
// transitions X2/X3/X5 and 3 per B&B round. Contracts per
// PERSISTENT-IMPL section 6: all inter-stage buffers coherent;
// dedupe refill (scratch reset) lives in S4/init, never in S3's tail
// after the last read; anomaly = timeout flag -> whole grid exits ->
// host recomputes the decision in the basic form.
#version 460
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "tables.glsl"
#include "bx_shapes.glsl"

// ---- merged binding map ----
//  0 ctrl (skeleton layout)   1 uni (decision header + ply table)
//  2 inst (BPX 52-word)       3 inst48 (passB/mat 48-word)
//  4 plcin (passB placements) 5 tab (180 doubles)
//  6 rec (records, uvec4)     7 state (scratch, u32)
//  8 surv (outbuf; BPX survivor view)  9 gout (stride-30 boards)
// 10 status (BPX status)     11 plc (BPX plc byproduct out)
// 12 survCnt (state view)    13 tabfp (state u64 view, offset 0)
// 14 tabord (state u64 view) 15 mmu (state u64 view)
// 16 mmv (state u64 view)    17 chunkb (state view, passB list)
// 18 recw (records, u32 view)
layout(std430, binding = 0) volatile coherent buffer Ctrl { uint u[]; } ctrl;
layout(std430, binding = 1) readonly buffer Uni { uint u[]; } uni;
layout(std430, binding = 2) readonly buffer Inst { uint w[]; } inst;
layout(std430, binding = 3) readonly buffer Inst48 { uint w[]; } inst48;
layout(std430, binding = 4) readonly buffer PlcIn { uint w[]; } plcin;
layout(std430, binding = 5) readonly buffer Tables { double t[]; } tab;
layout(std430, binding = 6) coherent buffer Rec { uvec4 q[]; } rec;
layout(std430, binding = 7) coherent buffer Sta { uint u[]; } state;
layout(std430, binding = 8) buffer Surv { uint w[]; } surv;
layout(std430, binding = 9) readonly buffer Gout { uint w[]; } gout;
layout(std430, binding = 10) buffer Status { uint w[]; } status;
layout(std430, binding = 11) buffer Plc { uint w[]; } plc;
layout(std430, binding = 12) coherent buffer SurvCnt { uint w[]; } survCnt;
layout(std430, binding = 13) coherent buffer TabFp { uint64_t v[]; } tabfp;
layout(std430, binding = 14) coherent buffer TabOrd { uint64_t v[]; } tabord;
