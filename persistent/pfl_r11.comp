    // ================= plc byproduct (bxp_a input format) =================
    if (sEmitPlc != 0u && lane < sNChild) {
        uint r = PLACE(lane);
        uint child = sChildOff + lane;
        plc.w[child * 2u] = uint(sKind) | ((r & 3u) << 8) | (((r >> 4) & 0xFFu) << 16) | (((r >> 12) & 0xFFu) << 24);
        plc.w[child * 2u + 1u] = (r >> 20) & 7u;
    }

    if (lane == 0u) status.w[ii] = (sErr & 0xFFu) | ((iters & 0xFFu) << 8) | (sNChild << 16);
}

// ---- S1b: Full-wave BX + Eval + Fused dedupeA (all 4608 threads at 100% lane util!) ----
void stageS1b(uint ply) {
    uint i0 = plyI0(ply);
    uint childBase = plyCB(ply);
    uint nch = plyNch(ply);
    uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    uint tt = g_nwg * 64u;
    for (uint coff = tid; coff < nch; coff += tt) {
        uint child = childBase + coff;
        uint recw2 = state.u[SLOTOF + coff];
        uint instLocal = state.u[REPSGEN + coff];
        uint ii = i0 + instLocal;
        uint ib = ii * 52u;
        int len = int(inst.w[ib + 2u]);
        int kind_b = int(inst.w[ib + 48u] & 0xFFu);
        int rot = int(recw2 & 3u);
        int px = int((recw2 >> 4) & 0xFFu); if (px >= 128) px -= 256;
        int py = int((recw2 >> 12) & 0xFFu); if (py >= 128) py -= 256;
        int srs = int((recw2 >> 20) & 7u);
        uint si = uint(kind_b) * 4u + uint(rot & 3);
        ivec4 hd = SHAPE_HDR[si];
        uvec4 srw = SHAPE_ROWS[si];
        int shift = px + hd.x;

        int spin = classify_spin_g(ib, len, kind_b, rot, px, py, srs);

        uint64_t col[10];
        uint pbase = PSTATE + instLocal * 24u;
        for (int x = 0; x < 10; x++) col[x] = (uint64_t(state.u[pbase + uint(x) * 2u + 1u]) << 32) | uint64_t(state.u[pbase + uint(x) * 2u]);
        for (int i = 0; i < hd.w; i++) {
            int row = py + hd.z + i;
            if (row < 0 || row >= len) continue;
            uint level = uint(len - 1 - row);
            uint bits = vget4(srw, i);
            while (bits != 0u) {
                int b = findLSB(bits);
                int x = shift + b;
                if (x >= 0 && x < 10) col[x] |= 1ul << level;
                bits &= bits - 1u;
            }
        }
        uint64_t full = ~0ul;
        for (int x = 0; x < 10; x++) full &= col[x];
        full &= below64(uint(len));
        int lines = pop64(full);
        uint64_t flb = (uint64_t(state.u[pbase + 22u]) << 32) | uint64_t(state.u[pbase + 21u]);
        int gc = pop64(flb & full);

        // row_transitions, difference form (fixed form, verbatim).
        int rt = int(state.u[pbase + 20u]);
        for (int i = 0; i < hd.w; i++) {
            int row = py + hd.z + i;
            if (row < 0 || row >= len) continue;
            rt -= rt_of(rowAt_g(ib, row));
            rt += rt_of(row_mask10(col[0], col[1], col[2], col[3], col[4], col[5], col[6], col[7], col[8], col[9], uint(len - 1 - row)));
        }

        if (full != 0ul) {
            for (int x = 0; x < 10; x++) {
                uint64_t m = col[x];
                uint64_t f = full;
                int j = 0;
                while (f != 0ul) {
                    int k = lsb64(f);
                    m = delete_level(m, uint(k - j));
                    j += 1;
                    f &= f - 1ul;
                }
                col[x] = m;
            }
            uint64_t m = flb;
            uint64_t f = full;
            int j = 0;
            while (f != 0ul) {
                int k = lsb64(f);
                m = delete_level(m, uint(k - j));
                j += 1;
                f &= f - 1ul;
            }
            flb = m;
        }
        bool pc_ = lines > 0 && col[0] == 0ul && col[1] == 0ul && col[2] == 0ul && col[3] == 0ul && col[4] == 0ul
            && col[5] == 0ul && col[6] == 0ul && col[7] == 0ul && col[8] == 0ul && col[9] == 0ul;
        bool difficult = lines > 0 && (lines == 4 || spin != 0 || pc_);

        int sChain = int(inst.w[ib + 38u]);
        int sPending = int(inst.w[ib + 39u]);
        int combo = lines > 0 ? int(inst.w[ib + 37u]) + 1 : -1;
        int attack = 0;
        int dchain = sChain;
        if (lines > 0) {
            int base;
            int li5 = min(lines, 5);
            if (spin == 2) base = int[6](0, 2, 4, 6, 10, 12)[li5];
            else if (spin == 1) base = int[6](0, 0, 1, 2, 10, 12)[li5];
            else base = int[6](0, 0, 1, 2, 4, 5)[li5];
            if (lines > 5) base += lines - 5;
            int surge = difficult ? 0 : s2surge(sChain);
            precise double raw = combo_raw(double(base) + (difficult && sChain > 0 ? 1.0lf : 0.0lf), combo);
            int sb = (gc > 0 && (spin != 0 || lines >= 4)) ? 1 : 0;
            double sMultL = packDouble2x32(uvec2(inst.w[ib + 44u], inst.w[ib + 45u]));
            precise double a1 = raw * sMultL + double(sb);
            precise double a2 = 5.0lf * sMultL;
            precise double a3 = double(surge) * sMultL;
            attack = int(floor(a1))
                + (pc_ ? int(floor(a2)) : 0)
                + int(floor(a3));
            dchain = difficult ? sChain + 1 : 0;
        }
        int pending, landed;
        if (lines > 0) {
            pending = max(sPending - attack, 0);
            landed = 0;
        } else {
            landed = min(int(inst.w[ib + 1u]) == 0 ? int(inst.w[ib + 40u]) : sPending, sPending);
            pending = sPending - landed;
        }
        if (landed > 0) {
            int l = landed;
            int lmin = min(l, len);
            for (int level = len - lmin; level < len; level++) {
                rt -= rt_of(row_mask10(col[0], col[1], col[2], col[3], col[4], col[5], col[6], col[7], col[8], col[9], uint(level)));
            }
            int hw[10];
            for (int x = 0; x < 10; x++) hw[x] = height_of(col[x]);
            int well = 0;
            for (int x = 1; x < 10; x++) if (hw[x] < hw[well]) well = x;
            uint64_t lm2 = below64(uint(len));
            uint64_t gb = l >= len ? lm2 : below64(uint(l));
            for (int x = 0; x < 10; x++) {
                uint64_t shifted = l >= 64 ? 0ul : ((col[x] << uint(l)) & lm2);
                col[x] = shifted | (x != well ? gb : 0ul);
            }
            flb = (l >= 64 ? 0ul : ((flb << uint(l)) & lm2)) | gb;
            rt += lmin * rt_of(0x3FFu ^ (1u << uint(well)));
        }

        // ---- dedupe hash (packed-key FNV, stream-folded 2-reg form) ----
        int maxh_h = height_of(col[0] | col[1] | col[2] | col[3] | col[4] | col[5] | col[6] | col[7] | col[8] | col[9]);
        uint64_t hh = (uint64_t(0x14650FB0u) << 32) | uint64_t(0x739D0383u);
        uint64_t prime = (uint64_t(0x100u) << 32) | uint64_t(0x000001B3u);
        hh = (hh ^ (uint64_t(inst.w[ib + 5u]) | (uint64_t(inst.w[ib + 6u]) << 32))) * prime;
        hh = (hh ^ (uint64_t(uint(dchain)) | (uint64_t(uint(combo)) << 32))) * prime;
        hh = (hh ^ uint64_t(uint(pending))) * prime;
        hh = (hh ^ flb) * prime;
        uint64_t rpA = 0ul, rpB = 0ul;
        { int sh = len - 8;
          if (sh > -8 && sh < maxh_h) {
            uint pLo = colByte8(col[0], sh) | (colByte8(col[1], sh) << 8u) | (colByte8(col[2], sh) << 16u) | (colByte8(col[3], sh) << 24u);
            uint pHi = colByte8(col[4], sh) | (colByte8(col[5], sh) << 8u) | (colByte8(col[6], sh) << 16u) | (colByte8(col[7], sh) << 24u);
            uint64_t T = transpose8x8(packUint2x32(uvec2(pLo, pHi)));
            uint64_t T2 = transpose8x8(uint64_t(colByte8(col[8], sh) | (colByte8(col[9], sh) << 8u)));
            rpB = (((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 10u)
                | (((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 0u);
            rpA = (((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 50u)
                | (((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 40u)
                | (((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 30u)
                | (((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 20u)
                | (((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 10u)
                | (((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 0u);
          } }
        hh = (hh ^ rpA) * prime; // rp0 done
        rpA = rpB; rpB = 0ul; // rpA = rp1
        { int sh = len - 16;
          if (sh > -8 && sh < maxh_h) {
            uint pLo = colByte8(col[0], sh) | (colByte8(col[1], sh) << 8u) | (colByte8(col[2], sh) << 16u) | (colByte8(col[3], sh) << 24u);
            uint pHi = colByte8(col[4], sh) | (colByte8(col[5], sh) << 8u) | (colByte8(col[6], sh) << 16u) | (colByte8(col[7], sh) << 24u);
            uint64_t T = transpose8x8(packUint2x32(uvec2(pLo, pHi)));
            uint64_t T2 = transpose8x8(uint64_t(colByte8(col[8], sh) | (colByte8(col[9], sh) << 8u)));
            rpB = (((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 30u)
                | (((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 20u)
                | (((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 10u)
                | (((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 0u);
            rpA |= (((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 50u)
                 | (((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 40u)
                 | (((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 30u)
                 | (((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 20u);
          } }
        hh = (hh ^ rpA) * prime; // rp1 done
        rpA = rpB; rpB = 0ul; // rpA = rp2
        { int sh = len - 24;
          if (sh > -8 && sh < maxh_h) {
            uint pLo = colByte8(col[0], sh) | (colByte8(col[1], sh) << 8u) | (colByte8(col[2], sh) << 16u) | (colByte8(col[3], sh) << 24u);
            uint pHi = colByte8(col[4], sh) | (colByte8(col[5], sh) << 8u) | (colByte8(col[6], sh) << 16u) | (colByte8(col[7], sh) << 24u);
            uint64_t T = transpose8x8(packUint2x32(uvec2(pLo, pHi)));
            uint64_t T2 = transpose8x8(uint64_t(colByte8(col[8], sh) | (colByte8(col[9], sh) << 8u)));
            rpB = (((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 50u)
                | (((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 40u)
                | (((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 30u)
                | (((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 20u)
                | (((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 10u)
                | (((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 0u);
            rpA |= (((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 50u)
                 | (((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 40u);
          } }
        hh = (hh ^ rpA) * prime; // rp2 done
        hh = (hh ^ rpB) * prime; // rp3 done
        rpA = 0ul; rpB = 0ul;
        { int sh = len - 32;
          if (sh > -8 && sh < maxh_h) {
            uint pLo = colByte8(col[0], sh) | (colByte8(col[1], sh) << 8u) | (colByte8(col[2], sh) << 16u) | (colByte8(col[3], sh) << 24u);
            uint pHi = colByte8(col[4], sh) | (colByte8(col[5], sh) << 8u) | (colByte8(col[6], sh) << 16u) | (colByte8(col[7], sh) << 24u);
            uint64_t T = transpose8x8(packUint2x32(uvec2(pLo, pHi)));
            uint64_t T2 = transpose8x8(uint64_t(colByte8(col[8], sh) | (colByte8(col[9], sh) << 8u)));
            rpB = (((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 10u)
                | (((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 0u);
            rpA = (((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 50u)
                | (((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 40u)
                | (((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 30u)
                | (((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 20u)
                | (((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 10u)
                | (((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 0u);
          } }
        hh = (hh ^ rpA) * prime; // rp4 done
        rpA = rpB; rpB = 0ul; // rpA = rp5
        { int sh = len - 40;
          if (sh > -8 && sh < maxh_h) {
            uint pLo = colByte8(col[0], sh) | (colByte8(col[1], sh) << 8u) | (colByte8(col[2], sh) << 16u) | (colByte8(col[3], sh) << 24u);
            uint pHi = colByte8(col[4], sh) | (colByte8(col[5], sh) << 8u) | (colByte8(col[6], sh) << 16u) | (colByte8(col[7], sh) << 24u);
            uint64_t T = transpose8x8(packUint2x32(uvec2(pLo, pHi)));
            uint64_t T2 = transpose8x8(uint64_t(colByte8(col[8], sh) | (colByte8(col[9], sh) << 8u)));
            rpB = (((T >> 0u) & 0xFFul | (((T2 >> 0u) & 0xFFul) << 8)) << 30u)
                | (((T >> 8u) & 0xFFul | (((T2 >> 8u) & 0xFFul) << 8)) << 20u)
                | (((T >> 16u) & 0xFFul | (((T2 >> 16u) & 0xFFul) << 8)) << 10u)
                | (((T >> 24u) & 0xFFul | (((T2 >> 24u) & 0xFFul) << 8)) << 0u);
            rpA |= (((T >> 32u) & 0xFFul | (((T2 >> 32u) & 0xFFul) << 8)) << 50u)
                 | (((T >> 40u) & 0xFFul | (((T2 >> 40u) & 0xFFul) << 8)) << 40u)
                 | (((T >> 48u) & 0xFFul | (((T2 >> 48u) & 0xFFul) << 8)) << 30u)
                 | (((T >> 56u) & 0xFFul | (((T2 >> 56u) & 0xFFul) << 8)) << 20u);
          } }
        hh = (hh ^ rpA) * prime; // rp5 done
        hh = (hh ^ rpB) * prime; // rp6 done

        // ---- features over the child's column masks ----
        // R2C V2: no h[10] array. Heights are recomputed at each use
        // (height_of is a pure function of col[x]); the per-column
        // features accumulate in a single pass. Every accumulation
        // order and every compared value is unchanged -> bit-identical.
        int maxh = 0;
        int well = 0;
        int wellH = 0;
        int holes = 0;
        uint64_t holeOr = 0ul;
        int holeCover = 0;
        uint hp0 = 0u, hp1 = 0u;
        for (int x = 0; x < 10; x++) {
            int hx = height_of(col[x]);
            if (x < 5) hp0 |= uint(hx) << uint(x * 6);
            else hp1 |= uint(hx) << uint((x - 5) * 6);
            if (hx > maxh) maxh = hx;
            if (x == 0 || hx < wellH) { well = x; wellH = hx; }
            int mx_c = pop64(col[x]);
            int hdiff = hx - mx_c;
            if (hdiff > 0) {
                holes += hdiff;
                holeOr |= ~col[x] & below64(uint(hx - 1));
                holeCover += hole_cover_col_m(col[x], mx_c);
            }
        }
        int holeRows = pop64(holeOr);
        int bump = 0, bumpSq = 0;
        for (int x = 0; x < 9; x++) {
            if (x == well || x + 1 == well) continue;
            int hx0 = int(((x < 5 ? hp0 : hp1) >> uint((x < 5 ? x : x - 5) * 6)) & 63u);
            int hx1 = int(((x + 1 < 5 ? hp0 : hp1) >> uint((x + 1 < 5 ? x + 1 : x - 4) * 6)) & 63u);
            int d = abs(hx0 - hx1);
            bump += d;
            bumpSq += d * d;
        }
        int leftN = well > 0 ? int(((well - 1 < 5 ? hp0 : hp1) >> uint((well - 1 < 5 ? well - 1 : well - 6) * 6)) & 63u) : len;
        int rightN = well < 9 ? int(((well + 1 < 5 ? hp0 : hp1) >> uint((well + 1 < 5 ? well + 1 : well - 4) * 6)) & 63u) : len;
        int wellDepth = min(4, min(leftN, rightN) - wellH);
        int extraWells = 0;
        for (int x = 0; x < 10; x++) {
            if (x == well) continue;
            int hx = int(((x < 5 ? hp0 : hp1) >> uint((x < 5 ? x : x - 5) * 6)) & 63u);
            int l2 = x > 0 ? int(((x - 1 < 5 ? hp0 : hp1) >> uint((x - 1 < 5 ? x - 1 : x - 6) * 6)) & 63u) : len;
            int r2 = x < 9 ? int(((x + 1 < 5 ? hp0 : hp1) >> uint((x + 1 < 5 ? x + 1 : x - 4) * 6)) & 63u) : len;
            if (min(l2, r2) - hx >= 3) extraWells += 1;
        }
        int over = max(maxh - 10, 0);
        int danger = over * over;
        bool dead = maxh >= min(len, 21);

        int tslot = best_tslot(col, len);

        // ---- accumulated (bound form; same operations as the eval form) ----
        int sDepth = int(inst.w[ib + 1u]);
        int sTslot = int(inst.w[ib + 41u]);
        double sReward = packDouble2x32(uvec2(inst.w[ib + 42u], inst.w[ib + 43u]));
        double sMult = packDouble2x32(uvec2(inst.w[ib + 44u], inst.w[ib + 45u]));
        double sScale = packDouble2x32(uvec2(inst.w[ib + 46u], inst.w[ib + 47u]));
        precise double rw = double(attack) * tab.t[165];
        if (sDepth == 0) {
            precise double conv = tab.t[169] * double(max(attack - sPending, 0));
            rw += conv;
        }
        int ck = -1;
        if (lines > 0) {
            if (pc_) ck = 8;
            else if (spin == 1) ck = 4;
            else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
            else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
        }
        if (ck >= 0) rw += tab.t[156 + ck];
        if (ck == 4) {
            double delta = lines == 1 ? tab.t[174] : (lines == 2 ? tab.t[175] : (lines == 3 ? tab.t[176] : 0.0lf));
            if (delta != 0.0lf) rw += delta;
        }
        if (sChain != 0 && lines > 0 && !difficult && !pc_) rw += tab.t[166];
        if (kind_b == 2 && spin == 0 && sTslot > 0) rw += tab.t[167];
        precise double acc = sReward + sScale * (rw - tab.t[170] * double(danger));

        // ---- all-exact bound (stage-2B mode 6 arithmetic, verbatim) ----
        int hcUsed = tab.t[148] < 0.0lf ? holes : 4 * holes;
        int tsUsed = tab.t[155] > 0.0lf ? 2 : 0;
        precise double dotHi = 0.0lf;
        { precise double term = tab.t[145 + 0] * double(maxh); dotHi += term; }
        { precise double term = tab.t[145 + 1] * double(danger); dotHi += term; }
        { precise double term = tab.t[145 + 2] * double(holes); dotHi += term; }
        { precise double term = tab.t[145 + 3] * double(hcUsed); dotHi += term; }
        { precise double term = tab.t[145 + 4] * double(holeRows); dotHi += term; }
        { precise double term = tab.t[145 + 5] * double(bump); dotHi += term; }
        { precise double term = tab.t[145 + 6] * double(bumpSq); dotHi += term; }
        { precise double term = tab.t[145 + 7] * double(rt); dotHi += term; }
        { precise double term = tab.t[145 + 8] * double(wellDepth); dotHi += term; }
        { precise double term = tab.t[145 + 9] * double(extraWells); dotHi += term; }
        { precise double term = tab.t[145 + 10] * double(tsUsed); dotHi += term; }
        precise double phiHi = 0.0lf;
        precise double phiEx = 0.0lf;
        if (tab.t[177] != 0.0lf) {
            phiHi = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, true);
            phiEx = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, false);
        }
        double b2bState = (tab.t[171] != 0.0lf && dchain >= 1) ? tab.t[171] : 0.0lf;
        precise double factor = sScale * tab.t[168];
        precise double u = acc + factor * (dotHi + b2bState + phiHi) + 1e-6lf;
        precise double dHc = factor * tab.t[148] * double(holeCover - hcUsed);
        precise double dTs2 = factor * tab.t[155] * double(tslot - tsUsed);
        precise double dPhi = factor * (phiEx - phiHi);
        precise double uAll = u + dHc + dTs2 + dPhi;

        // ---- pack + write the 16-word record (bxp_a form) ----
        uint64_t flo = 0ul;
        flo |= (uint64_t(uint(maxh)) & 0x7Ful) << 0;
        flo |= (uint64_t(uint(danger)) & 0x3FFul) << 7;
        flo |= (uint64_t(uint(holes)) & 0x1FFul) << 17;
        flo |= (uint64_t(uint(holeCover)) & 0x7FFul) << 26;
        flo |= (uint64_t(uint(holeRows)) & 0x3Ful) << 37;
        flo |= (uint64_t(uint(bump)) & 0x1FFul) << 43;
        flo |= (uint64_t(uint(rt)) & 0x1FFul) << 52;
        flo |= (uint64_t(uint(wellDepth)) & 0x7ul) << 61;
        uint fhi = uint(bumpSq) | (uint(extraWells) << 14) | (uint(tslot) << 18);
        uint scA = uint(spin) | (uint(lines) << 2) | ((dead ? 1u : 0u) << 8) | ((pc_ ? 1u : 0u) << 9)
            | (uint(attack) << 10) | (uint(gc) << 20);
        uint scB = uint(combo + 1) | (uint(dchain) << 6) | (uint(pending) << 14) | (uint(landed) << 20);
        uvec2 ub = unpackDouble2x32(uAll);
        uint rb = child * 4u;
        uint flo_lo = uint(flo & 0xFFFFFFFFul);
        uint flo_hi = uint(flo >> 32);
        rec.q[rb + 0u] = uvec4(uint(hh & 0xFFFFFFFFul), uint(hh >> 32), ub.x, ub.y);
        rec.q[rb + 3u] = uvec4(fhi, scA, scB, ii);

        // ---- survivor compaction + direct in-wave eval (no STASH/SURVL/recompute) ----
        uint pos = child - pc.childBase;
        double tau = packDouble2x32(uvec2(pc.tauLo, pc.tauHi));
        if (uAll > tau || (uAll == tau && pos <= pc.tauPos)) {
            uint s = atomicAdd(survCnt.w[0], 1u);
            surv.w[pc.survBase + s] = child;
            state.u[EVALCH + pos] = 2u;
            precise double dot = 0.0lf;
            { precise double term = double(maxh) * tab.t[145 + 0]; dot += term; }
            { precise double term = double(danger) * tab.t[145 + 1]; dot += term; }
            { precise double term = double(holes) * tab.t[145 + 2]; dot += term; }
            { precise double term = double(holeCover) * tab.t[145 + 3]; dot += term; }
            { precise double term = double(holeRows) * tab.t[145 + 4]; dot += term; }
            { precise double term = double(bump) * tab.t[145 + 5]; dot += term; }
            { precise double term = double(bumpSq) * tab.t[145 + 6]; dot += term; }
            { precise double term = double(rt) * tab.t[145 + 7]; dot += term; }
            { precise double term = double(wellDepth) * tab.t[145 + 8]; dot += term; }
            { precise double term = double(extraWells) * tab.t[145 + 9]; dot += term; }
            { precise double term = double(tslot) * tab.t[145 + 10]; dot += term; }
            precise double br = dot;
            br += b2bState;
            br += 0.0lf;
            br += 0.0lf;
            br += phiEx;
            br -= 0.0lf;
            precise double sd = sScale * tab.t[168];
            precise double value = acc + sd * br;
            uvec2 vb = unpackDouble2x32(value);
            uint64_t vbits;
            if (value == 0.0lf) vbits = 0ul;
            else vbits = (uint64_t(vb.y) << 32) | uint64_t(vb.x);
            uint64_t ord = (vbits >> 63) != 0ul ? ~vbits : (vbits | 0x8000000000000000ul);
            uint64_t keyK = ~ord;
            uvec2 ab = unpackDouble2x32(acc);
            rec.q[rb + 1u] = uvec4(vb.x, vb.y, ab.x, ab.y);
            rec.q[rb + 2u] = uvec4(uint(keyK & 0xFFFFFFFFul), uint(keyK >> 32), flo_lo, flo_hi);
        } else {
            rec.q[rb + 1u] = uvec4(0u, 0u, 0u, 0u);
            rec.q[rb + 2u] = uvec4(0u, 0u, flo_lo, flo_hi);
        }

        // ---- Fused dedupeA (zero extra pass, zero extra gbar!) ----
        if (!dead) {
            uint64_t fp = hh;
            uint64_t ubits = (uint64_t(ub.y) << 32) | uint64_t(ub.x);
            uint64_t uord = ordOfBits(ubits);
            uint slot = uint(sm64(fp)) & 16383u;
            bool found = false;
            for (uint it = 0u; it <= 16383u; it++) {
                uint64_t cur = atomicCompSwap(tabfp.v[slot], EMPTY64, fp);
                if (cur == EMPTY64) {
                    uint ts = atomicAdd(state.u[STATS + ST_NTOUCH], 1u);
                    state.u[TABMETA + 2u * (128u + ts) + 1u] = slot;
                    found = true; break;
                }
                if (cur == fp) { found = true; break; }
                slot = (slot + 1u) & 16383u;
            }
            if (found) {
                state.u[SLOTOF + coff] = slot;
                atomicMax(tabord.v[slot], uord);
            } else {
                state.u[SLOTOF + coff] = 0xFFFFFFFFu;
            }
        }
    }
}



// ================= selection stage bodies =================
// Ports of the stage-3 final forms (3B v5 + 3C integrated dedupe)
// into the resident kernel. Differences from the basic forms are
// structural only: child-direct iteration (list positions replaced
// by ply-local child offsets — order-isomorphic, so every tie-break
// resolves identically), 64-lane workgroup-0 scans instead of
// 1024/256-lane ones, and LDS key staging dropped (keys read from
// the global ord caches; the kept arrays alias BPX's shared, which
// is dead by S3). Semantics follow the originals line for line.
#define PFXIDX 188800u
shared uint p_p0;
shared uint p_digit;
shared uint p_acc;
shared uint p_total;
shared uint p_nextIdxA;
shared uint p_snext;
shared uint p_cand;
shared bool p_narrow;
shared bool p_arm;
shared uint64_t j_nextOrd;
shared uint j_nextIdx;
shared uint j_hasNext;
shared uint h_nAlive, h_nReps, h_nSel, h_nEval, h_rounds, h_nSurv;


// Monotonic 12-bit float bucket (3907 bins in 0..4095):
// 6-bit mantissa precision (64 bins/exponent) across [+2^-8, +2^23] and, on the
// negative side, |d| in [2^-7, ~1.48*2^23); the band (-2^-7, +2^-8) collapses
// into the single central bin 1921 (audit B (a)).
// Monotone non-decreasing in 64-bit ordOfBits(double) for ALL uint64_t values.
uint floatBucket12(uint64_t ord) {
  uint v = uint(ord >> 46);
  if (v < 64128u) return 0u;
  if (v < 66048u) return 1u + (v - 64128u);         // 1..1920 (negatives, fine-grained for |d| in [2^-7, ~1.48*2^23))
  if (v < 196032u) return 1921u;                    // central coarse bin (-2^-7 .. +2^-8)
  if (v < 198016u) return 1922u + (v - 196032u);    // 1922..3905 (positives +2^-8 .. +2^23)
  return 3906u;
}

uint pfMsb64(uint64_t x) {
  uint hi = uint(x >> 32);
  return hi != 0u ? 32u + uint(findMSB(hi)) : uint(findMSB(uint(x)));
}
uint64_t selKeyOf(uint keysOff, uint i) {
  return (uint64_t(state.u[keysOff + 2u * i + 1u]) << 32) | uint64_t(state.u[keysOff + 2u * i]);
}
uint selIdOf(bool ev, uint i) { return ev ? state.u[EVLIST + 2u * i] : state.u[REPSGEN + i]; }
uint64_t selKeyGet(uint i) { return i < 64u ? sF[i] : packUint2x32(uvec2(pool[2u * (i - 64u)], pool[2u * (i - 64u) + 1u])); }
void selKeySet(uint i, uint64_t v) { if (i < 64u) sF[i] = v; else { uvec2 u = unpackUint2x32(v); pool[2u * (i - 64u)] = u.x; pool[2u * (i - 64u) + 1u] = u.y; } }

// ---- S3 head: dedupe phase B (min generation among max-ord) ----
void dedupeB(uint ply) {
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  for (uint coff = tid; coff < nch; coff += tt) {
    uint child = childBase + coff;
    if (childDead(child)) continue;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    uint64_t tmax = tabord.v[slot];
    if (recOrdU(child) == tmax) atomicMin(state.u[TABMETA + 2u * slot], coff);
  }
}

// ---- emitOrder grid phase (p2): canonical emitOrder split over
// contiguous coff blocks, one per WG. REPSGEN order is identical:
// blocks ascend, and inside a WG the lane sub-ranges ascend, so the
// concatenation is exactly the canonical coff-ascending sequence.
// Counts/offsets scratch: REPSORD[0..384), dead until cacheStage
// refills REPSORD later in the ply (layout supports nwg <= 128). ----
#define EO_REPC (PREFIXB)
#define EO_ALVC (PREFIXB + 128u)
#define EO_ROFF (PREFIXB + 256u)
bool emitOrderPX(uint ply, inout uint bk) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  uint nch = plyNch(ply);
  uint nwg = g_nwg;
  uint base = nch / nwg, rem = nch % nwg;
  uint blo = wg * base + min(wg, rem);
  uint bhi = blo + base + (wg < rem ? 1u : 0u);
  uint nb = bhi - blo;
  uint K = (nb + 63u) / 64u;
  uint lo = blo + lane * K;
  uint hi = min(bhi, lo + K);
  { uint tid0 = wg * 64u + lane; uint tt0 = nwg * 64u;
    for (uint b = tid0; b < 4096u; b += tt0) state.u[PB_HIST + b] = 0u; }
  uint myRep = 0u, myAlive = 0u;
  for (uint coff = lo; coff < hi; coff++) {
    uint child = childBase + coff;
    if (childDead(child)) {
      state.u[SLOTOF + coff] = 0xFFFFFFFEu;
      continue;
    }
    myAlive++;
    uint slot = state.u[SLOTOF + coff];
    if (slot == 0xFFFFFFFFu) continue;
    if (recOrdU(child) == tabord.v[slot] && coff == state.u[TABMETA + 2u * slot]) {
      myRep++;
      state.u[SLOTOF + coff] = slot | 0x40000000u;
    }
  }
  uint incR = wg64InclusiveAdd(myRep);
  uint incA = wg64InclusiveAdd(myAlive);
  if (lane == 63u) {
    state.u[EO_REPC + wg] = incR;
    state.u[EO_ALVC + wg] = incA;
  }
  if (gbar(bk++)) return true;
  // Parallel 2-row subgroup fan-in (supports nwg <= 128)
  if (wg == 0u) {
    uint r0 = lane < nwg ? state.u[EO_REPC + lane] : 0u;
    uint a0 = lane < nwg ? state.u[EO_ALVC + lane] : 0u;
    uint ir0 = wg64InclusiveAdd(r0);
    uint ia0 = wg64InclusiveAdd(a0);
    uint totR0 = wg64Broadcast(ir0, 63u);
    uint totA0 = wg64Broadcast(ia0, 63u);
    if (lane < nwg) state.u[EO_ROFF + lane] = ir0 - r0;
    uint e1 = lane + 64u;
    uint r1 = e1 < nwg ? state.u[EO_REPC + e1] : 0u;
    uint a1 = e1 < nwg ? state.u[EO_ALVC + e1] : 0u;
    uint ir1 = wg64InclusiveAdd(r1);
    uint ia1 = wg64InclusiveAdd(a1);
    if (e1 < nwg) state.u[EO_ROFF + e1] = totR0 + ir1 - r1;
    if (lane == 63u) {
      state.u[STATS + ST_NREPS] = totR0 + ir1;
      state.u[STATS + ST_NALIVE] = totA0 + ia1;
    }
  }
  if (gbar(bk++)) return true;
  { uint tid0 = wg * 64u + lane; uint tt0 = nwg * 64u;
    for (uint b = tid0; b < 2048u; b += tt0) state.u[PB_HIST2 + b] = 0u; }
  uint off = state.u[EO_ROFF + wg] + incR - myRep;
  uint64_t lMin = EMPTY64;
  uint64_t lMax = 0ul;
  for (uint coff = lo; coff < hi; coff++) {
    uint s = state.u[SLOTOF + coff];
    if ((s & 0xC0000000u) == 0x40000000u) {
      uint child = childBase + coff;
      state.u[REPSGEN + off] = child;
      uint64_t k = recOrdU(child);
      state.u[REPSORD + 2u * off] = uint(k);
      state.u[REPSORD + 2u * off + 1u] = uint(k >> 32);
      atomicAdd(state.u[PB_HIST + floatBucket12(k)], 1u);
      lMin = min(lMin, k);
      lMax = max(lMax, k);
      off++;
    }
  }
  if (lMin != EMPTY64) {
    atomicMin(mmu.v[0], lMin);
    atomicMax(mmu.v[1], lMax);
  }
  return false;
}

// ---- pass B: bxp_b.comp main body, mechanically extracted ----
// (bindings renamed: inst->inst48, plc->plcin, surv->chunkb;
// helpers ln1p125/clip6/clip8/s2surge/combo_raw/stock_phi are the
// BPX section's own copies, which bpxl.comp carries verbatim.)
void passBOne(uint si, uint childBase, uint nTop, uint64_t tauOrd, uint tauCoff) {
    uint child = chunkb.w[si];
    uint rb = child * 4u;
    uvec4 q2 = rec.q[rb + 2u];
    uvec4 q3 = rec.q[rb + 3u];

    // ---- unpack features ----
    uint64_t flo = (uint64_t(q2.w) << 32) | uint64_t(q2.z);
    int maxh = int((flo >> 0) & 0x7Ful);
    int danger = int((flo >> 7) & 0x3FFul);
    int holes = int((flo >> 17) & 0x1FFul);
    int holeCover = int((flo >> 26) & 0x7FFul);
    int holeRows = int((flo >> 37) & 0x3Ful);
    int bump = int((flo >> 43) & 0x1FFul);
    int rt = int((flo >> 52) & 0x1FFul);
    int wellDepth = int((flo >> 61) & 0x7ul);
    uint fhi = q3.x;
    int bumpSq = int(fhi & 0x3FFFu);
    int extraWells = int((fhi >> 14) & 0xFu);
    int tslot = int((fhi >> 18) & 0x3u);

    // ---- unpack scalars ----
    uint scA = q3.y;
    int spin = int(scA & 0x3u);
    int lines = int((scA >> 2) & 0x3Fu);
    bool pc_ = ((scA >> 9) & 0x1u) != 0u;
    int attack = int((scA >> 10) & 0x3FFu);
    uint scB = q3.z;
    int combo = int(scB & 0x3Fu) - 1;
    int dchain = int((scB >> 6) & 0xFFu);
    int pending = int((scB >> 14) & 0x3Fu);
    bool difficult = lines > 0 && (lines == 4 || spin != 0 || pc_);

    // ---- parent instance scalars ----
    uint ii = q3.w;
    uint ib = ii * 48u;
    int sDepth = int(inst48.w[ib + 1u]);
    int sChain = int(inst48.w[ib + 38u]);
    int sPending = int(inst48.w[ib + 39u]);
    int sTslot = int(inst48.w[ib + 41u]);
    double sReward = packDouble2x32(uvec2(inst48.w[ib + 42u], inst48.w[ib + 43u]));
    double sMult = packDouble2x32(uvec2(inst48.w[ib + 44u], inst48.w[ib + 45u]));
    double sScale = packDouble2x32(uvec2(inst48.w[ib + 46u], inst48.w[ib + 47u]));
    int kind = int(plcin.w[child * 2u] & 0xFFu);

    // ---- full evaluation (stage-2B eval arithmetic, verbatim) ----
    precise double reward = double(attack) * tab.t[165];
    if (sDepth == 0) {
        precise double conv = tab.t[169] * double(max(attack - sPending, 0));
        reward += conv;
    }
    int ck = -1;
    if (lines > 0) {
        if (pc_) ck = 8;
        else if (spin == 1) ck = 4;
        else if (spin == 2) ck = lines == 1 ? 5 : (lines == 2 ? 6 : 7);
        else ck = lines == 1 ? 0 : (lines == 2 ? 1 : (lines == 3 ? 2 : 3));
    }
    if (ck >= 0) reward += tab.t[156 + ck];
    if (ck == 4) {
        double delta = lines == 1 ? tab.t[174] : (lines == 2 ? tab.t[175] : (lines == 3 ? tab.t[176] : 0.0lf));
        if (delta != 0.0lf) reward += delta;
    }
    if (sChain != 0 && lines > 0 && !difficult && !pc_) reward += tab.t[166];
    if (kind == 2 && spin == 0 && sTslot > 0) reward += tab.t[167];
    precise double accumulated = sReward + sScale * (reward - tab.t[170] * double(danger));
    precise double phi = 0.0lf;
    if (tab.t[177] != 0.0lf) {
        phi = stock_phi(dchain, combo, pending, maxh, tslot, wellDepth, sMult, false);
    }
    precise double dot = 0.0lf;
    { precise double term = double(maxh) * tab.t[145 + 0]; dot += term; }
    { precise double term = double(danger) * tab.t[145 + 1]; dot += term; }
    { precise double term = double(holes) * tab.t[145 + 2]; dot += term; }
    { precise double term = double(holeCover) * tab.t[145 + 3]; dot += term; }
    { precise double term = double(holeRows) * tab.t[145 + 4]; dot += term; }
    { precise double term = double(bump) * tab.t[145 + 5]; dot += term; }
    { precise double term = double(bumpSq) * tab.t[145 + 6]; dot += term; }
    { precise double term = double(rt) * tab.t[145 + 7]; dot += term; }
    { precise double term = double(wellDepth) * tab.t[145 + 8]; dot += term; }
    { precise double term = double(extraWells) * tab.t[145 + 9]; dot += term; }
    { precise double term = double(tslot) * tab.t[145 + 10]; dot += term; }
    double b2bState = (tab.t[171] != 0.0lf && dchain >= 1) ? tab.t[171] : 0.0lf;
    precise double br = dot;
    br += b2bState;
    br += 0.0lf;
    br += 0.0lf;
    br += phi;
    br -= 0.0lf;
    precise double sd = sScale * tab.t[168];
    precise double value = accumulated + sd * br;

    // ---- K (production ord_key, verbatim from stage-2B) ----
    uvec2 vb = unpackDouble2x32(value);
    uint64_t vbits;
    if (value == 0.0lf) vbits = 0ul;
    else vbits = (uint64_t(vb.y) << 32) | uint64_t(vb.x);
    uint64_t ord = (vbits >> 63) != 0ul ? ~vbits : (vbits | 0x8000000000000000ul);
    uint64_t keyK = ~ord;

    // ---- write back (words 4-9; preserve feature words in q2.zw) ----
    uvec2 ab = unpackDouble2x32(accumulated);
    rec.q[rb + 1u] = uvec4(vb.x, vb.y, ab.x, ab.y);
    rec.q[rb + 2u] = uvec4(uint(keyK & 0xFFFFFFFFul), uint(keyK >> 32), q2.z, q2.w);
    uint coff = child - childBase;
    if (nTop < 96u || ord > tauOrd || (ord == tauOrd && coff < tauCoff)) {
      uint cs = atomicAdd(state.u[STATS + ST_CAND], 1u);
      if (cs < CAND_CAP) {
        state.u[CAND_OFF + cs * 3u + 0u] = uint(ord >> 32);
        state.u[CAND_OFF + cs * 3u + 1u] = uint(ord);
        state.u[CAND_OFF + cs * 3u + 2u] = coff;
      } else { atomicOr(ctrl.u[128u], 1u); atomicOr(ctrl.u[1u], 1u); }
    }
}

void passBStage(uint ply) {
  uint cn = state.u[STATS + ST_CN];
  uint childBase = plyCB(ply);
  uint nTop = state.u[STATS + ST_NTOP];
  uint64_t tauOrd = (nTop >= 96u) ? ((uint64_t(state.u[TOP_KH + 95u]) << 32) | uint64_t(state.u[TOP_KL + 95u])) : 0ul;
  uint tauCoff = (nTop >= 96u) ? state.u[TOP_COFF + 95u] : 0xFFFFFFFFu;
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  if (state.u[STATS + ST_PB_NCAND] > 128u) {
    for (uint b = tid; b < 2048u; b += tt) state.u[PB_HIST2 + b] = 0u;
  }
  for (uint si = tid; si < cn; si += tt) {
    uint child = chunkb.w[si];
    uint coff = child - childBase;
    if ((state.u[EVALCH + coff] & 2u) != 0u) {
      uint64_t ord = ordOfBits(recValBits(child));
      if (nTop < 96u || ord > tauOrd || (ord == tauOrd && coff < tauCoff)) {
        uint cs = atomicAdd(state.u[STATS + ST_CAND], 1u);
        if (cs < CAND_CAP) {
          state.u[CAND_OFF + cs * 3u + 0u] = uint(ord >> 32);
          state.u[CAND_OFF + cs * 3u + 1u] = uint(ord);
          state.u[CAND_OFF + cs * 3u + 2u] = coff;
        } else { atomicOr(ctrl.u[128u], 1u); atomicOr(ctrl.u[1u], 1u); }
      }
    } else {
      passBOne(si, childBase, nTop, tauOrd, tauCoff);
    }
  }
}

// PROBE r3bt1 helpers: comparator identical to the LDS bitonic
// (key descending, orderPk ascending on ties).
bool btPrecedes(uint akh, uint akl, uint aord, uint bkh, uint bkl, uint bord) {
  if (akh != bkh) return akh > bkh;
  if (akl != bkl) return akl > bkl;
  return aord < bord;
}
// ---- 128-element unrolled register+shuffle bitonic sort (compile-time j) ----
#define BT_STEP(K, J) do { \
  if ((J) == 32u && gl_SubgroupSize < 64u) { \
    pool[lane] = khA; pool[64u + lane] = klA; pool[128u + lane] = oA; \
    pool[192u + lane] = khB; pool[256u + lane] = klB; pool[320u + lane] = oB; \
    barrier(); \
    uint pl = lane ^ 32u; \
    { uint pkh = pool[pl]; uint pkl = pool[64u + pl]; uint po = pool[128u + pl]; \
      bool up = (((lane & ~32u) & (K)) == 0u); bool isLow = ((lane & 32u) == 0u); \
      if (btPrecedes(khA, klA, oA, pkh, pkl, po) != (up == isLow)) { khA = pkh; klA = pkl; oA = po; } } \
    { uint pkh = pool[192u + pl]; uint pkl = pool[256u + pl]; uint po = pool[320u + pl]; \
      uint idx = lane + 64u; bool up = (((idx & ~32u) & (K)) == 0u); bool isLow = ((idx & 32u) == 0u); \
      if (btPrecedes(khB, klB, oB, pkh, pkl, po) != (up == isLow)) { khB = pkh; klB = pkl; oB = po; } } \
    barrier(); \
  } else { \
    { uint pkh = subgroupShuffleXor(khA, J); uint pkl = subgroupShuffleXor(klA, J); uint po = subgroupShuffleXor(oA, J); \
      bool up = (((lane & ~(J)) & (K)) == 0u); bool isLow = ((lane & (J)) == 0u); \
      if (btPrecedes(khA, klA, oA, pkh, pkl, po) != (up == isLow)) { khA = pkh; klA = pkl; oA = po; } } \
    { uint pkh = subgroupShuffleXor(khB, J); uint pkl = subgroupShuffleXor(klB, J); uint po = subgroupShuffleXor(oB, J); \
      uint idx = lane + 64u; bool up = (((idx & ~(J)) & (K)) == 0u); bool isLow = ((idx & (J)) == 0u); \
      if (btPrecedes(khB, klB, oB, pkh, pkl, po) != (up == isLow)) { khB = pkh; klB = pkl; oB = po; } } \
  } \
} while (false)

#define BT_STEP64(K) do { \
  bool up = ((lane & (K)) == 0u); \
  if (btPrecedes(khA, klA, oA, khB, klB, oB) != up) { \
    uint t; t = khA; khA = khB; khB = t; t = klA; klA = klB; klB = t; t = oA; oA = oB; oB = t; \
  } \
} while (false)

void bitonicMerge128_3w(inout uint khA, inout uint klA, inout uint oA,
                        inout uint khB, inout uint klB, inout uint oB) {
  uint lane = gl_LocalInvocationIndex;
  BT_STEP64(128u);
  BT_STEP(128u, 32u); BT_STEP(128u, 16u); BT_STEP(128u, 8u);
  BT_STEP(128u, 4u);  BT_STEP(128u, 2u);  BT_STEP(128u, 1u);
}

void bitonic128_3w(inout uint khA, inout uint klA, inout uint oA,
                   inout uint khB, inout uint klB, inout uint oB) {
  uint lane = gl_LocalInvocationIndex;
  BT_STEP(2u, 1u);
  BT_STEP(4u, 2u); BT_STEP(4u, 1u);
  BT_STEP(8u, 4u); BT_STEP(8u, 2u); BT_STEP(8u, 1u);
  BT_STEP(16u, 8u); BT_STEP(16u, 4u); BT_STEP(16u, 2u); BT_STEP(16u, 1u);
  BT_STEP(32u, 16u); BT_STEP(32u, 8u); BT_STEP(32u, 4u); BT_STEP(32u, 2u); BT_STEP(32u, 1u);
  BT_STEP(64u, 32u); BT_STEP(64u, 16u); BT_STEP(64u, 8u); BT_STEP(64u, 4u); BT_STEP(64u, 2u); BT_STEP(64u, 1u);
  bitonicMerge128_3w(khA, klA, oA, khB, klB, oB);
}


// ---- Parallel 72-WG 2-Level 11-bit Bucket Select + Chunk Build ----
// Level 1 histogram (PB_HIST, 2048 bins) is built ONCE on r == 0 and reused for r > 0!
// Level 2 zoom (PB_HIST2, 2048 bins on next 11 bits) runs in parallel across all 72 WGs
// whenever level-1 targetBin has nc > 128 (e.g. when mn < 0 < mx puts sign+exp in level 1).
bool prefixAndChunkPX(uint ply, uint bcur, uint r, inout uint bk) {
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint tid = wg * 64u + lane;
  uint tt = g_nwg * 64u;
  uint nReps = state.u[STATS + ST_NREPS];
  uint childBase = plyCB(ply);
  uint nEval0 = state.u[STATS + ST_NEVAL];
  uint64_t mn = mmu.v[0];
  uint64_t mx = mmu.v[1];

  // Fast path 0: bcur >= nReps (all reps)
  if (bcur >= nReps) {
    if (tid == 0u) {
      state.u[STATS + ST_CN] = 0u;
      state.u[STATS + ST_HASNEXT] = 0u;
    }
    if (gbar(bk++)) return true;
    for (uint i = tid; i < nReps; i += tt) {
      uint child = state.u[REPSGEN + i];
      uint coff = child - childBase;
      if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
        uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
        state.u[CHUNKB + s] = child;
        surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
      }
    }
    if (gbar(bk++)) return true;
    if (tid == 0u) {
      state.u[STATS + ST_NEVAL] = nEval0 + state.u[STATS + ST_CN];
    }
    return false;
  }

  // Fast path 1: mn == mx (all keys identical -> indices 0..bcur-1, next = bcur)
  if (mn == mx) {
    if (tid == 0u) {
      state.u[STATS + ST_CN] = 0u;
      state.u[STATS + ST_NKEYLO] = uint(mn);
      state.u[STATS + ST_NKEYHI] = uint(mn >> 32);
      state.u[STATS + ST_NIDX] = bcur;
      state.u[STATS + ST_HASNEXT] = 1u;
    }
    if (gbar(bk++)) return true;
    for (uint i = tid; i < bcur; i += tt) {
      uint child = state.u[REPSGEN + i];
      uint coff = child - childBase;
      if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
        uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
        state.u[CHUNKB + s] = child;
        surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
      }
    }
    if (gbar(bk++)) return true;
    if (tid == 0u) {
      state.u[STATS + ST_NEVAL] = nEval0 + state.u[STATS + ST_CN];
    }
    return false;
  }

  // General path: 4096-bin floatBucket12 histogram ALREADY BUILT in emitOrderPX Pass 2!
  // WG 0: find targetBin (descending from 4095 down to 0) + reset round counters
  if (wg == 0u) {
    if (lane == 0u) {
      state.u[STATS + ST_CN] = 0u;
      state.u[STATS + ST_PB_NCAND] = 0u;
      state.u[STATS + ST_PB_NCAND2] = 0u;
      if (r == 0u) state.u[STATS + ST_PB_PREVBIN] = 4096u;
      mmv.v[0] = 0ul; // bestBelowK
      mmv.v[1] = 0ul; // candMax (for rare Level-2 zoom)
    }
    uint lsum = 0u;
    uint b0 = lane * 64u;
    for (uint j = 0u; j < 64u; j++) lsum += state.u[PB_HIST + b0 + j];
    uint incl = wg64InclusiveAdd(lsum);
    uint tot = wg64Broadcast(incl, 63u);
    uint run = incl - lsum;
    for (uint j = 0u; j < 64u; j++) {
      uint bin = b0 + j;
      uint hd = state.u[PB_HIST + bin];
      run += hd;
      uint greater = tot - run;
      if (greater < bcur && bcur <= greater + hd) {
        state.u[STATS + ST_PB_BIN] = bin;
        state.u[STATS + ST_PB_NEED] = bcur - greater;
      }
    }
  }
  if (gbar(bk++)) return true;

  // Pass 2: all 72 WGs emit bin > targetBin directly, collect bin == targetBin, track bestBelowK
  uint tbin = state.u[STATS + ST_PB_BIN];
  uint prevBin = state.u[STATS + ST_PB_PREVBIN];
  uint64_t lBestBelow = 0ul;
  bool hasBelow = false;
  for (uint i = tid; i < nReps; i += tt) {
    uint64_t k = selKeyOf(REPSORD, i);
    uint bin = floatBucket12(k);
    if (bin > prevBin) continue;
    if (bin > tbin) {
      uint child = state.u[REPSGEN + i];
      uint coff = child - childBase;
      if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
        uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
        state.u[CHUNKB + s] = child;
        surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
      }
    } else if (bin == tbin) {
      uint cs = atomicAdd(state.u[STATS + ST_PB_NCAND], 1u);
      state.u[PB_CAND + cs] = i;
    } else {
      if (!hasBelow || k > lBestBelow) { lBestBelow = k; hasBelow = true; }
    }
  }
  if (hasBelow) atomicMax(mmv.v[0], lBestBelow);
  if (gbar(bk++)) return true;

  uint need = state.u[STATS + ST_PB_NEED];
  uint nc = state.u[STATS + ST_PB_NCAND];

  // If nc > 128, do Level-2 parallel 11-bit zoom across all 72 WGs on bits 35..45 (exact next 11 mantissa bits!)
  uint candBase = PB_CAND;
  bool normalBin = (tbin != 0u && tbin != 1921u && tbin != 3906u);
  if (nc > 128u && normalBin) {
    uint shift2 = 35u;
    for (uint c = tid; c < nc; c += tt) {
      uint ri = state.u[PB_CAND + c];
      uint64_t k = selKeyOf(REPSORD, ri);
      uint bin2 = uint((k >> shift2) & 2047ul);
      atomicAdd(state.u[PB_HIST2 + bin2], 1u);
    }
    if (gbar(bk++)) return true;
    if (wg == 0u) {
      uint lsum = 0u;
      uint b0 = lane * 32u;
      for (uint j = 0u; j < 32u; j++) lsum += state.u[PB_HIST2 + b0 + j];
      uint incl = wg64InclusiveAdd(lsum);
      uint tot = wg64Broadcast(incl, 63u);
      uint run = incl - lsum;
      for (uint j = 0u; j < 32u; j++) {
        uint bin = b0 + j;
        uint hd = state.u[PB_HIST2 + bin];
        run += hd;
        uint greater = tot - run;
        if (greater < need && need <= greater + hd) {
          state.u[STATS + ST_PB_BIN2] = bin;
          state.u[STATS + ST_PB_NEED2] = need - greater;
        }
      }
    }
    if (gbar(bk++)) return true;
    uint tbin2 = state.u[STATS + ST_PB_BIN2];
    uint64_t lBest2 = 0ul;
    bool hasB2 = false;
    for (uint c = tid; c < nc; c += tt) {
      uint ri = state.u[PB_CAND + c];
      uint64_t k = selKeyOf(REPSORD, ri);
      uint bin2 = uint((k >> shift2) & 2047ul);
      if (bin2 > tbin2) {
        uint child = state.u[REPSGEN + ri];
        uint coff = child - childBase;
        if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
          uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
          state.u[CHUNKB + s] = child;
          surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
        }
      } else if (bin2 == tbin2) {
        uint cs = atomicAdd(state.u[STATS + ST_PB_NCAND2], 1u);
        state.u[PB_CAND2 + cs] = ri;
      } else {
        if (!hasB2 || k > lBest2) { lBest2 = k; hasB2 = true; }
      }
    }
    if (hasB2) atomicMax(mmv.v[0], lBest2);
    if (gbar(bk++)) return true;
    need = state.u[STATS + ST_PB_NEED2];
    nc = state.u[STATS + ST_PB_NCAND2];
    candBase = PB_CAND2;
  }

  // WG 0: resolve tiny targetBin candidates (need out of nc) and set nextOrd/nextIdx
  if (wg == 0u) {
    if (nc <= 128u) {
      uint khA = 0u, klA = 0u, oA = 0xFFFFFFFFu;
      uint khB = 0u, klB = 0u, oB = 0xFFFFFFFFu;
      if (lane < nc) {
        uint ri = state.u[candBase + lane];
        uint64_t k = selKeyOf(REPSORD, ri);
        khA = uint(k >> 32); klA = uint(k); oA = ri;
      }
      uint iB = lane + 64u;
      if (iB < nc) {
        uint ri = state.u[candBase + iB];
        uint64_t k = selKeyOf(REPSORD, ri);
        khB = uint(k >> 32); klB = uint(k); oB = ri;
      }
      bitonic128_3w(khA, klA, oA, khB, klB, oB);
      if (lane < need) {
        uint child = state.u[REPSGEN + oA];
        uint coff = child - childBase;
        if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
          uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
          state.u[CHUNKB + s] = child;
          surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
        }
      }
      if (iB < need) {
        uint child = state.u[REPSGEN + oB];
        uint coff = child - childBase;
        if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
          uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
          state.u[CHUNKB + s] = child;
          surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
        }
      }
      if (need < nc) {
        uint nkh, nkl, ni;
        if (need < 64u) {
          nkh = wg64Broadcast(khA, need);
          nkl = wg64Broadcast(klA, need);
          ni  = wg64Broadcast(oA,  need);
        } else {
          nkh = wg64Broadcast(khB, need - 64u);
          nkl = wg64Broadcast(klB, need - 64u);
          ni  = wg64Broadcast(oB,  need - 64u);
        }
        if (lane == 0u) {
          state.u[STATS + ST_NKEYLO] = nkl;
          state.u[STATS + ST_NKEYHI] = nkh;
          state.u[STATS + ST_NIDX] = ni;
          state.u[STATS + ST_HASNEXT] = 1u;
        }
      } else {
        uint64_t bkVal = mmv.v[0];
        uint minI = 0xFFFFFFFFu;
        for (uint i = lane; i < nReps; i += 64u) {
          uint64_t k = selKeyOf(REPSORD, i);
          if (k == bkVal) {
            minI = min(minI, i);
          }
        }
        uint bestI = wg64Min(minI);
        if (lane == 0u) {
          if (bestI != 0xFFFFFFFFu) {
            state.u[STATS + ST_NKEYLO] = uint(bkVal);
            state.u[STATS + ST_NKEYHI] = uint(bkVal >> 32);
            state.u[STATS + ST_NIDX] = bestI;
            state.u[STATS + ST_HASNEXT] = 1u;
          } else {
            state.u[STATS + ST_HASNEXT] = 0u;
          }
        }
      }
    } else {
      // Ultra-rare fallback (nc > 128 even after 22 bits): exact radix select on candBase[0..nc)
      uint rem2 = need;
      uint64_t pref = 0ul;
      for (uint sh = 56u; ; sh -= 8u) {
        for (uint j = lane * 4u; j < lane * 4u + 4u; j++) pool[j] = 0u;
        barrier();
        for (uint c = lane; c < nc; c += 64u) {
          uint64_t k = selKeyOf(REPSORD, state.u[candBase + c]);
          if (sh == 56u || (k >> (sh + 8u)) == pref) atomicAdd(pool[uint((k >> sh) & 0xFFul)], 1u);
        }
        barrier();
        uint ls = pool[lane*4u] + pool[lane*4u+1u] + pool[lane*4u+2u] + pool[lane*4u+3u];
        uint incl = wg64InclusiveAdd(ls);
        uint tot = wg64Broadcast(incl, 63u);
        uint run = incl - ls;
        for (uint j = 0u; j < 4u; j++) {
          uint bin = lane * 4u + j; uint hd = pool[bin]; run += hd;
          uint gr = tot - run;
          if (gr < rem2 && rem2 <= gr + hd) { p_digit = bin; p_acc = gr; }
        }
        barrier();
        pref = (pref << 8) | uint64_t(p_digit);
        rem2 -= p_acc;
        if (sh == 0u) break;
      }
      // Emit > pref and first rem2 of == pref (in ascending ri order? Wait: candBase is unordered, so scan REPSORD? No, sort/scan!)
      // Simply emit all k > pref in candBase; for k == pref, collect min indices!
      uint64_t T2 = pref;
      // Count & emit k > T2
      for (uint c = lane; c < nc; c += 64u) {
        uint ri = state.u[candBase + c];
        uint64_t k = selKeyOf(REPSORD, ri);
        if (k > T2) {
          uint child = state.u[REPSGEN + ri]; uint coff = child - childBase;
          if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
            uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
            state.u[CHUNKB + s] = child; surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
          }
        }
      }
      // For k == T2, scan REPSORD in ascending order so tie-breaking is exact
      uint eqSeen = 0u;
      uint nextEqI = 0xFFFFFFFFu;
      uint64_t bestLt = mmv.v[0];
      for (uint i = 0u; i < nReps; i++) {
        uint64_t k = selKeyOf(REPSORD, i);
        if (k == T2) {
          if (eqSeen < rem2 && lane == 0u) {
            uint child = state.u[REPSGEN + i]; uint coff = child - childBase;
            if ((atomicOr(state.u[EVALCH + coff], 1u) & 1u) == 0u) {
              uint s = atomicAdd(state.u[STATS + ST_CN], 1u);
              state.u[CHUNKB + s] = child; surv.w[OEVAL + ply * 8192u + nEval0 + s] = child;
            }
          } else if (eqSeen == rem2) { nextEqI = i; }
          eqSeen++;
        } else if (k < T2 && k > bestLt) { bestLt = k; }
      }
      if (lane == 0u) {
        if (nextEqI != 0xFFFFFFFFu) {
          state.u[STATS + ST_NKEYLO] = uint(T2); state.u[STATS + ST_NKEYHI] = uint(T2 >> 32);
          state.u[STATS + ST_NIDX] = nextEqI; state.u[STATS + ST_HASNEXT] = 1u;
        } else {
          uint bestI = 0xFFFFFFFFu;
          for (uint i = 0u; i < nReps; i++) if (selKeyOf(REPSORD, i) == bestLt) { bestI = i; break; }
          if (bestI != 0xFFFFFFFFu) {
            state.u[STATS + ST_NKEYLO] = uint(bestLt); state.u[STATS + ST_NKEYHI] = uint(bestLt >> 32);
            state.u[STATS + ST_NIDX] = bestI; state.u[STATS + ST_HASNEXT] = 1u;
          } else state.u[STATS + ST_HASNEXT] = 0u;
        }
      }
    }
    barrier();
    if (lane == 0u) {
      state.u[STATS + ST_NEVAL] = nEval0 + state.u[STATS + ST_CN];
      state.u[STATS + ST_PB_PREVBIN] = tbin;
    }
  }
  return false;
}

// ---- Incremental Top-96 merge + B&B stop judge + final SELB emit (WG 0) ----
void mergeTop96AndJudge(uint ply, bool isLastRound) {
  uint lane = gl_LocalInvocationIndex;
  uint childBase = plyCB(ply);
  uint nTop = state.u[STATS + ST_NTOP];
  uint nCand = min(state.u[STATS + ST_CAND], CAND_CAP);
  uint nEval = state.u[STATS + ST_NEVAL];
  uint nReps = state.u[STATS + ST_NREPS];
  uint rounds = state.u[STATS + ST_ROUNDS] + 1u;
  if (lane == 0u) {
    state.u[STATS + ST_ROUNDS] = rounds;
    state.u[STATS + ST_CAND] = 0u;
  }

  uint khA = 0u, klA = 0u, oA = 0xFFFFFFFFu;
  uint khB = 0u, klB = 0u, oB = 0xFFFFFFFFu;
  uint newNTop = min(nTop + nCand, 96u);

  if (nCand > 0u) {
    uint base = 0u;
    if (nTop == 0u) {
      // Load first up-to-128 candidates directly
      if (lane < nCand) {
        khA = state.u[CAND_OFF + lane * 3u + 0u];
        klA = state.u[CAND_OFF + lane * 3u + 1u];
        oA  = state.u[CAND_OFF + lane * 3u + 2u];
      }
      uint idxB = lane + 64u;
      if (idxB < nCand) {
        khB = state.u[CAND_OFF + idxB * 3u + 0u];
        klB = state.u[CAND_OFF + idxB * 3u + 1u];
        oB  = state.u[CAND_OFF + idxB * 3u + 2u];
      }
      bitonic128_3w(khA, klA, oA, khB, klB, oB);
      base = 128u;
      if (nCand > 128u) {
        uint khC = 0u, klC = 0u, oC = 0xFFFFFFFFu;
        uint khD = 0u, klD = 0u, oD = 0xFFFFFFFFu;
        uint iC = 128u + lane;
        if (iC < nCand) { khC = state.u[CAND_OFF + iC * 3u + 0u]; klC = state.u[CAND_OFF + iC * 3u + 1u]; oC = state.u[CAND_OFF + iC * 3u + 2u]; }
        uint iD = 192u + lane;
        if (iD < nCand) { khD = state.u[CAND_OFF + iD * 3u + 0u]; klD = state.u[CAND_OFF + iD * 3u + 1u]; oD = state.u[CAND_OFF + iD * 3u + 2u]; }
        bitonic128_3w(khC, klC, oC, khD, klD, oD);
        // Pairwise max of sorted descending (A,B) vs reversed (D,C): A[lane] vs D[63-lane], B[lane] vs C[63-lane]
        uint rkhD, rklD, roD, rkhC, rklC, roC;
        if (gl_SubgroupSize < 64u) {
          pool[lane] = khD; pool[64u + lane] = klD; pool[128u + lane] = oD;
          pool[192u + lane] = khC; pool[256u + lane] = klC; pool[320u + lane] = oC;
          barrier();
          uint rl = lane ^ 63u;
          rkhD = pool[rl]; rklD = pool[64u + rl]; roD = pool[128u + rl];
          rkhC = pool[192u + rl]; rklC = pool[256u + rl]; roC = pool[320u + rl];
          barrier();
        } else {
          rkhD = subgroupShuffleXor(khD, 63u); rklD = subgroupShuffleXor(klD, 63u); roD = subgroupShuffleXor(oD, 63u);
          rkhC = subgroupShuffleXor(khC, 63u); rklC = subgroupShuffleXor(klC, 63u); roC = subgroupShuffleXor(oC, 63u);
        }
        if (btPrecedes(rkhD, rklD, roD, khA, klA, oA)) { khA = rkhD; klA = rklD; oA = roD; }
        if (btPrecedes(rkhC, rklC, roC, khB, klB, oB)) { khB = rkhC; klB = rklC; oB = roC; }
        bitonicMerge128_3w(khA, klA, oA, khB, klB, oB);
        base = 256u;
      }
    } else {
      // Load existing sorted top-96 into A (0..63) and B (0..31 -> indices 64..95)
      if (lane < nTop) {
        khA = state.u[TOP_KH + lane];
        klA = state.u[TOP_KL + lane];
        oA  = state.u[TOP_COFF + lane];
      }
      if (lane < 32u && (lane + 64u) < nTop) {
        khB = state.u[TOP_KH + lane + 64u];
        klB = state.u[TOP_KL + lane + 64u];
        oB  = state.u[TOP_COFF + lane + 64u];
      }
    }
    for (; base < nCand; base += 32u) {
      if (lane >= 32u) {
        uint ci = base + (lane - 32u);
        if (ci < nCand) {
          khB = state.u[CAND_OFF + ci * 3u + 0u];
          klB = state.u[CAND_OFF + ci * 3u + 1u];
          oB  = state.u[CAND_OFF + ci * 3u + 2u];
        } else {
          khB = 0u; klB = 0u; oB = 0xFFFFFFFFu;
        }
      }
      bitonic128_3w(khA, klA, oA, khB, klB, oB);
    }
    if (lane < newNTop) {
      state.u[TOP_KH + lane] = khA;
      state.u[TOP_KL + lane] = klA;
      state.u[TOP_COFF + lane] = oA;
    }
    if (lane < 32u && (lane + 64u) < newNTop) {
      state.u[TOP_KH + lane + 64u] = khB;
      state.u[TOP_KL + lane + 64u] = klB;
      state.u[TOP_COFF + lane + 64u] = oB;
    }
    if (lane == 0u) state.u[STATS + ST_NTOP] = newNTop;
  }

  bool stop = false;
  if (nEval >= nReps) {
    stop = true;
  } else if (nEval >= 96u) {
    uint tkh, tkl, tcoff;
    if (nCand > 0u) {
      tkh = wg64Broadcast(khB, 31u);
      tkl = wg64Broadcast(klB, 31u);
      tcoff = wg64Broadcast(oB, 31u);
    } else {
      tkh = state.u[TOP_KH + 95u];
      tkl = state.u[TOP_KL + 95u];
      tcoff = state.u[TOP_COFF + 95u];
    }
    uint64_t tauOrd = (uint64_t(tkh) << 32) | uint64_t(tkl);
    uint hasNext = state.u[STATS + ST_HASNEXT];
    if (hasNext == 0u) {
      stop = true;
    } else {
      uint64_t nextOrd = (uint64_t(state.u[STATS + ST_NKEYHI]) << 32) | uint64_t(state.u[STATS + ST_NKEYLO]);
      uint nextIdx = state.u[STATS + ST_NIDX];
      uint nextCoff = state.u[REPSGEN + nextIdx] - childBase;
      if (nextOrd < tauOrd) stop = true;
      else if (nextOrd == tauOrd) stop = (nextCoff > tcoff);
      else stop = false;
    }
  }
  if (lane == 0u) state.u[STATS + ST_STOP] = stop ? 1u : 0u;
  if (stop || isLastRound) {
    if (nCand > 0u) {
      if (lane < newNTop) state.u[SELB + lane] = childBase + oA;
      if (lane < 32u && (lane + 64u) < newNTop) state.u[SELB + lane + 64u] = childBase + oB;
    } else {
      if (lane < newNTop) state.u[SELB + lane] = childBase + state.u[TOP_COFF + lane];
      if (lane < 32u && (lane + 64u) < newNTop) state.u[SELB + lane + 64u] = childBase + state.u[TOP_COFF + lane + 64u];
    }
    if (lane == 0u) {
      state.u[STATS + ST_NSEL] = newNTop;
      h_nAlive = state.u[STATS + ST_NALIVE];
      h_nReps = nReps;
      h_nSel = newNTop;
      h_nEval = nEval;
      h_rounds = rounds;
    }
  }
}

// ---- S4a: materialization (sel_mat form, global gout stride 30) ----
void matStage(uint ply) {
  uint nSel = state.u[STATS + ST_NSEL];
  uint tid = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
  uint tt = g_nwg * 64u;
  uint tot = nSel * 44u;
  for (uint t = tid; t < tot; t += tt) {
    uint idx = t / 44u;
    uint w = t - idx * 44u;
    uint child = state.u[SELB + idx];
    uint ob = OARENA + ply * 4224u + idx * 44u;
    if (w == 0u) surv.w[OSEL + ply * 96u + idx] = child;
    if (w < 30u) {
      surv.w[ob + w] = gout.w[child * 30u + w];
    } else if (w < 39u) {
      uint rb = child * 16u;
      uint ii = recw.w[rb + 15u];
      uint v = 0u;
      if (w == 30u) v = inst48.w[ii * 48u + 5u];
      else if (w == 31u) v = inst48.w[ii * 48u + 6u];
      else if (w == 32u) v = (recw.w[rb + 14u] >> 6) & 0xFFu;
      else if (w == 33u) v = uint(int(recw.w[rb + 14u] & 63u) - 1);
      else if (w == 34u) v = (recw.w[rb + 14u] >> 14) & 63u;
      else if (w == 35u) v = recw.w[rb + 4u];
      else if (w == 36u) v = recw.w[rb + 5u];
      else if (w == 37u) v = ii;
      else v = child;
      surv.w[ob + w] = v;
    } else {
      surv.w[ob + w] = 0u;
    }
  }
}

// ---- S1: BPX-L over this ply's instances (strided by workgroup) ----
shared uint sTick;
void stageS1(uint ply) {
  pc.childBase = plyCB(ply);
  pc.tauLo = uni.u[16u + ply * 8u + 4u];
  pc.tauHi = uni.u[16u + ply * 8u + 5u];
  pc.tauPos = uni.u[16u + ply * 8u + 6u];
  pc.survBase = OSURV + ply * 8192u;
  pc.base = 0u;
  pc.n = 0u;
  pc.reserved = 0u;
  uint i0 = plyI0(ply);
  uint ni = plyNi(ply);
  uint lane = gl_LocalInvocationIndex;
  // r4tk1: dynamic ticket assignment (STATS+40, zeroed by
  // resetScratch, published by the B0/B4 gbar). Replaces the
  // strided loop so the B1 rendezvous is priced by total
  // work, not by the unluckiest WG's strided draw.
  for (;;) {
    if (lane == 0u) sTick = atomicAdd(state.u[STATS + ST_TICKET], 1u);
    barrier();
    uint inst = sTick;
    if (inst >= ni) break;
    g_bpxII = i0 + inst;
    bpxMainBP(inst);
  }
}

// ---- resident main: 3-point basis + selection sync points ----
void main() {
  g_nwg = pcu.nwg;
  g_gsize = pcu.gsize;
  g_flags = pcu.flags;
  g_spin = pcu.spin;
  uint wg = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationIndex;
  uint nPlies = uni.u[0];
  if (state.u[STATS + ST_CLEAN] != 0xA77A1234u) {
    resetScratchFull();
  }
  uint bk = 0u;
  if (gbar(bk++)) return; // B0
  if (wg == 0u && lane == 0u) state.u[STATS + ST_CLEAN] = 0u;
  for (uint ply = 0u; ply < nPlies; ply++) {
    if (wg == 0u && lane < 40u) state.u[STATS + lane] = 0u;
    if (wg == 0u && lane == 0u) state.u[STATS + ST_NTOUCH] = 0u;
    stageS1(ply);
    if (gbar(bk++)) return; // B1a (BP done)
    stageS1b(ply);
    if (gbar(bk++)) return; // B1/B2 (BX + dedupeA done)
    if (wg == 0u && lane == 0u) h_nSurv = survCnt.w[0];
    dedupeB(ply);
    if (gbar(bk++)) return; // X1 = dedupe barrier 2
    if (emitOrderPX(ply, bk)) return;
    if (gbar(bk++)) return; // X2 (includes fused cacheStage)
    uint nReps = state.u[STATS + ST_NREPS];
    if (nReps > 0u) {
      uint b = 256u;
      for (uint r = 0u; r < 24u; r++) {
        uint bcur = min(b, nReps);
        if (prefixAndChunkPX(ply, bcur, r, bk)) return;
        if (gbar(bk++)) return; // A_r
        passBStage(ply);
        if (gbar(bk++)) return; // B_r
        if (wg == 0u) mergeTop96AndJudge(ply, r == 23u);
        if (gbar(bk++)) return; // C_r
        if (state.u[STATS + ST_STOP] != 0u) break;
        b *= 2u;
      }
    } else {
      if (wg == 0u && lane == 0u) {
        h_nAlive = 0u;
        h_nReps = 0u;
        h_nSel = 0u;
        h_nEval = 0u;
        h_rounds = 0u;
      }
    }
    matStage(ply);
    if (wg == 0u && lane == 0u) {
      uint hb = OHEAD + ply * 16u;
      surv.w[hb + 0u] = h_nAlive;
      surv.w[hb + 1u] = h_nReps;
      surv.w[hb + 2u] = h_nSel;
      surv.w[hb + 3u] = h_nEval;
      surv.w[hb + 4u] = h_rounds;
      surv.w[hb + 5u] = h_nSurv;
      surv.w[hb + 6u] = plyCB(ply);
      surv.w[hb + 7u] = plyNch(ply);
      surv.w[hb + 8u] = uni.u[16u + ply * 8u + 7u];
      for (uint i = 9u; i < 16u; i++) surv.w[hb + i] = 0u;
    }
    resetScratchPly(ply);
    if (ply + 1u < nPlies) {
      if (gbar(bk++)) return; // B4
    }
  }
  if (gbar(bk++)) return; // publication
  if (wg == 0u && lane == 0u) {
    state.u[STATS + ST_CLEAN] = 0xA77A1234u;
    ctrl.u[3u] = state.u[SELB];
    ctrl.u[4u] = nPlies;
    memoryBarrierBuffer();
    ctrl.u[0u] = 1u;
  }
}
