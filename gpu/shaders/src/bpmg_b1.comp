#version 460
// PRODUCTION movegen (BP B1): bit-parallel movegen, one wave64 per instance.
// Derived from the adopted BP variant B1 (stage1-work/varB1.comp,
// sha256 7ecdd848...) with only the input/output stages adapted to the
// production host contract; the BFS / order / spin-evidence / dedupe logic
// is byte-identical to B1, which passed the full-volume gate (413,838
// instances / 9,031,554 placements, 0 mismatches) in the bpg harness.
// Production contract (vkrunner_s26.c, STAGE1C):
//   binding 0 = mg_in  (48 words/instance, written by mg_build: arena rows
//                       0..39 verbatim + len/kind/rot/sx/sy at 40..44)
//   binding 2 = mg_out (10244 words/instance: header {count, disc_total,
//                       levels, flags} + 5-word placements {rot, x, y,
//                       srs, tspin}; x/y stored as uint(int))
//   push      = {base, flags} (8 bytes; host pushes {0, 0})
//   binding 1 (mg_scratch) is bound by the host but not used here.
// Lane l = r*16 + xi  (rotation r, column x = xi-3); each lane holds a 64-bit mask over
// y in [-4, 60) (bit yi = y + 4). Semantics = the reference BFS (fork/src/bp.rs proves
// the characterization on 413,838 real calls):
//   reachability: bit-parallel flood with first-fitting-kick masks
//   order: level, then min over predecessors (p, m) of rank(p)*8 + m
//   spin evidence: order-free max over rotation events into grounded targets
// S2 options fixed (spin_evidence, rotate180, kicks180_s2). Requires subgroupSize 64.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer MgIn { uint mgin[]; };   // 48 words / instance
layout(std430, binding = 2) writeonly buffer Outp { uint outp[]; };  // 10244 words / instance
layout(push_constant) uniform PC { uint base; uint flags; } pc;
#include "tables.glsl"

// Production mg_out header: {count, disc_total, levels, flags != 0 = error}.
void write_header(uint ob, uint cnt, uint disc, uint levels, uint err) {
  outp[ob] = cnt; outp[ob + 1u] = disc; outp[ob + 2u] = levels; outp[ob + 3u] = err;
}

shared uint sRows[20];
shared uint64_t sOC[10];
shared uint64_t sFit[64];
shared uint sWallPk[2];
shared uint64_t sF[64];
shared uint sFpre[64];
shared uint sOrderPk[192];
shared uint pool[576];
#define KEY(i) pool[128u + (i)]
#define KB(w) pool[384u + (w)]
#define WP(w) pool[448u + (w)]
#define POSPKW(w) pool[384u + (w)]
#define RREC(i) pool[448u + (i)]
uint rankGet(uint c, uint i) { return (pool[(c * 256u + i) >> 2] >> ((i & 3u) * 8u)) & 0xFFu; }
void rankSet(uint c, uint i, uint v) { atomicOr(pool[(c * 256u + i) >> 2], v << ((i & 3u) * 8u)); }
#define RANK(c, i) rankGet(c, i)
void ordSet(uint i, uint v) {
  uint bp = i * 12u, w = bp >> 5, off = bp & 31u;
  atomicOr(sOrderPk[w], v << off);
  if (off > 20u) atomicOr(sOrderPk[w + 1u], v >> (32u - off));
}
uint ordGet(uint i) {
  uint bp = i * 12u, w = bp >> 5, off = bp & 31u;
  uint x = sOrderPk[w] >> off;
  if (off > 20u) x |= sOrderPk[w + 1u] << (32u - off);
  return x & 0xFFFu;
}
void posSetA(uint i, uint v) { atomicOr(POSPKW(i >> 1), v << ((i & 1u) * 16u)); }
uint posGet(uint i) { return (POSPKW(i >> 1) >> ((i & 1u) * 16u)) & 0xFFFFu; }
uint wallAt(uint idx) { return (sWallPk[idx >> 5] >> (idx & 31u)) & 1u; }
// STAGE1B B1: SRC[15]/DY[15] packed into 3 u64 registers (SRC: +1, 7 bits each,
// entries 0..8 in A, 9..14 in B; DY: +4, 4 bits each). 0 SRC field == SRC -1.
uint64_t g_srcPkA, g_srcPkB, g_dyPk;
int srcOf(int k) { uint64_t pk = k < 9 ? g_srcPkA : g_srcPkB; return int((pk >> uint((k < 9 ? k : k - 9) * 7)) & 0x7Ful) - 1; }
int dyOf(int k) { return int((g_dyPk >> uint(k * 4)) & 0xFu) - 4; }
uint64_t ldPl(uint p, uint l) { return packUint2x32(uvec2(pool[(p * 64u + l) * 2u], pool[(p * 64u + l) * 2u + 1u])); }
void stPl(uint p, uint l, uint64_t v) { uvec2 u = unpackUint2x32(v); pool[(p * 64u + l) * 2u] = u.x; pool[(p * 64u + l) * 2u + 1u] = u.y; }
shared uint sTop;
shared uint sErr;

uint popc64(uint64_t m) { uvec2 v = unpackUint2x32(m); return uint(bitCount(v.x) + bitCount(v.y)); }
uint lsb64(uint64_t m) { uvec2 v = unpackUint2x32(m); return v.x != 0u ? uint(findLSB(v.x)) : 32u + uint(findLSB(v.y)); }
uint64_t below(uint y) { return y == 0u ? 0ul : ((1ul << y) - 1ul); }
uint64_t shl(uint64_t m, int s) { return s >= 0 ? (s >= 64 ? 0ul : m << uint(s)) : (-s >= 64 ? 0ul : m >> uint(-s)); }
bool bit(uint64_t m, int y) { return y >= 0 && y < 64 && ((m >> uint(y)) & 1ul) != 0ul; }
uint rowAt(int row) { return (sRows[row >> 1] >> ((row & 1) * 16)) & 0xFFFFu; }
bool filledCell(int x, int row, int len) {
  if (x < 0 || x >= 10 || row >= len) return true;
  if (row < 0) return false;
  return ((rowAt(row) >> uint(x)) & 1u) != 0u;
}

void main() {
  uint id = pc.base + gl_WorkGroupID.x;
  uint l = gl_LocalInvocationIndex;
  int r = int(l >> 4), xi = int(l & 15u), x = xi - 3;
  uint ib = id * 48u;
  // mg_in rows are arena row words; the low 10 bits are the row mask.
  // Pack two rows per word exactly as the BP instance format did.
  if (l < 20u) sRows[l] = (mgin[ib + 2u * l] & 0x3FFu) | ((mgin[ib + 2u * l + 1u] & 0x3FFu) << 16);
  int len = int(mgin[ib + 40u] & 0xFFu), kind = int(mgin[ib + 41u] & 0xFFu), sr = int(mgin[ib + 42u] & 0xFFu);
  int sx = bitfieldExtract(int(mgin[ib + 43u]), 0, 8);
  int sy = int(mgin[ib + 44u]);
  int rots = kind == 1 ? 1 : 4;
  int cls = kind == 0 ? 1 : 0;
  if (l == 0u) sErr = 0u;
  if (l < 2u) sWallPk[l] = 0u;
  pool[l] = 0u; pool[l + 64u] = 0u;
  sOrderPk[l] = 0u; sOrderPk[l + 64u] = 0u; sOrderPk[l + 128u] = 0u;
  barrier();
  // ---- occupancy columns (bit j <-> row j-4; rows >= len occupied)
  {
    uint rb = l < uint(len) ? rowAt(int(l)) : 0u;
    uint64_t floorm = len + 4 >= 64 ? 0ul : (~0ul << uint(len + 4));
    for (uint c = 0u; c < 10u; c++) {
      uvec4 bl = subgroupBallot(((rb >> c) & 1u) != 0u);
      if (l == c) sOC[c] = (packUint2x32(bl.xy) << 4) | floorm;
    }
    uvec4 nz = subgroupBallot(rb != 0u);
    if (l == 0u) { uint64_t z = packUint2x32(nz.xy); sTop = z == 0ul ? uint(len) : lsb64(z); }
  }
  barrier();
  // ---- fit mask of this lane (rotation r, column x)
  int sidx = (kind * 4 + r) * 4;
  uint64_t coll = 0ul; bool wall = true;
  for (int c = 0; c < 4; c++) {
    int col = x + CX[sidx + c], cy = CY[sidx + c];
    if (col < 0 || col >= 10) { wall = false; break; }
    uint64_t oc = sOC[col];
    coll |= (oc >> uint(cy)) | (cy > 0 ? ~(~0ul >> uint(cy)) : 0ul);
  }
  uint64_t fit = wall ? ~coll : 0ul;
  sFit[l] = fit;
  if (wall) atomicOr(sWallPk[l >> 5], 1u << (l & 31u));
  barrier();
  // ---- first-fitting-kick masks, target perspective: M[f][i] = chosen_i at source lane
  //      (pr, xi - dx_i), in source-y coordinates. Source = (pr = r - off).
  uint64_t M[15]; int NK[3];
  g_srcPkA = 0ul; g_srcPkB = 0ul; g_dyPk = 0x4444444444444444ul;
  for (int f = 0; f < 3; f++) {
    int off = f == 0 ? 1 : (f == 1 ? 3 : 2);
    int pr = (r - off) & 3;
    int kb = ((cls * 3 + f) * 4 + pr);
    int nk = rots == 1 ? 0 : KN[kb];
    NK[f] = nk;
    for (int i = 0; i < 5; i++) {
      int k = f * 5 + i;
      M[k] = 0ul;
      if (i >= nk) continue;
      int dxi = KX[kb * 5 + i], dyi = KY[kb * 5 + i];
      int sxi = xi - dxi;
      g_dyPk = (g_dyPk & ~(0xFul << uint(k * 4))) | (uint64_t(dyi + 4) << uint(k * 4));
      if (sxi < 0 || sxi >= 16) continue;
      uint sv = uint(((pr << 4) | sxi) + 1);
      if (k < 9) g_srcPkA |= uint64_t(sv) << uint(k * 7);
      else g_srcPkB |= uint64_t(sv) << uint((k - 9) * 7);
      uint64_t taken = 0ul, mine = 0ul;
      for (int j = 0; j <= i; j++) {
        int col = sxi + KX[kb * 5 + j], dyj = KY[kb * 5 + j];
        uint64_t ft = 0ul; uint wl = 0u;
        if (col >= 0 && col < 16) { ft = sFit[(r << 4) | col]; wl = wallAt(uint((r << 4) | col)); }
        uint64_t t = shl(ft, dyj);
        if (dyj > 0 && wl != 0u) t |= (1ul << uint(dyj)) - 1ul;  // targets above the window: free if walls ok
        if (j == i) mine = t & ~taken;
        taken |= t;
      }
      M[f * 5 + i] = mine;
    }
  }
  uint flags = pc.flags;
  if ((flags & 1u) != 0u) { if (l == 0u) write_header(id * 10244u, 0u, 0u, 0u, 0u); return; }
  // ---- start adjustment and seeds
  bool sfit = false;
  {
    int lane = (sr << 4) | (sx + 3);
    if (sx + 3 >= 0 && sx + 3 < 16 && sy + 4 >= 0 && sy + 4 < 64) sfit = bit(sFit[lane], sy + 4);
    if (len > 20 && sy == len - 21 && !sfit) {
      sy -= 1;
      sfit = (sx + 3 >= 0 && sx + 3 < 16 && sy + 4 >= 0 && sy + 4 < 64) && bit(sFit[lane], sy + 4);
    }
  }
  uint ob = id * 10244u;
  if (!sfit) { if (l == 0u) write_header(ob, 0u, 0u, 0u, 0u); return; }
  int top = int(sTop);
  int ssi = kind * 4 + sr;
  int startBottom = sy + MINY[ssi] + HT[ssi] - 1;
  uint64_t S = 0ul;
  if (startBottom < top - 1) {
    if (r < rots) {
      int si = kind * 4 + r;
      int lowest = top - MINY[si] - HT[si];
      int highest = max(lowest - 2, sy);
      if (x >= -MINX[si] && x + MAXX[si] < 10)
        for (int y = lowest; y >= highest; y--) if (y + 4 >= 0 && y + 4 < 64) S |= 1ul << uint(y + 4);
      S &= fit;
    }
  } else if (l == uint((sr << 4) | (sx + 3))) {
    S = 1ul << uint(sy + 4);
  }
  uint64_t F = S, V = S;
  uint cnt = popc64(F);
  uint Fpre = subgroupExclusiveAdd(cnt);
  uint total = subgroupAdd(cnt);
  {
    // seed rank: lanes in (r, x asc), y descending within a lane
    uint64_t m = F;
    while (m != 0ul) {
      uint y = lsb64(m); m &= m - 1ul;
      uint rk = Fpre + (y == 63u ? 0u : popc64(F >> (y + 1u)));
      uint idx = Fpre + popc64(F & below(y));
      if (idx < 256u) rankSet(0u, idx, rk); else sErr = 1u;
      if (rk < 512u) ordSet(rk, (l << 6) | y); else sErr = 1u;
    }
  }
  KB(l) = 0u;
  uint levelBase = total;
  uint cur = 0u;
  uint iters = 0u;
  for (;;) {
    sF[l] = F; sFpre[l] = Fpre;
    pool[(cur ^ 1u) * 64u + l] = 0u;
    barrier();
    iters++;
    uint64_t cand = F << 1;
    uint64_t FL = xi + 1 < 16 ? sF[l + 1u] : 0ul;
    uint64_t FR = xi >= 1 ? sF[l - 1u] : 0ul;
    cand |= FL | FR;
    for (int k = 0; k < 15; k++) {
      int sk = srcOf(k);
      if (sk >= 0) cand |= shl(sF[sk] & M[k], -dyOf(k));
    }
    uint64_t N = cand & fit & ~V;
    V |= N;
    uint nc = popc64(N);
    uint Npre = subgroupExclusiveAdd(nc);
    uint ntot = subgroupAdd(nc);
    if (ntot == 0u) break;
    if (total * 8u > 2048u) sErr = 2u;
    if ((flags & 2u) != 0u) { barrier(); levelBase += ntot; F = N; Fpre = Npre; total = ntot; continue; }
    // keys: min over predecessors of rank(p)*8 + m
    {
      uint64_t m = N;
      while (m != 0ul) {
        uint y = lsb64(m); m &= m - 1ul;
        uint key = 0xFFFFFFFFu;
        if (bit(FL, int(y))) key = min(key, RANK(cur, sFpre[l + 1u] + popc64(FL & below(y))) * 8u + 0u);
        if (bit(FR, int(y))) key = min(key, RANK(cur, sFpre[l - 1u] + popc64(FR & below(y))) * 8u + 1u);
        if (y >= 1u && bit(F, int(y) - 1)) key = min(key, RANK(cur, Fpre + popc64(F & below(y - 1u))) * 8u + 2u);
        for (int k = 0; k < 15; k++) {
          int sk = srcOf(k);
          if (sk < 0) continue;
          uint64_t Fs = sF[sk];
          int ys = int(y) + dyOf(k);
          if (bit(Fs & M[k], ys)) {
            key = min(key, RANK(cur, sFpre[sk] + popc64(Fs & below(uint(ys)))) * 8u + uint(3 + k / 5));
          }
        }
        uint idx = Npre + popc64(N & below(y));
        if (idx < 256u) KEY(idx) = key; else sErr = 3u;
        if (key < 2048u) atomicOr(KB(key >> 5), 1u << (key & 31u)); else sErr = 4u;
      }
    }
    barrier();
    {
      uint wc = uint(bitCount(KB(l)));
      WP(l) = subgroupExclusiveAdd(wc);
    }
    barrier();
    {
      uint64_t m = N;
      while (m != 0ul) {
        uint y = lsb64(m); m &= m - 1ul;
        uint idx = Npre + popc64(N & below(y));
        uint key = idx < 256u ? KEY(idx) : 0u;
        uint rk = WP(key >> 5) + uint(bitCount(KB(key >> 5) & ((1u << (key & 31u)) - 1u)));
        if (idx < 256u) rankSet(cur ^ 1u, idx, rk);
        if (levelBase + rk < 512u) ordSet(levelBase + rk, (l << 6) | y); else sErr = 5u;
      }
    }
    barrier();
    KB(l) = 0u;
    levelBase += ntot;
    F = N; Fpre = Npre; total = ntot; cur ^= 1u;
  }
  if ((flags & 4u) != 0u) { if (l == 0u) write_header(ob, 0u, levelBase, iters, sErr != 0u ? 1u : 0u); return; }
  // ---- spin evidence (target perspective): S_v = union of rotation events with lastSrs v
  barrier();
  sF[l] = V;
  barrier();
  uint64_t grounded = ~(fit >> 1);
  uint64_t p0 = 0ul, p1 = 0ul, p2 = 0ul, assigned = 0ul;
  for (int v = 6; v >= 1; v--) {
    uint64_t Sv = 0ul;
    for (int f = 0; f < 3; f++) {
      int k = f * 5 + v - 1;
      int sk = srcOf(k);
      if (v - 1 < NK[f] && sk >= 0) Sv |= shl(sF[sk] & M[k], -dyOf(k));
    }
    Sv &= grounded;
    uint64_t take = Sv & ~assigned;
    if ((v & 1) != 0) p0 |= take;
    if ((v & 2) != 0) p1 |= take;
    if ((v & 4) != 0) p2 |= take;
    assigned |= Sv;
  }
  stPl(0u, l, p0); stPl(1u, l, p1); stPl(2u, l, p2);
  barrier();
  // ---- emission: resting states in (level, rank) order; non-T duplicates have a fixed
  //      twin (I/S/Z: rotation r^2 at a fixed offset), so dedupe is O(1) per state.
  {
    int si = kind * 4 + r;
    int lim = 5 - MINY[si] - HT[si];           // yi < lim  <=>  entirely above the field
    uint64_t rest = V & grounded & ~(lim <= 0 ? 0ul : (lim >= 64 ? ~0ul : ((1ul << uint(lim)) - 1ul)));
    uint rc = popc64(rest);
    sF[l] = rest; sFpre[l] = subgroupExclusiveAdd(rc);
  }
  POSPKW(l) = 0u;
  barrier();
  uint T = levelBase;
  uint rbase = 0u;
  for (uint s0 = 0u; s0 < T; s0 += 64u) {
    uint s = s0 + l;
    bool keep = false; uint rec = 0u; uint di = 0u;
    if (s < T && s < 512u) {
      uint st = ordGet(s);
      uint ln = st >> 6; uint yi = st & 63u;
      if (bit(sF[ln], int(yi))) {
        keep = true;
        int rr = int(ln >> 4), xx = int(ln & 15u) - 3, yy = int(yi) - 4;
        uint srs = (bit(ldPl(0u, ln), int(yi)) ? 1u : 0u) | (bit(ldPl(1u, ln), int(yi)) ? 2u : 0u) | (bit(ldPl(2u, ln), int(yi)) ? 4u : 0u);
        uint ts = 0u;
        if (kind == 2 && srs > 0u) {
          bool o0 = filledCell(xx, yy, len), o1 = filledCell(xx + 2, yy, len), o2 = filledCell(xx + 2, yy + 2, len), o3 = filledCell(xx, yy + 2, len);
          int c = int(o0) + int(o1) + int(o2) + int(o3);
          if (c >= 3) {
            bool oc[4] = bool[4](o0, o1, o2, o3);
            int a = rr & 3, b = (rr + 1) & 3;
            ts = (oc[a] != oc[b] && srs != 5u) ? 1u : 2u;
          }
        }
        rec = uint(rr) | (uint(xx & 0xFF) << 4) | (uint(yy & 0xFF) << 12) | (srs << 20) | (ts << 24);
        di = sFpre[ln] + popc64(sF[ln] & below(yi));
      }
    }
    uint pos = rbase + subgroupExclusiveAdd(keep ? 1u : 0u);
    if (keep) { if (pos < 128u && di < 128u) { posSetA(di, pos); RREC(pos) = rec; } else sErr = 6u; }
    rbase += subgroupAdd(keep ? 1u : 0u);
  }
  barrier();
  uint R = min(rbase, 128u);
  uint obase = 0u;
  for (uint i0 = 0u; i0 < R; i0 += 64u) {
    uint i = i0 + l;
    bool first = false; uint orec = 0u;
    if (i < R) {
      first = true; orec = RREC(i);
      int rr = int(orec & 3u), xx = bitfieldExtract(int(orec), 4, 8), yy = bitfieldExtract(int(orec), 12, 8);
      int tb = (kind * 4 + rr) * 3;
      if (TWIN[tb] >= 0) {
        int tr = TWIN[tb], tx = xx + TWIN[tb + 1], ty = yy + TWIN[tb + 2];
        int txi = tx + 3, tyi = ty + 4;
        if (txi >= 0 && txi < 16 && tyi >= 0 && tyi < 64) {
          uint tl = uint((tr << 4) | txi);
          if (bit(sF[tl], tyi)) {
            uint tpos = posGet(sFpre[tl] + popc64(sF[tl] & below(uint(tyi))));
            if (tpos < i) first = false;
            else if (((RREC(tpos) >> 20) & 7u) > ((orec >> 20) & 7u)) orec = RREC(tpos);
          }
        }
      }
    }
    uint pos = obase + subgroupExclusiveAdd(first ? 1u : 0u);
    if (first) {
      if (pos < 64u) {
        // unpack the BP record into the production 5-word placement
        uint o = ob + 4u + 5u * pos;
        outp[o] = orec & 0xFFu;
        outp[o + 1u] = uint(bitfieldExtract(int(orec), 4, 8));
        outp[o + 2u] = uint(bitfieldExtract(int(orec), 12, 8));
        outp[o + 3u] = (orec >> 20) & 7u;
        outp[o + 4u] = (orec >> 24) & 0xFFu;
      } else sErr = 7u;
    }
    obase += subgroupAdd(first ? 1u : 0u);
  }
  barrier();  // make every lane's sErr visible to the header write
  if (l == 0u) write_header(ob, min(obase, 64u), levelBase, iters, sErr != 0u ? 1u : 0u);
}
