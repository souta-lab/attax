# dependencies (no trailing slash: covers the symlinked node_modules in worktrees)
node_modules

# build output
dist/
*.tsbuildinfo

# logs / scratch
*.log

# tuner runtime state (regenerated deterministically from seed + weights)
weights/tuner-state.json

# Hoiko third-party artifacts — kept locally for reference, not redistributed
evidence/hoiko/weights/
evidence/hoiko/README.txt
evidence/hoiko/お読みください.txt

# opencode / loop runtime state
.omo/
.opencode/

# Hoiko oracle runtime artifacts (proprietary binaries are staged locally)
tools/hoiko-oracle/run/
tools/hoiko-oracle/prefix/
tools/hoiko-oracle/ScpDriverInterface.dll

# Rust build artifacts (the built wasm is checked in: the app ships it)
rust/target/

# Hoiko config-port raw per-node dumps (bulky; reports/READMEs are kept)
evidence/hoiko-config/**/*-replica.txt
