{
  "name": "attax",
  "private": true,
  "version": "1.0.0",
  "description": "A versus AI for the falling-block game, measured head-to-head against the Hoiko AI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "bench": "bun scripts/benchmark.ts",
    "audit": "bun scripts/audit-rules.ts",
    "tune": "bun scripts/tune.ts",
    "results": "bun scripts/build-results.ts",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "build:wasm": "bash rust/build.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
